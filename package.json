{
  "name": "catladder",
  "version": "0.0.0",
  "author": "Marco Wettstein <maw@panter.ch>",
  "license": "MIT",
  "scripts": {
    "test": "jest",
    "test:update": "jest --updateSnapshot",
    "build": "yarn workspaces foreach -v --topological-dev run build",
    "lint": "yarn workspaces foreach run lint",
    "dev": "yarn workspaces foreach -vi --parallel run build:watch",
    "postinstall": "husky install",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable"
  },
  "workspaces": [
    "pipeline",
    "ci-includes",
    "cli"
  ],
  "devDependencies": {
    "@types/jest": "^27.0.3",
    "@typescript-eslint/eslint-plugin": "^5.8.0",
    "@typescript-eslint/parser": "^5.8.0",
    "@vercel/ncc": "^0.34.0",
    "eslint": "^8.6.0",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": ">=6",
    "jest": "^29.3.1",
    "lint-staged": ">=10",
    "pinst": ">=2",
    "prettier": "^2.5.1",
    "ts-jest": "^29.0.3",
    "typescript": "^4.5.4"
  },
  "packageManager": "yarn@3.1.1",
  "lint-staged": {
    "*.ts": [
      "eslint --cache --fix",
      "prettier --write"
    ]
  }
}
