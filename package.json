{
  "name": "catladder",
  "version": "0.0.0",
  "author": "Marco Wettstein <maw@panter.ch>",
  "license": "MIT",
  "scripts": {
    "test": "yarn workspace @catladder/pipeline generate:examples-test && jest",
    "test:update": "yarn workspace @catladder/pipeline generate:examples-test && jest --updateSnapshot",
    "build": "yarn workspaces foreach --exclude='docs' -v --topological-dev run build",
    "lint": "yarn workspaces foreach run lint",
    "dev": "yarn workspaces foreach -vi --parallel run build:watch",
    "postinstall": "husky install",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable",
    "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\""
  },
  "workspaces": [
    "pipeline",
    "cli",
    "docs"
  ],
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/eslint__js": "^8.42.3",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "9.x",
    "eslint-config-prettier": "^9.1.0",
    "eslint-formatter-unix": "^8.40.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.9.0",
    "husky": ">=6",
    "jest": "^29.7.0",
    "lint-staged": ">=10",
    "pinst": ">=2",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.3.0"
  },
  "packageManager": "yarn@3.1.1",
  "lint-staged": {
    "*.ts": [
      "eslint --cache --fix",
      "prettier --write"
    ]
  }
}
