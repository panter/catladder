{
  "name": "docs",
  "scripts": {
    "gen-examples-mdx": "tsx scripts/generate-recipies-examples.ts",
    "docusaurus": "docusaurus",
    "start": "yarn gen-examples-mdx && docusaurus start",
    "build": "docusaurus build --out-dir=../public/",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy --out-dir=../public/",
    "clear": "docusaurus clear",
    "serve": "yarn gen-examples-mdx && docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.4.0",
    "@docusaurus/preset-classic": "3.4.0",
    "@docusaurus/theme-mermaid": "^3.4.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "glob": "^10.4.2",
    "prism-react-renderer": "^2.3.0",
    "raw-loader": "^4.0.2",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsx": "^4.16.2"
  },
  "devDependencies": {
    "@akebifiky/remark-simple-plantuml": "^1.0.2",
    "@docusaurus/module-type-aliases": "3.4.0",
    "@docusaurus/tsconfig": "3.4.0",
    "@docusaurus/types": "3.4.0",
    "typescript": "~5.2.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
