{
  "compilerOptions": {
    "lib": ["es2022", "DOM"],
    "module": "CommonJS",
    "downlevelIteration": true,
    "declaration": true,
    "target": "ES2018",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "dist",
    "strict": false,
    "incremental": true,
    "resolveJsonModule": true,
    "paths": {
      "@catladder/pipeline": ["../../packages/pipeline/src/index.ts"]
    }
  },
  "include": ["./src/**/*"],
  "exclude": ["**/__tests__", "**/*.test.ts", "**/*.test.tsx"]
}
