{
  "name": "docs",
  "scripts": {
    "gen-examples-md": "tsx scripts/generate-recipies-examples.ts",
    "gen-skills-md": "tsx scripts/generate-skills-docs.ts",
    "gen-md": "pnpm run gen-examples-md && pnpm run gen-skills-md",
    "docusaurus": "docusaurus",
    "start": "pnpm run gen-md && docusaurus start",
    "build": "docusaurus build --out-dir=../../public/",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy --out-dir=../../public/",
    "clear": "docusaurus clear",
    "serve": "pnpm run gen-md && docusaurus serve --dir ../../public/",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "lint": "eslint '**/*.ts'"
  },
  "devDependencies": {
    "@akebifiky/remark-simple-plantuml": "^1.0.2",
    "@docusaurus/core": "3.5.2",
    "@docusaurus/module-type-aliases": "3.5.2",
    "@docusaurus/preset-classic": "3.5.2",
    "@docusaurus/theme-mermaid": "^3.5.2",
    "@docusaurus/tsconfig": "3.5.2",
    "@docusaurus/types": "3.5.2",
    "@mdx-js/react": "^3.0.1",
    "clsx": "^2.1.1",
    "docusaurus-lunr-search": "^3.5.0",
    "glob": "^11.0.0",
    "lunr": "^2.3.9",
    "prism-react-renderer": "^2.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.21.0",
    "typescript": "~5.2.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "license": "MIT",
  "version": "0.0.0",
  "keywords": [
    "GitLab",
    "cloud",
    "cli",
    "gitlab-ci",
    "ci/cd",
    "pipeline",
    "deployment",
    "devops",
    "automation",
    "typescript"
  ],
  "author": "Marco Wettstein <maw@panter.ch>",
  "homepage": "https://github.com/panter/catladder#readme",
  "bugs": "https://github.com/panter/catladder/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panter/catladder.git",
    "directory": "cli"
  }
}
