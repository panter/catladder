{
  "name": "@catladder/pipeline",
  "description": "catladder pipeline generation — internal package, consumed by @catladder/cli (compiled from source, not published)",
  "private": true,
  "author": "Marco Wettstein <maw@panter.ch>",
  "license": "MIT",
  "version": "0.0.0",
  "scripts": {
    "build:tsc": "tsc",
    "build": "pnpm run build:compile && pnpm run build:copy-images",
    "build:compile": "tsc",
    "build:watch": "tsc -w",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "generate:gitlab-ci-yml-types": "ts-node ./scripts/generate-gitlab-ci-types.ts",
    "generate:examples-test": "jiti scripts/generate-examples-test.ts",
    "build:copy-images": "rm -rf dist/runner-images && cp -R ../../runner-images dist/runner-images"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "sideEffects": false,
  "devDependencies": {
    "@catladder/bash": "workspace:*",
    "@types/child-process-promise": "^2.2.6",
    "@types/lodash-es": "^4.17.12",
    "@types/memoizee": "^0.4.2",
    "@types/node": "^22.5.1",
    "child-process-promise": "^2.2.1",
    "glob": "^11.0.0",
    "jiti": "^2",
    "json-schema-to-typescript": "^13.0.2",
    "lodash-es": "^4.18.1",
    "memoizee": "^0.4.17",
    "path-equal": "1.2.5",
    "slugify": "^1.6.6",
    "typescript": "^5.4.5",
    "yaml": "^2.5.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
