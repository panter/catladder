            restore-keys: api-node-modules-
        - name: Cache api-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache/restore@v4
          with:
            path: api/.yarn
            key: api-yarn-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-yarn-
        - name: 🧪 test
          id: main
          run: bash .catladder-generated/github/scripts/api-test-review.sh
          shell: bash
    api-app-review:
      name: api 🔨 app | review
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      env:
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache api-node-modules
          id: cache-node-modules
          uses: actions/cache@v4
          with:
            path: |-
              api/node_modules
              api/.yarn/install-state.gz
            key: api-node-modules-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-node-modules-
        - name: Cache api-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache@v4
          with:
            path: api/.yarn
            key: api-yarn-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-yarn-
        - name: 🔨 app
          id: main
          run: bash .catladder-generated/github/scripts/api-app-review.sh
          shell: bash
        - name: Upload artifacts
          uses: actions/upload-artifact@v4
          with:
            name: api-app-review
            path: |-
              api/__build_info.json
              api/.next
              api/dist
            if-no-files-found: warn
            include-hidden-files: true
    api-deploy-review:
      name: api 🚀 Deploy | review
      runs-on: ubuntu-latest
      needs:
        - api-app-review
        - api-audit-review
        - api-lint-review
        - api-test-review
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review-api
        url: \${{ steps.main.outputs.url }}
      env:
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Download artifacts from api-app-review
          uses: actions/download-artifact@v4
          with:
            name: api-app-review
        - name: 🚀 Deploy
          id: main
          run: bash .catladder-generated/github/scripts/api-deploy-review.sh
          shell: bash
