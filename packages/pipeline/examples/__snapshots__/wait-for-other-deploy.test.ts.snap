    create-release:
      name: create release
      runs-on: ubuntu-latest
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/semantic-release:a9d7c7ca552f
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      permissions:
        contents: write
        actions: write
        packages: read
      needs:
        - catladder-image-semantic-release
      env:
        GITHUB_TOKEN: \${{ github.token }}
      steps:
        - name: Checkout
          uses: actions/checkout@v4
          with:
            fetch-depth: 0
        - name: check main workflow
          id: queue
          run: node .catladder-generated/catci/index.js release github-queue-check
          shell: bash
        - name: create release
          if: steps.queue.outputs.queued != 'true'
          run: semanticRelease
          shell: bash
      if: \${{ inputs.job == 'create-release' }}
    api-app-prod:
      name: api 🔨 app | prod
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      env:
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache api-node-modules
          id: cache-node-modules
          uses: actions/cache@v4
          with:
            path: |-
              api/node_modules
              api/.yarn/install-state.gz
            key: api-node-modules-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-node-modules-
        - name: Cache api-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache@v4
          with:
            path: api/.yarn
            key: api-yarn-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-yarn-
        - name: 🔨 app
          id: main
          run: bash .catladder-generated/github/scripts/api-app-prod.sh
          shell: bash
        - name: Upload artifacts
          uses: actions/upload-artifact@v4
          with:
            name: api-app-prod
            path: |-
              api/__build_info.json
              api/.next
              api/dist
            if-no-files-found: warn
            include-hidden-files: true
      if: \${{ inputs.job == 'api-deploy-prod' || inputs.job == 'www-deploy-prod' }}
