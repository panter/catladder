      ENV_TYPE=stage
      HOSTNAME=unknown-host.example.com
      ROOT_URL=https://unknown-host.example.com
      HOSTNAME_INTERNAL=unknown-host.example.com
      ROOT_URL_INTERNAL=https://unknown-host.example.com
