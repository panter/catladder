            fi
            collapseable_section_end "check-image"
            collapseable_section_start "docker-build" "Building image"
            DOCKER_BUILDKIT=1 docker build -t ghcr.io/\${{ github.repository }}/catladder/semantic-release:a9d7c7ca552f -f .catladder-generated/images/semantic-release/Dockerfile .catladder-generated/images/semantic-release
            collapseable_section_end "docker-build"
            collapseable_section_start "docker-push" "Pushing image"
            docker push ghcr.io/\${{ github.repository }}/catladder/semantic-release:a9d7c7ca552f
            collapseable_section_end "docker-push"
          shell: bash
    api-audit-dev:
      name: api 🛡 audit | dev
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev
      env:
        CL_dev_api_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_dev_api_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🛡 audit
          id: main
          run: bash .catladder-generated/github/scripts/api-audit-dev.sh
          shell: bash
    api-lint-dev:
      name: api 👮 lint | dev
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev
      env:
        CL_dev_api_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_dev_api_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache api-node-modules
          id: cache-node-modules
          uses: actions/cache/restore@v4
          with:
            path: |-
              api/node_modules
              api/.yarn/install-state.gz
            key: api-node-modules-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-node-modules-
        - name: Cache api-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache/restore@v4
          with:
            path: api/.yarn
            key: api-yarn-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-yarn-
        - name: 👮 lint
          id: main
          run: bash .catladder-generated/github/scripts/api-lint-dev.sh
          shell: bash
    api-test-dev:
      name: api 🧪 test | dev
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-testing-chrome
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-testing-chrome:6c33db75f445
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev
      env:
        CL_dev_api_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_dev_api_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-testing-chrome:6c33db75f445
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache api-node-modules
          id: cache-node-modules
          uses: actions/cache/restore@v4
          with:
            path: |-
              api/node_modules
              api/.yarn/install-state.gz
            key: api-node-modules-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-node-modules-
        - name: Cache api-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache/restore@v4
          with:
            path: api/.yarn
            key: api-yarn-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-yarn-
        - name: 🧪 test
          id: main
          run: bash .catladder-generated/github/scripts/api-test-dev.sh
          shell: bash
    api-app-dev:
      name: api 🔨 app | dev
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev
      env:
        CL_dev_api_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_dev_api_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache api-node-modules
          id: cache-node-modules
          uses: actions/cache@v4
          with:
            path: |-
              api/node_modules
              api/.yarn/install-state.gz
            key: api-node-modules-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-node-modules-
        - name: Cache api-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache@v4
          with:
            path: api/.yarn
            key: api-yarn-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-yarn-
        - name: 🔨 app
          id: main
          run: bash .catladder-generated/github/scripts/api-app-dev.sh
          shell: bash
        - name: Upload artifacts
          uses: actions/upload-artifact@v4
          with:
            name: api-app-dev
            path: |-
              api/__build_info.json
              api/.next
              api/dist
            if-no-files-found: warn
            include-hidden-files: true
    api-docker-dev:
      name: api 🔨 docker | dev
      runs-on: ubuntu-latest
      needs:
        - api-app-dev
        - catladder-image-docker-build
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev
      env:
        DOCKER_BUILDKIT: '1'
        CL_dev_api_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_dev_api_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache api-yarn
          uses: actions/cache/restore@v4
          with:
            path: api/.yarn
            key: api-yarn-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-yarn-
        - name: Download artifacts from api-app-dev
          uses: actions/download-artifact@v4
          with:
            name: api-app-dev
        - name: 🔨 docker
          id: main
          run: bash .catladder-generated/github/scripts/api-docker-dev.sh
          shell: bash
    api-deploy-dev:
      name: api 🚀 Deploy | dev
      runs-on: ubuntu-latest
      needs:
        - api-app-dev
        - api-audit-dev
        - api-docker-dev
        - api-lint-dev
        - api-test-dev
      container:
        image: google/cloud-sdk:525.0.0
      environment:
        name: dev-api
        url: \${{ steps.main.outputs.url }}
      env:
        CL_dev_api_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_dev_api_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: google/cloud-sdk:525.0.0
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🚀 Deploy
          id: main
          run: bash .catladder-generated/github/scripts/api-deploy-dev.sh
          shell: bash
