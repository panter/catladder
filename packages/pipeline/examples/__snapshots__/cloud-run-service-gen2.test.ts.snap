    api-audit-review:
      name: api 🛡 audit | review
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review
      env:
        CL_review_api_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_review_api_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🛡 audit
          id: main
          run: bash .catladder-generated/github/scripts/api-audit-review.sh
          shell: bash
    api-lint-review:
      name: api 👮 lint | review
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review
      env:
        CL_review_api_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_review_api_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache api-node-modules
          id: cache-node-modules
          uses: actions/cache/restore@v4
          with:
            path: |-
              api/node_modules
              api/.yarn/install-state.gz
            key: api-node-modules-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-node-modules-
        - name: Cache api-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache/restore@v4
          with:
            path: api/.yarn
            key: api-yarn-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-yarn-
        - name: 👮 lint
          id: main
          run: bash .catladder-generated/github/scripts/api-lint-review.sh
          shell: bash
    api-test-review:
      name: api 🧪 test | review
