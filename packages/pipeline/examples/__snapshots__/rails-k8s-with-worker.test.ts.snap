      needs:
        - catladder-image-docker-build
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review
      env:
        DOCKER_BUILDKIT: '1'
        CL_review_app_SECRET_KEY_BASE: \${{ secrets.CL_review_app_SECRET_KEY_BASE }}
        CL_review_app_POSTGRESQL_PASSWORD: \${{ secrets.CL_review_app_POSTGRESQL_PASSWORD }}
