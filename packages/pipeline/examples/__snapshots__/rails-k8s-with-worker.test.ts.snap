    httpGet:
      path: |-
        __health
  readinessProbe:
    httpGet:
      path: |-
        __health
  startupProbe:
    httpGet:
      path: |-
        __health
  worker:
    enabled: true
    command: |-
      launcher bundle exec rake jobs:work
    livenessProbe: false
cloudsql:
  enabled: true
