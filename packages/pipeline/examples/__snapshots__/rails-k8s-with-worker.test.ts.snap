    app-audit-dev:
      name: app 🛡 audit | dev
      runs-on: ubuntu-latest
      container:
        image: ruby:3.2.1
      environment:
        name: dev
      env:
        CL_dev_app_SECRET_KEY_BASE: \${{ secrets.CL_dev_app_SECRET_KEY_BASE }}
        CL_dev_app_POSTGRESQL_PASSWORD: \${{ secrets.CL_dev_app_POSTGRESQL_PASSWORD }}
        CL_dev_app_cloudsqlProxyCredentials: \${{ secrets.CL_dev_app_cloudsqlProxyCredentials }}
        CL_JOB_IMAGE: ruby:3.2.1
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🛡 audit
          id: main
          run: bash .catladder-generated/github/scripts/app-audit-dev.sh
          shell: bash
    app-lint-dev:
      name: app 👮 lint | dev
      runs-on: ubuntu-latest
      container:
        image: ruby:3.2.1
      environment:
        name: dev
      env:
        CL_dev_app_SECRET_KEY_BASE: \${{ secrets.CL_dev_app_SECRET_KEY_BASE }}
        CL_dev_app_POSTGRESQL_PASSWORD: \${{ secrets.CL_dev_app_POSTGRESQL_PASSWORD }}
        CL_dev_app_cloudsqlProxyCredentials: \${{ secrets.CL_dev_app_cloudsqlProxyCredentials }}
        CL_JOB_IMAGE: ruby:3.2.1
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 👮 lint
          id: main
          run: bash .catladder-generated/github/scripts/app-lint-dev.sh
          shell: bash
    app-test-dev:
      name: app 🧪 test | dev
      runs-on: ubuntu-latest
      container:
        image: ruby:3.2.1
      services:
        database:
          image: docker.io/postgres:latest
          env:
            POSTGRES_HOST_AUTH_METHOD: trust
      environment:
        name: dev
      env:
        RAILS_ENV: test
        DATABASE_URL: postgresql://postgres@database
        CL_dev_app_SECRET_KEY_BASE: \${{ secrets.CL_dev_app_SECRET_KEY_BASE }}
        CL_dev_app_POSTGRESQL_PASSWORD: \${{ secrets.CL_dev_app_POSTGRESQL_PASSWORD }}
        CL_dev_app_cloudsqlProxyCredentials: \${{ secrets.CL_dev_app_cloudsqlProxyCredentials }}
        CL_JOB_IMAGE: ruby:3.2.1
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🧪 test
          id: main
          run: bash .catladder-generated/github/scripts/app-test-dev.sh
          shell: bash
    app-docker-dev:
      name: app 🔨 docker | dev
      runs-on: ubuntu-latest
      needs:
        - catladder-image-docker-build
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev
      env:
        DOCKER_BUILDKIT: '1'
        CL_dev_app_SECRET_KEY_BASE: \${{ secrets.CL_dev_app_SECRET_KEY_BASE }}
        CL_dev_app_POSTGRESQL_PASSWORD: \${{ secrets.CL_dev_app_POSTGRESQL_PASSWORD }}
        CL_dev_app_cloudsqlProxyCredentials: \${{ secrets.CL_dev_app_cloudsqlProxyCredentials }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🔨 docker
          id: main
          run: bash .catladder-generated/github/scripts/app-docker-dev.sh
          shell: bash
    app-deploy-dev:
      name: app 🚀 Deploy | dev
      runs-on: ubuntu-latest
      needs:
        - app-audit-dev
        - app-docker-dev
        - app-lint-dev
        - app-test-dev
        - catladder-image-kubernetes
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/kubernetes:09d6680a69fa
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev-app
        url: \${{ steps.main.outputs.url }}
      env:
        CL_dev_app_SECRET_KEY_BASE: \${{ secrets.CL_dev_app_SECRET_KEY_BASE }}
        CL_dev_app_POSTGRESQL_PASSWORD: \${{ secrets.CL_dev_app_POSTGRESQL_PASSWORD }}
        CL_dev_app_cloudsqlProxyCredentials: \${{ secrets.CL_dev_app_cloudsqlProxyCredentials }}
        CL_dev_app_KUBE_URL: \${{ secrets.CL_dev_app_KUBE_URL }}
        CL_dev_app_KUBE_CA_PEM: \${{ secrets.CL_dev_app_KUBE_CA_PEM }}
        CL_dev_app_KUBE_TOKEN: \${{ secrets.CL_dev_app_KUBE_TOKEN }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/kubernetes:09d6680a69fa
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🚀 Deploy
          id: main
          run: bash .catladder-generated/github/scripts/app-deploy-dev.sh
          shell: bash
catladder-review.yml:
  name: 🛠️ catladder review
  on:
    pull_request:
      types:
        - opened
        - synchronize
        - reopened
  concurrency:
    group: catladder-review-\${{ github.event.number }}
    cancel-in-progress: true
  permissions:
    contents: read
    packages: write
  env: *a1
  jobs:
    catladder-image-docker-build:
      name: 🐳 catladder image docker-build
      runs-on: ubuntu-latest
