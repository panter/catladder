    app-docker-prod:
      name: app 🔨 docker | prod
      runs-on: ubuntu-latest
      needs:
        - catladder-image-docker-build
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: prod
      env:
        DOCKER_BUILDKIT: '1'
        CL_prod_app_SECRET_KEY_BASE: \${{ secrets.CL_prod_app_SECRET_KEY_BASE }}
        CL_prod_app_POSTGRESQL_PASSWORD: \${{ secrets.CL_prod_app_POSTGRESQL_PASSWORD }}
        CL_prod_app_cloudsqlProxyCredentials: \${{ secrets.CL_prod_app_cloudsqlProxyCredentials }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🔨 docker
          id: main
          run: bash .catladder-generated/github/scripts/app-docker-prod.sh
          shell: bash
    app-deploy-prod:
      name: app 🚀 Deploy | prod
      runs-on: ubuntu-latest
      needs:
        - app-docker-prod
        - catladder-image-kubernetes
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/kubernetes:09d6680a69fa
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: prod-app
        url: \${{ steps.main.outputs.url }}
      env:
        CL_prod_app_SECRET_KEY_BASE: \${{ secrets.CL_prod_app_SECRET_KEY_BASE }}
        CL_prod_app_POSTGRESQL_PASSWORD: \${{ secrets.CL_prod_app_POSTGRESQL_PASSWORD }}
        CL_prod_app_cloudsqlProxyCredentials: \${{ secrets.CL_prod_app_cloudsqlProxyCredentials }}
        CL_prod_app_KUBE_URL: \${{ secrets.CL_prod_app_KUBE_URL }}
        CL_prod_app_KUBE_CA_PEM: \${{ secrets.CL_prod_app_KUBE_CA_PEM }}
        CL_prod_app_KUBE_TOKEN: \${{ secrets.CL_prod_app_KUBE_TOKEN }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/kubernetes:09d6680a69fa
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🚀 Deploy
          id: main
          run: bash .catladder-generated/github/scripts/app-deploy-prod.sh
          shell: bash
