 input="\${input//$'\\n'/\\\\n}"
  if [[ "$input" == *\\\\n* ]]; then
    if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
      printf "\\"%s\\"\\n" "$input" 
    elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
      printf "\`%s\`\\n" "$input"
    elif [[ "$input" == *\\"* ]]; then
      printf "'%s'\\n" "$input"
    else
