      ENV_SHORT=stage
      APP_DIR=app2
      ENV_TYPE=stage
      HOSTNAME=pan-test-app-stage-app2-123456789012.asia-east1.run.app
      ROOT_URL=https://pan-test-app-stage-app2-123456789012.asia-east1.run.app
      HOSTNAME_INTERNAL=pan-test-app-stage-app2-123456789012.asia-east1.run.app
