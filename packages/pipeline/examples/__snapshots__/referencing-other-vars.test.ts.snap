            restore-keys: app1-yarn-
        - name: 🔨 app
          id: main
          run: bash .catladder-generated/github/scripts/app1-app-review.sh
          shell: bash
        - name: Upload artifacts
          uses: actions/upload-artifact@v4
          with:
            name: app1-app-review
            path: |-
              app1/__build_info.json
              app1/.next
              app1/dist
            if-no-files-found: warn
            include-hidden-files: true
    app1-docker-review:
      name: app1 🔨 docker | review
