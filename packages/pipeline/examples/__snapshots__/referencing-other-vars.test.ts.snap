application:
  host: |-
    app3.dev.test-app.pan.panter.cloud
  command: |-
    yarn start
  livenessProbe:
    httpGet:
      path: |-
        __health
  readinessProbe:
    httpGet:
      path: |-
        __health
  startupProbe:
    httpGet:
      path: |-
