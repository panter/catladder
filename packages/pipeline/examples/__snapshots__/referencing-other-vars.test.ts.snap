      DEPLOY_CLOUD_RUN_PROJECT_ID: |-
        asdf
      DEPLOY_CLOUD_RUN_REGION: |-
        asia-east1
      SECRET2: |-
        $(printf %s "$CL_review_app2_SECRET2" | sed '1!s/^/  /')
      foo2: |-
        foo-value-2
      referencingSecret: |-
