    app1-audit-review:
      name: app1 🛡 audit | review
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review
      env:
        CL_review_app1_SECRET1: \${{ secrets.CL_review_app1_SECRET1 }}
        CL_review_app1_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_review_app1_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🛡 audit
          id: main
          run: bash .catladder-generated/github/scripts/app1-audit-review.sh
          shell: bash
    app1-lint-review:
      name: app1 👮 lint | review
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review
      env:
        CL_review_app1_SECRET1: \${{ secrets.CL_review_app1_SECRET1 }}
        CL_review_app1_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_review_app1_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app1-node-modules
          id: cache-node-modules
          uses: actions/cache/restore@v4
          with:
            path: |-
              app1/node_modules
              app1/.yarn/install-state.gz
            key: app1-node-modules-\${{ hashFiles('app1/yarn.lock') }}
            restore-keys: app1-node-modules-
        - name: Cache app1-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache/restore@v4
          with:
            path: app1/.yarn
            key: app1-yarn-\${{ hashFiles('app1/yarn.lock') }}
            restore-keys: app1-yarn-
        - name: 👮 lint
          id: main
          run: bash .catladder-generated/github/scripts/app1-lint-review.sh
          shell: bash
