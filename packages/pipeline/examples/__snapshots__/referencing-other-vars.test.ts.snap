    app1-app-prod:
      name: app1 🔨 app | prod
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: prod
      env:
        CL_prod_app1_SECRET1: \${{ secrets.CL_prod_app1_SECRET1 }}
        CL_prod_app1_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_prod_app1_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app1-node-modules
          id: cache-node-modules
          uses: actions/cache@v4
          with:
            path: |-
              app1/node_modules
              app1/.yarn/install-state.gz
            key: app1-node-modules-\${{ hashFiles('app1/yarn.lock') }}
            restore-keys: app1-node-modules-
        - name: Cache app1-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache@v4
          with:
            path: app1/.yarn
            key: app1-yarn-\${{ hashFiles('app1/yarn.lock') }}
            restore-keys: app1-yarn-
        - name: 🔨 app
          id: main
          run: bash .catladder-generated/github/scripts/app1-app-prod.sh
          shell: bash
        - name: Upload artifacts
          uses: actions/upload-artifact@v4
          with:
            name: app1-app-prod
            path: |-
              app1/__build_info.json
              app1/.next
              app1/dist
            if-no-files-found: warn
            include-hidden-files: true
      if: \${{ inputs.job == 'app1-deploy-prod' }}
    app1-docker-prod:
      name: app1 🔨 docker | prod
      runs-on: ubuntu-latest
      needs:
        - app1-app-prod
        - catladder-image-docker-build
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: prod
      env:
        DOCKER_BUILDKIT: '1'
        CL_prod_app1_SECRET1: \${{ secrets.CL_prod_app1_SECRET1 }}
        CL_prod_app1_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_prod_app1_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app1-yarn
          uses: actions/cache/restore@v4
          with:
            path: app1/.yarn
            key: app1-yarn-\${{ hashFiles('app1/yarn.lock') }}
            restore-keys: app1-yarn-
        - name: Download artifacts from app1-app-prod
          uses: actions/download-artifact@v4
          with:
            name: app1-app-prod
        - name: 🔨 docker
          id: main
          run: bash .catladder-generated/github/scripts/app1-docker-prod.sh
          shell: bash
      if: \${{ inputs.job == 'app1-deploy-prod' }}
    app1-deploy-prod:
      name: app1 🚀 Deploy | prod
      runs-on: ubuntu-latest
      needs:
        - app1-app-prod
        - app1-docker-prod
      container:
        image: google/cloud-sdk:525.0.0
      environment:
        name: prod-app1
        url: \${{ steps.main.outputs.url }}
      env:
        CL_prod_app1_SECRET1: \${{ secrets.CL_prod_app1_SECRET1 }}
        CL_prod_app1_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_prod_app1_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: google/cloud-sdk:525.0.0
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🚀 Deploy
          id: main
          run: bash .catladder-generated/github/scripts/app1-deploy-prod.sh
          shell: bash
      if: \${{ inputs.job == 'app1-deploy-prod' }}
    app2-app-prod:
      name: app2 🔨 app | prod
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: prod
      env:
        CL_prod_app2_SECRET2: \${{ secrets.CL_prod_app2_SECRET2 }}
        CL_prod_app2_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_prod_app2_GCLOUD_DEPLOY_credentialsKey }}
        CL_prod_app1_SECRET1: \${{ secrets.CL_prod_app1_SECRET1 }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app2-node-modules
          id: cache-node-modules
          uses: actions/cache@v4
          with:
            path: |-
              app2/node_modules
              app2/.yarn/install-state.gz
            key: app2-node-modules-\${{ hashFiles('app2/yarn.lock') }}
            restore-keys: app2-node-modules-
        - name: Cache app2-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache@v4
          with:
            path: app2/.yarn
            key: app2-yarn-\${{ hashFiles('app2/yarn.lock') }}
            restore-keys: app2-yarn-
        - name: 🔨 app
          id: main
          run: bash .catladder-generated/github/scripts/app2-app-prod.sh
          shell: bash
        - name: Upload artifacts
          uses: actions/upload-artifact@v4
          with:
            name: app2-app-prod
            path: |-
              app2/__build_info.json
              app2/.next
              app2/dist
            if-no-files-found: warn
            include-hidden-files: true
      if: \${{ inputs.job == 'app2-deploy-prod' }}
    app2-docker-prod:
      name: app2 🔨 docker | prod
      runs-on: ubuntu-latest
      needs:
        - app2-app-prod
        - catladder-image-docker-build
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: prod
      env:
        DOCKER_BUILDKIT: '1'
        CL_prod_app2_SECRET2: \${{ secrets.CL_prod_app2_SECRET2 }}
        CL_prod_app2_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_prod_app2_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app2-yarn
          uses: actions/cache/restore@v4
          with:
            path: app2/.yarn
            key: app2-yarn-\${{ hashFiles('app2/yarn.lock') }}
            restore-keys: app2-yarn-
        - name: Download artifacts from app2-app-prod
          uses: actions/download-artifact@v4
          with:
            name: app2-app-prod
        - name: 🔨 docker
          id: main
          run: bash .catladder-generated/github/scripts/app2-docker-prod.sh
          shell: bash
      if: \${{ inputs.job == 'app2-deploy-prod' }}
    app2-deploy-prod:
      name: app2 🚀 Deploy | prod
      runs-on: ubuntu-latest
      needs:
        - app2-app-prod
        - app2-docker-prod
      container:
        image: google/cloud-sdk:525.0.0
      environment:
        name: prod-app2
        url: \${{ steps.main.outputs.url }}
      env:
        CL_prod_app2_SECRET2: \${{ secrets.CL_prod_app2_SECRET2 }}
        CL_prod_app2_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_prod_app2_GCLOUD_DEPLOY_credentialsKey }}
        CL_prod_app1_SECRET1: \${{ secrets.CL_prod_app1_SECRET1 }}
        CL_JOB_IMAGE: google/cloud-sdk:525.0.0
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🚀 Deploy
          id: main
          run: bash .catladder-generated/github/scripts/app2-deploy-prod.sh
          shell: bash
      if: \${{ inputs.job == 'app2-deploy-prod' }}
    app3-app-prod:
      name: app3 🔨 app | prod
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: prod
      env:
        CL_prod_app1_SECRET1: \${{ secrets.CL_prod_app1_SECRET1 }}
        CL_prod_app2_SECRET2: \${{ secrets.CL_prod_app2_SECRET2 }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache kube-node-modules
          id: cache-node-modules
          uses: actions/cache@v4
          with:
            path: |-
              kube/node_modules
              kube/.yarn/install-state.gz
            key: kube-node-modules-\${{ hashFiles('kube/yarn.lock') }}
            restore-keys: kube-node-modules-
        - name: Cache kube-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache@v4
          with:
            path: kube/.yarn
            key: kube-yarn-\${{ hashFiles('kube/yarn.lock') }}
            restore-keys: kube-yarn-
        - name: 🔨 app
          id: main
          run: bash .catladder-generated/github/scripts/app3-app-prod.sh
          shell: bash
        - name: Upload artifacts
          uses: actions/upload-artifact@v4
          with:
            name: app3-app-prod
            path: |-
              kube/__build_info.json
              kube/.next
              kube/dist
            if-no-files-found: warn
            include-hidden-files: true
      if: \${{ inputs.job == 'app3-deploy-prod' }}
    app3-docker-prod:
      name: app3 🔨 docker | prod
      runs-on: ubuntu-latest
      needs:
        - app3-app-prod
        - catladder-image-docker-build
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      env:
        DOCKER_BUILDKIT: '1'
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache kube-yarn
          uses: actions/cache/restore@v4
          with:
            path: kube/.yarn
            key: kube-yarn-\${{ hashFiles('kube/yarn.lock') }}
            restore-keys: kube-yarn-
        - name: Download artifacts from app3-app-prod
          uses: actions/download-artifact@v4
          with:
            name: app3-app-prod
        - name: 🔨 docker
          id: main
          run: bash .catladder-generated/github/scripts/app3-docker-prod.sh
          shell: bash
      if: \${{ inputs.job == 'app3-deploy-prod' }}
    app3-deploy-prod:
      name: app3 🚀 Deploy | prod
      runs-on: ubuntu-latest
      needs:
        - app3-app-prod
        - app3-docker-prod
        - catladder-image-kubernetes
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/kubernetes:a442f2fe0109
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: prod-app3
        url: \${{ steps.main.outputs.url }}
      env:
        CL_prod_app1_SECRET1: \${{ secrets.CL_prod_app1_SECRET1 }}
        CL_prod_app2_SECRET2: \${{ secrets.CL_prod_app2_SECRET2 }}
        CL_prod_app3_KUBE_URL: \${{ secrets.CL_prod_app3_KUBE_URL }}
        CL_prod_app3_KUBE_CA_PEM: \${{ secrets.CL_prod_app3_KUBE_CA_PEM }}
        CL_prod_app3_KUBE_TOKEN: \${{ secrets.CL_prod_app3_KUBE_TOKEN }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/kubernetes:a442f2fe0109
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🚀 Deploy
          id: main
          run: bash .catladder-generated/github/scripts/app3-deploy-prod.sh
          shell: bash
      if: \${{ inputs.job == 'app3-deploy-prod' }}
catladder-stop.yml:
  name: ⏹️ catladder stop
  on:
    workflow_dispatch:
      inputs:
        job:
          description: the task to run
          required: true
          type: choice
          options:
            - app1-stop-dev
            - app2-stop-dev
            - app3-stop-dev
            - app1-stop-stage
            - app1-stop-prod
            - app2-stop-stage
            - app2-stop-prod
            - app3-stop-stage
            - app3-stop-prod
  permissions:
    contents: read
    packages: write
  env: *a1
  jobs:
    catladder-image-jobs-default:
      name: 🐳 catladder image jobs-default
      runs-on: ubuntu-latest
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🐳 catladder image jobs-default
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "docker-login" "Docker Login"
            docker login --username $CL_REGISTRY_USER --password $CL_JOB_TOKEN $CL_REGISTRY
            collapseable_section_end "docker-login"
            collapseable_section_start "check-image" "Checking if image exists"
            if docker manifest inspect ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8 > /dev/null 2>&1; then
              echo "Image ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8 already exists, skipping build"
              exit 0
            fi
            collapseable_section_end "check-image"
            collapseable_section_start "docker-build" "Building image"
            DOCKER_BUILDKIT=1 docker build -t ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8 -f .catladder-generated/images/jobs-default/Dockerfile .catladder-generated/images
            collapseable_section_end "docker-build"
            collapseable_section_start "docker-push" "Pushing image"
            docker push ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
            collapseable_section_end "docker-push"
          shell: bash
    catladder-image-jobs-testing-chrome:
      name: 🐳 catladder image jobs-testing-chrome
      runs-on: ubuntu-latest
      steps:
        - name: Checkout
          uses: actions/checkout@v4
