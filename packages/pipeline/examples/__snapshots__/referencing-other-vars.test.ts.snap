        CL_dev_app2_SECRET2: \${{ secrets.CL_dev_app2_SECRET2 }}
        CL_dev_app3_KUBE_URL: \${{ secrets.CL_dev_app3_KUBE_URL }}
        CL_dev_app3_KUBE_CA_PEM: \${{ secrets.CL_dev_app3_KUBE_CA_PEM }}
        CL_dev_app3_KUBE_TOKEN: \${{ secrets.CL_dev_app3_KUBE_TOKEN }}
