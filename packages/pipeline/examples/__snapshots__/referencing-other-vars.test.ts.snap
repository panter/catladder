    app1-audit-dev:
      name: app1 🛡 audit | dev
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev
      env:
        CL_dev_app1_SECRET1: \${{ secrets.CL_dev_app1_SECRET1 }}
        CL_dev_app1_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_dev_app1_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🛡 audit
          id: main
          run: bash .catladder-generated/github/scripts/app1-audit-dev.sh
          shell: bash
    app1-lint-dev:
      name: app1 👮 lint | dev
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev
      env:
        CL_dev_app1_SECRET1: \${{ secrets.CL_dev_app1_SECRET1 }}
        CL_dev_app1_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_dev_app1_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app1-node-modules
          id: cache-node-modules
          uses: actions/cache/restore@v4
          with:
            path: |-
              app1/node_modules
              app1/.yarn/install-state.gz
            key: app1-node-modules-\${{ hashFiles('app1/yarn.lock') }}
            restore-keys: app1-node-modules-
        - name: Cache app1-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache/restore@v4
          with:
            path: app1/.yarn
            key: app1-yarn-\${{ hashFiles('app1/yarn.lock') }}
            restore-keys: app1-yarn-
        - name: 👮 lint
          id: main
          run: bash .catladder-generated/github/scripts/app1-lint-dev.sh
          shell: bash
    app1-test-dev:
      name: app1 🧪 test | dev
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-testing-chrome
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-testing-chrome:6c33db75f445
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev
      env:
        CL_dev_app1_SECRET1: \${{ secrets.CL_dev_app1_SECRET1 }}
        CL_dev_app1_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_dev_app1_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-testing-chrome:6c33db75f445
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app1-node-modules
          id: cache-node-modules
          uses: actions/cache/restore@v4
          with:
            path: |-
              app1/node_modules
              app1/.yarn/install-state.gz
            key: app1-node-modules-\${{ hashFiles('app1/yarn.lock') }}
            restore-keys: app1-node-modules-
        - name: Cache app1-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache/restore@v4
          with:
            path: app1/.yarn
            key: app1-yarn-\${{ hashFiles('app1/yarn.lock') }}
            restore-keys: app1-yarn-
        - name: 🧪 test
          id: main
          run: bash .catladder-generated/github/scripts/app1-test-dev.sh
          shell: bash
    app1-app-dev:
      name: app1 🔨 app | dev
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev
      env:
        CL_dev_app1_SECRET1: \${{ secrets.CL_dev_app1_SECRET1 }}
        CL_dev_app1_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_dev_app1_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:64e36cb505a8
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app1-node-modules
          id: cache-node-modules
          uses: actions/cache@v4
          with:
            path: |-
              app1/node_modules
              app1/.yarn/install-state.gz
            key: app1-node-modules-\${{ hashFiles('app1/yarn.lock') }}
            restore-keys: app1-node-modules-
        - name: Cache app1-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache@v4
          with:
            path: app1/.yarn
            key: app1-yarn-\${{ hashFiles('app1/yarn.lock') }}
            restore-keys: app1-yarn-
        - name: 🔨 app
          id: main
          run: bash .catladder-generated/github/scripts/app1-app-dev.sh
          shell: bash
        - name: Upload artifacts
          uses: actions/upload-artifact@v4
          with:
            name: app1-app-dev
            path: |-
              app1/__build_info.json
              app1/.next
              app1/dist
            if-no-files-found: warn
            include-hidden-files: true
    app1-docker-dev:
      name: app1 🔨 docker | dev
      runs-on: ubuntu-latest
      needs:
        - app1-app-dev
        - catladder-image-docker-build
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev
      env:
        DOCKER_BUILDKIT: '1'
        CL_dev_app1_SECRET1: \${{ secrets.CL_dev_app1_SECRET1 }}
        CL_dev_app1_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_dev_app1_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app1-yarn
          uses: actions/cache/restore@v4
          with:
            path: app1/.yarn
            key: app1-yarn-\${{ hashFiles('app1/yarn.lock') }}
            restore-keys: app1-yarn-
        - name: Download artifacts from app1-app-dev
          uses: actions/download-artifact@v4
          with:
            name: app1-app-dev
        - name: 🔨 docker
          id: main
          run: bash .catladder-generated/github/scripts/app1-docker-dev.sh
          shell: bash
    app1-deploy-dev:
      name: app1 🚀 Deploy | dev
