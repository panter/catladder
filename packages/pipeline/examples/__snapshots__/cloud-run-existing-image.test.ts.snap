ROOT_URL: |-
  https://pan-test-app-prod-www-123456789012.europe-west6.run.app
HOSTNAME_INTERNAL: |-
  pan-test-app-prod-www-123456789012.europe-west6.run.app
ROOT_URL_INTERNAL: |-
