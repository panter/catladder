            DOCKER_BUILDKIT=1 docker build -t ghcr.io/\${{ github.repository }}/job-images/java-build:75104a2b20ec --build-arg 'JAVA_VERSION=21' -f packages/pipeline/examples/__fixtures__/project-image/Dockerfile packages/pipeline/examples/__fixtures__/project-image
