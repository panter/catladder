catladder-release.yml:
  name: catladder release
  on:
    push:
      tags:
        - v*
    workflow_dispatch: {}
  permissions:
    contents: read
    packages: write
  env: *a1
  jobs:
    catladder-image-docker-build:
      name: 🐳 catladder image docker-build
      runs-on: ubuntu-latest
      steps:
        - name: Checkout
          uses: actions/checkout@v4
