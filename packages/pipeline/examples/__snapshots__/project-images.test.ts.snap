    api-app-stage:
      name: api 🔨 app | stage
      runs-on: ubuntu-latest
      needs:
        - image-java-build
      container:
        image: ghcr.io/\${{ github.repository }}/job-images/java-build:75104a2b20ec
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: stage
      env:
        CL_stage_api_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_stage_api_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/job-images/java-build:75104a2b20ec
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🔨 app
          id: main
          run: bash .catladder-generated/github/scripts/api-app-stage.sh
          shell: bash
        - name: Upload artifacts
          uses: actions/upload-artifact@v4
          with:
            name: api-app-stage
            path: |-
              api/__build_info.json
              api/dist
            if-no-files-found: warn
            include-hidden-files: true
    api-docker-stage:
      name: api 🔨 docker | stage
      runs-on: ubuntu-latest
      needs:
        - api-app-stage
        - catladder-image-docker-build
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/docker-build:d97f1ac6c3c5
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: stage
      env:
        DOCKER_BUILDKIT: '1'
        CL_stage_api_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_stage_api_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/docker-build:d97f1ac6c3c5
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Download artifacts from api-app-stage
          uses: actions/download-artifact@v4
          with:
            name: api-app-stage
        - name: 🔨 docker
          id: main
          run: bash .catladder-generated/github/scripts/api-docker-stage.sh
          shell: bash
    api-deploy-stage:
      name: api 🚀 Deploy | stage
      runs-on: ubuntu-latest
      needs:
        - api-app-stage
        - api-docker-stage
      container:
        image: google/cloud-sdk:525.0.0
      environment:
        name: stage-api
        url: \${{ steps.main.outputs.url }}
      env:
        CL_stage_api_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_stage_api_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: google/cloud-sdk:525.0.0
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🚀 Deploy
          id: main
          run: bash .catladder-generated/github/scripts/api-deploy-stage.sh
          shell: bash
