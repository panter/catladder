    api-app-review:
      name: api 🔨 app | review
      runs-on: ubuntu-latest
      needs:
        - image-java-build
      container:
        image: ghcr.io/\${{ github.repository }}/job-images/java-build:75104a2b20ec
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review
      env:
        CL_review_api_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_review_api_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/job-images/java-build:75104a2b20ec
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🔨 app
          id: main
          run: bash .catladder-generated/github/scripts/api-app-review.sh
