    - DOCKER_BUILDKIT=1 docker build -t $CI_REGISTRY_IMAGE/catladder/docker-build:d97f1ac6c3c5 -f .catladder-generated/images/docker-build/Dockerfile .catladder-generated/images/docker-build
    - collapseable_section_end "docker-build"
    - collapseable_section_start "docker-push" "Pushing image"
    - docker push $CI_REGISTRY_IMAGE/catladder/docker-build:d97f1ac6c3c5
    - collapseable_section_end "docker-push"
  rules:
