        postgresdb
      DB_POSTGRESDB_DATABASE: |-
        $(printf %s "pan-my-n8n-app-review-$([ -n "$CI_MERGE_REQUEST_IID" ] && echo "mr$CI_MERGE_REQUEST_IID" || { [ -n "$CI_COMMIT_REF_SLUG" ] && echo "$CI_COMMIT_REF_SLUG" || echo "unknown"; })-n8n" | sed '1!s/^/  /')
      DB_POSTGRESDB_HOST: |-
