    name: review/$CI_COMMIT_REF_NAME/n8n
    url: $CL_GITLAB_ENVIRONMENT_URL
    on_stop: 'n8n 🛑 Stop ⚠️ | review '
    auto_stop_in: 1 week
  artifacts:
    reports:
      dotenv: gitlab_environment.env
  rules:
    - when: never
      if: $CI_PIPELINE_SOURCE  == "trigger"
    - when: on_success
      if: $CI_MERGE_REQUEST_ID
  needs: []
  retry: *a7
  interruptible: true
  allow_failure: false
'n8n 🛑 Stop ⚠️ | review ':
  stage: stop review
  image: google/cloud-sdk:525.0.0
  variables:
    KUBERNETES_CPU_REQUEST: '0.22'
    KUBERNETES_MEMORY_REQUEST: 200Mi
    KUBERNETES_MEMORY_LIMIT: 400Mi
    GIT_STRATEGY: none
  script:
    - collapseable_section_start "injectvars" "Injecting variables"
    - export CLOUDSDK_CORE_DISABLE_PROMPTS="1"
    - collapseable_section_end "injectvars"
    - set +e
    - gcloud auth activate-service-account --key-file=<(echo "$CL_review_n8n_GCLOUD_DEPLOY_credentialsKey")
    - gcloud run services delete $(printf %s "pan-my-n8n-app-review-$([ -n "$CI_MERGE_REQUEST_IID" ] && echo "mr$CI_MERGE_REQUEST_IID" || { [ -n "$CI_COMMIT_REF_SLUG" ] && echo "$CI_COMMIT_REF_SLUG" || echo "unknown"; })-n8n" | awk '{print tolower($0)}') --project=google-project-id --region=europe-west6
    - echo "deleting database pan-my-n8n-app-review-$([ -n "$CI_MERGE_REQUEST_IID" ] && echo "mr$CI_MERGE_REQUEST_IID" || { [ -n "$CI_COMMIT_REF_SLUG" ] && echo "$CI_COMMIT_REF_SLUG" || echo "unknown"; })-n8n..."
    - echo "👆 this can take multiple attemps (3-5min), because google cloud run may still have a connection to the database after the cloud run service is shut down"
    - "\\n    _attempt=0\\n    until gcloud sql databases delete pan-my-n8n-app-review-$([ -n \\"$CI_MERGE_REQUEST_IID\\" ] && echo \\"mr$CI_MERGE_REQUEST_IID\\" || { [ -n \\"$CI_COMMIT_REF_SLUG\\" ] && echo \\"$CI_COMMIT_REF_SLUG\\" || echo \\"unknown\\"; })-n8n --instance=instancename --project projectId\\n    do\\n      _attempt=$((_attempt+1))\\n      if [ \\"$_attempt\\" -ge 30 ]; then\\n        echo \\"giving up after 30 attempts\\"\\n        exit 1\\n      fi\\n      echo \\"Trying again.\\"\\n      sleep 10\\n    done\\n  "
    - gcloud artifacts docker images delete europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/review/n8n/$([ -n "$CI_MERGE_REQUEST_IID" ] && echo "mr$CI_MERGE_REQUEST_IID" || { [ -n "$CI_COMMIT_REF_SLUG" ] && echo "$CI_COMMIT_REF_SLUG" || echo "unknown"; }) --quiet --delete-tags
    - gcloud artifacts docker images list europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/caches/n8n --sort-by=~CREATE_TIME --format="value(version)" | tail -n +2 | while read -r version; do gcloud artifacts docker images delete europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/caches/n8n@$version --quiet --delete-tags; done
    - set +e
    - gcloud artifacts docker images delete europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/review/n8n --quiet --delete-tags
    - set -e
    - set -e
  environment:
    name: review/$CI_COMMIT_REF_NAME/n8n
    action: stop
  rules:
    - when: never
      if: $CI_PIPELINE_SOURCE  == "trigger"
    - when: manual
      if: $CI_MERGE_REQUEST_ID
  needs: []
  retry: *a7
  interruptible: true
  allow_failure: true
'n8n 🚀 Deploy | stage ':
  stage: deploy stage
  image: google/cloud-sdk:525.0.0
  variables:
    KUBERNETES_CPU_REQUEST: '0.22'
    KUBERNETES_MEMORY_REQUEST: 200Mi
    KUBERNETES_MEMORY_LIMIT: 400Mi
  script:
    - collapseable_section_start "injectvars" "Injecting variables"
    - export ENV_SHORT="stage"
    - export APP_DIR="n8n"
    - export ENV_TYPE="stage"
    - export BUILD_INFO_BUILD_ID="$(git describe --tags 2>/dev/null || git rev-parse HEAD)"
    - export BUILD_INFO_BUILD_TIME="$CI_JOB_STARTED_AT"
    - export BUILD_INFO_CURRENT_VERSION="$(tag=$(git ls-remote origin "refs/tags/v*[0-9]" 2>/dev/null | cut -f 2- | sort -V | tail -1 | sed 's/refs\\/tags\\/v//'); [ -z "$tag" ] && echo "0.0.0" || echo "$tag")"
    - export HOSTNAME="pan-my-n8n-app-stage-n8n-123456789012.europe-west6.run.app"
    - export ROOT_URL="https://pan-my-n8n-app-stage-n8n-123456789012.europe-west6.run.app"
    - export HOSTNAME_INTERNAL="pan-my-n8n-app-stage-n8n-123456789012.europe-west6.run.app"
    - export ROOT_URL_INTERNAL="https://pan-my-n8n-app-stage-n8n-123456789012.europe-west6.run.app"
    - export CLOUD_SQL_INSTANCE_CONNECTION_NAME="projectId:region:instancename"
    - export DB_NAME="pan-my-n8n-app-stage-n8n"
    - export DB_USER="postgres"
    - export DB_PASSWORD="$CL_stage_n8n_DB_PASSWORD"
    - export DATABASE_URL="postgresql://postgres:$CL_stage_n8n_DB_PASSWORD@localhost/pan-my-n8n-app-stage-n8n?host=/cloudsql/projectId:region:instancename"
    - export DATABASE_JDBC_URL="jdbc:postgresql:///pan-my-n8n-app-stage-n8n?cloudSqlInstance=projectId:region:instancename&socketFactory=com.google.cloud.sql.postgres.SocketFactory&user=postgres&password=$CL_stage_n8n_DB_PASSWORD"
    - export DEPLOY_CLOUD_RUN_SERVICE_NAME="pan-my-n8n-app-stage-n8n"
    - export DEPLOY_CLOUD_RUN_PROJECT_ID="google-project-id"
    - export DEPLOY_CLOUD_RUN_REGION="europe-west6"
    - export N8N_ENCRYPTION_KEY="$CL_stage_n8n_N8N_ENCRYPTION_KEY"
    - export GCLOUD_DEPLOY_credentialsKey="$CL_stage_n8n_GCLOUD_DEPLOY_credentialsKey"
    - export N8N_PORT="8080"
    - export N8N_PROTOCOL="https"
    - export DB_TYPE="postgresdb"
    - export DB_POSTGRESDB_DATABASE="pan-my-n8n-app-stage-n8n"
    - export DB_POSTGRESDB_HOST="/cloudsql/projectId:region:instancename"
