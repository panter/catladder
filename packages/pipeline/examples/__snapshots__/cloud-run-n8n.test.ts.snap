      DEPLOY_CLOUD_RUN_SERVICE_NAME: |-
        $(printf %s "$(printf %s "pan-my-n8n-app-review-$([ -n "$CI_MERGE_REQUEST_IID" ] && echo "mr$CI_MERGE_REQUEST_IID" || { [ -n "$CI_COMMIT_REF_SLUG" ] && echo "$CI_COMMIT_REF_SLUG" || echo "unknown"; })-n8n" | awk '{print tolower($0)}')" | sed '1!s/^/  /')
      DEPLOY_CLOUD_RUN_PROJECT_ID: |-
        google-project-id
      DEPLOY_CLOUD_RUN_REGION: |-
        europe-west6
