        $(printf %s "$CL_review_n8n_DB_PASSWORD" | sed '1!s/^/  /')
      DB_POSTGRESDB_PORT: |-
        5432
      DB_POSTGRESDB_SCHEMA: |-
        public
      GENERIC_TIMEZONE: |-
        Europe/Zurich
      N8N_DIAGNOSTICS_ENABLED: |-
        false
      N8N_PERSONALIZATION_ENABLED: |-
        false
      QUEUE_HEALTH_CHECK_ACTIVE: |-
