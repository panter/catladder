    app-docker-review:
      name: app 🔨 docker | review
      runs-on: ubuntu-latest
      needs:
        - catladder-image-docker-build
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      env:
        DOCKER_BUILDKIT: '1'
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🔨 docker
          id: main
          run: bash .catladder-generated/github/scripts/app-docker-review.sh
          shell: bash
    app-deploy-review:
      name: app 🚀 Deploy | review
      runs-on: ubuntu-latest
      needs:
        - app-docker-review
        - catladder-image-kubernetes
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/kubernetes:e5e779a652a4
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review-app
        url: \${{ steps.main.outputs.url }}
      env:
        CL_review_app_KUBE_URL: \${{ secrets.CL_review_app_KUBE_URL }}
        CL_review_app_KUBE_CA_PEM: \${{ secrets.CL_review_app_KUBE_CA_PEM }}
        CL_review_app_KUBE_TOKEN: \${{ secrets.CL_review_app_KUBE_TOKEN }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/kubernetes:e5e779a652a4
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🚀 Deploy
          id: main
          run: bash .catladder-generated/github/scripts/app-deploy-review.sh
          shell: bash
    catladder-ok:
      name: catladder ✅
      runs-on: ubuntu-latest
      needs:
        - app-deploy-review
        - app-docker-review
        - catladder-image-docker-build
        - catladder-image-kubernetes
        - catladder-image-semantic-release
      if: always()
      steps:
        - name: catladder ✅
          run: |-
            results='\${{ toJSON(needs) }}'
            echo "$results"
            if echo "$results" | grep -qE '"result": "(failure|cancelled|skipped)"'; then
              echo "a required job did not succeed"; exit 1
            fi
          shell: bash
catladder-release.yml:
  name: 🛠️ catladder release
  on:
    push:
      tags:
        - v*
    workflow_dispatch: {}
  concurrency:
    group: catladder-release-\${{ github.ref_name }}
    cancel-in-progress: false
  permissions:
    contents: read
    packages: write
  env: *a1
  jobs:
    catladder-image-docker-build:
      name: 🐳 catladder image docker-build
      runs-on: ubuntu-latest
      steps:
