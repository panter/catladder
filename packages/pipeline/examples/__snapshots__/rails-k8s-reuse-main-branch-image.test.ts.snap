            DOCKER_BUILDKIT=1 docker build -t ghcr.io/\${{ github.repository }}/catladder/semantic-release:3d936f86c937 -f .catladder-generated/images/semantic-release/Dockerfile .catladder-generated/images/semantic-release
            collapseable_section_end "docker-build"
