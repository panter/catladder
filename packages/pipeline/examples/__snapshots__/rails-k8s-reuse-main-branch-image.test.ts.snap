application:
  host: |-
    app.dev.test-app.pan.panter.cloud
  livenessProbe:
    httpGet:
      path: |-
        __health
  readinessProbe:
    httpGet:
      path: |-
        __health
  startupProbe:
    httpGet:
      path: |-
        __health

EOF

