application:
  host: |-
    app.stage.test-app.pan.panter.cloud
  livenessProbe:
    httpGet:
      path: |-
        __health
  readinessProbe:
    httpGet:
      path: |-
        __health
  startupProbe:
    httpGet:
      path: |-
        __health

EOF

collapseable_section_end "writeallvalues"
kubernetesCreateSecret
kubernetesDeploy
echo deployment successful 😻
echo "url=$ROOT_URL" >> "$GITHUB_OUTPUT"

