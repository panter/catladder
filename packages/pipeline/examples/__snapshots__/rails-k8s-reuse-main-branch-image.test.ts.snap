    - export HOSTNAME_INTERNAL="app.stage.test-app.pan.panter.cloud"
    - export ROOT_URL_INTERNAL="https://app.stage.test-app.pan.panter.cloud"
    - export KUBE_NAMESPACE="pan-test-app-stage"
