    app-docker-stage:
      name: app 🔨 docker | stage
      runs-on: ubuntu-latest
      needs:
        - catladder-image-docker-build
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      env:
        DOCKER_BUILDKIT: '1'
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🔨 docker
          id: main
          run: bash .catladder-generated/github/scripts/app-docker-stage.sh
          shell: bash
    app-deploy-stage:
      name: app 🚀 Deploy | stage
      runs-on: ubuntu-latest
      needs:
        - app-docker-stage
        - catladder-image-kubernetes
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/kubernetes:e5e779a652a4
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: stage-app
        url: \${{ steps.main.outputs.url }}
      env:
        CL_stage_app_KUBE_URL: \${{ secrets.CL_stage_app_KUBE_URL }}
        CL_stage_app_KUBE_CA_PEM: \${{ secrets.CL_stage_app_KUBE_CA_PEM }}
        CL_stage_app_KUBE_TOKEN: \${{ secrets.CL_stage_app_KUBE_TOKEN }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/kubernetes:e5e779a652a4
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🚀 Deploy
          id: main
          run: bash .catladder-generated/github/scripts/app-deploy-stage.sh
          shell: bash
catladder-review-stop.yml:
  name: 🛑 catladder stop review app
  on:
    pull_request:
      types:
        - closed
    workflow_dispatch:
      inputs:
        pr:
          description: number of the pull request whose review app to stop
          required: true
          type: string
  permissions:
    contents: read
    packages: write
  env:
    CL_JOB_TOKEN: \${{ github.token }}
    CL_REGISTRY: ghcr.io
    CL_REGISTRY_IMAGE: ghcr.io/\${{ github.repository }}
    CL_REGISTRY_USER: \${{ github.actor }}
    CL_PR_NUMBER: \${{ github.event.number || inputs.pr }}
  jobs:
    catladder-image-docker-build:
      name: 🐳 catladder image docker-build
      runs-on: ubuntu-latest
      steps:
        - name: Checkout
          uses: actions/checkout@v4
