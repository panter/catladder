    HOSTNAME: |-
      app.stage.test-app.pan.panter.cloud
    ROOT_URL: |-
      https://app.stage.test-app.pan.panter.cloud
    HOSTNAME_INTERNAL: |-
      app.stage.test-app.pan.panter.cloud
    ROOT_URL_INTERNAL: |-
      https://app.stage.test-app.pan.panter.cloud
