'www 👮 lint | dev ':
  stage: test
  image: $CI_REGISTRY_IMAGE/catladder/jobs-default:64e36cb505a8
  variables:
    KUBERNETES_CPU_REQUEST: '0.45'
    KUBERNETES_MEMORY_REQUEST: 1Gi
