create release:
  stage: release
  image: $CI_REGISTRY_IMAGE/catladder/semantic-release:a9d7c7ca552f
  script:
    - semanticRelease
  after_script:
    - echo '👉 If this job failed with access denied, the project access token might be invald - run \`project-renew-token\` in catladder CLI to fix.'
  rules:
    - &a3
      if: $CI_COMMIT_MESSAGE =~ /^chore\\(release\\).*/
      when: never
    - *a1
    - &a4
      if: $CI_PIPELINE_SOURCE  == "schedule"
      when: never
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
      when: manual
    - if: $CI_COMMIT_BRANCH =~ /^[0-9]+.([0-9]+|x).x$/
      when: manual
⚠️ force create release:
  stage: release
  image: $CI_REGISTRY_IMAGE/catladder/semantic-release:a9d7c7ca552f
  script:
    - semanticRelease
  after_script:
    - echo '👉 If this job failed with access denied, the project access token might be invald - run \`project-renew-token\` in catladder CLI to fix.'
  rules:
    - *a3
    - *a1
    - *a4
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
      when: manual
    - if: $CI_COMMIT_BRANCH =~ /^[0-9]+.([0-9]+|x).x$/
      when: manual
  needs: []
'www 🛡 audit | dev ':
  stage: test
  image: $CI_REGISTRY_IMAGE/catladder/jobs-default:64e36cb505a8
  variables:
    KUBERNETES_CPU_REQUEST: '0.45'
    KUBERNETES_MEMORY_REQUEST: 1Gi
