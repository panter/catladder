      BUILD_INFO_CURRENT_VERSION: |-
        $(printf %s "$(tag=$(git ls-remote origin "refs/tags/v*[0-9]" 2>/dev/null | cut -f 2- | sort -V | tail -1 | sed 's/refs\\/tags\\/v//'); [ -z "$tag" ] && echo "0.0.0" || echo "$tag")" | sed '1!s/^/  /')
      HOSTNAME: |-
        pan-agent-example-app-dev-www-123456789012.europe-west6.run.app
      ROOT_URL: |-
        https://pan-agent-example-app-dev-www-123456789012.europe-west6.run.app
      HOSTNAME_INTERNAL: |-
        pan-agent-example-app-dev-www-123456789012.europe-west6.run.app
