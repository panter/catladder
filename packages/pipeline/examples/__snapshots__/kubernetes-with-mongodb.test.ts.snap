    api-audit-dev:
      name: api 🛡 audit | dev
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:8c93778931df
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev
      continue-on-error: true
      env:
        CL_dev_api_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_dev_api_MONGODB_ROOT_PASSWORD }}
        CL_dev_api_MONGODB_REPLICASET_KEY: \${{ secrets.CL_dev_api_MONGODB_REPLICASET_KEY }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:8c93778931df
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🛡 audit
          id: main
          run: bash .catladder-generated/github/scripts/api-audit-dev.sh
          shell: bash
    api-lint-dev:
      name: api 👮 lint | dev
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:8c93778931df
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev
      env:
        CL_dev_api_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_dev_api_MONGODB_ROOT_PASSWORD }}
        CL_dev_api_MONGODB_REPLICASET_KEY: \${{ secrets.CL_dev_api_MONGODB_REPLICASET_KEY }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:8c93778931df
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache api-node-modules
          id: cache-node-modules
          uses: actions/cache/restore@v4
          with:
            path: |-
              api/node_modules
              api/.yarn/install-state.gz
            key: api-node-modules-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-node-modules-
        - name: Cache api-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache/restore@v4
          with:
            path: api/.yarn
            key: api-yarn-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-yarn-
        - name: 👮 lint
          id: main
          run: bash .catladder-generated/github/scripts/api-lint-dev.sh
          shell: bash
    api-test-dev:
      name: api 🧪 test | dev
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:8c93778931df
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev
      env:
        CL_dev_api_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_dev_api_MONGODB_ROOT_PASSWORD }}
        CL_dev_api_MONGODB_REPLICASET_KEY: \${{ secrets.CL_dev_api_MONGODB_REPLICASET_KEY }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:8c93778931df
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache api-node-modules
          id: cache-node-modules
          uses: actions/cache/restore@v4
          with:
            path: |-
              api/node_modules
              api/.yarn/install-state.gz
            key: api-node-modules-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-node-modules-
        - name: Cache api-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache/restore@v4
          with:
            path: api/.yarn
            key: api-yarn-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-yarn-
        - name: 🧪 test
          id: main
          run: bash .catladder-generated/github/scripts/api-test-dev.sh
          shell: bash
    api-app-dev:
      name: api 🔨 app | dev
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:8c93778931df
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev
      env:
        CL_dev_api_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_dev_api_MONGODB_ROOT_PASSWORD }}
        CL_dev_api_MONGODB_REPLICASET_KEY: \${{ secrets.CL_dev_api_MONGODB_REPLICASET_KEY }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:8c93778931df
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache api-node-modules
          id: cache-node-modules
          uses: actions/cache@v4
          with:
            path: |-
              api/node_modules
              api/.yarn/install-state.gz
            key: api-node-modules-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-node-modules-
        - name: Cache api-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache@v4
          with:
            path: api/.yarn
            key: api-yarn-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-yarn-
        - name: 🔨 app
          id: main
          run: bash .catladder-generated/github/scripts/api-app-dev.sh
          shell: bash
        - name: Upload artifacts
          uses: actions/upload-artifact@v4
          with:
            name: api-app-dev
            path: |-
              api/__build_info.json
              api/.next
              api/dist
            if-no-files-found: warn
            include-hidden-files: true
    api-docker-dev:
      name: api 🔨 docker | dev
      runs-on: ubuntu-latest
      needs:
        - api-app-dev
        - catladder-image-docker-build
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev
      env:
        DOCKER_BUILDKIT: '1'
        CL_dev_api_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_dev_api_MONGODB_ROOT_PASSWORD }}
        CL_dev_api_MONGODB_REPLICASET_KEY: \${{ secrets.CL_dev_api_MONGODB_REPLICASET_KEY }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache api-yarn
          uses: actions/cache/restore@v4
          with:
            path: api/.yarn
            key: api-yarn-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-yarn-
        - name: Download artifacts from api-app-dev
          uses: actions/download-artifact@v4
          with:
            name: api-app-dev
        - name: 🔨 docker
          id: main
          run: bash .catladder-generated/github/scripts/api-docker-dev.sh
          shell: bash
    api-deploy-dev:
      name: api 🚀 Deploy | dev
      runs-on: ubuntu-latest
      needs:
        - api-app-dev
        - api-audit-dev
        - api-docker-dev
        - api-lint-dev
        - api-test-dev
        - catladder-image-kubernetes
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/kubernetes:e5e779a652a4
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev-api
        url: \${{ steps.main.outputs.url }}
      env:
        CL_dev_api_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_dev_api_MONGODB_ROOT_PASSWORD }}
        CL_dev_api_MONGODB_REPLICASET_KEY: \${{ secrets.CL_dev_api_MONGODB_REPLICASET_KEY }}
        CL_dev_api_KUBE_URL: \${{ secrets.CL_dev_api_KUBE_URL }}
        CL_dev_api_KUBE_CA_PEM: \${{ secrets.CL_dev_api_KUBE_CA_PEM }}
        CL_dev_api_KUBE_TOKEN: \${{ secrets.CL_dev_api_KUBE_TOKEN }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/kubernetes:e5e779a652a4
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🚀 Deploy
          id: main
          run: bash .catladder-generated/github/scripts/api-deploy-dev.sh
          shell: bash
catladder-review.yml:
  name: 🛠️ catladder review
  on:
    pull_request:
      types:
        - opened
        - synchronize
        - reopened
  concurrency:
    group: catladder-review-\${{ github.event.number }}
    cancel-in-progress: true
  permissions:
    contents: read
    packages: write
  env: *a1
  jobs:
    catladder-image-jobs-default:
      name: 🐳 catladder image jobs-default
      runs-on: ubuntu-latest
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🐳 catladder image jobs-default
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
