    api-audit-review:
      name: api 🛡 audit | review
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:8c93778931df
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review
      continue-on-error: true
      env:
        CL_review_api_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_review_api_MONGODB_ROOT_PASSWORD }}
        CL_review_api_MONGODB_REPLICASET_KEY: \${{ secrets.CL_review_api_MONGODB_REPLICASET_KEY }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:8c93778931df
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🛡 audit
          id: main
          run: bash .catladder-generated/github/scripts/api-audit-review.sh
          shell: bash
    api-lint-review:
      name: api 👮 lint | review
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:8c93778931df
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review
      env:
        CL_review_api_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_review_api_MONGODB_ROOT_PASSWORD }}
        CL_review_api_MONGODB_REPLICASET_KEY: \${{ secrets.CL_review_api_MONGODB_REPLICASET_KEY }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:8c93778931df
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache api-node-modules
          id: cache-node-modules
          uses: actions/cache/restore@v4
          with:
            path: |-
              api/node_modules
              api/.yarn/install-state.gz
            key: api-node-modules-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-node-modules-
        - name: Cache api-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache/restore@v4
          with:
            path: api/.yarn
            key: api-yarn-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-yarn-
        - name: 👮 lint
          id: main
          run: bash .catladder-generated/github/scripts/api-lint-review.sh
          shell: bash
    api-test-review:
      name: api 🧪 test | review
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:8c93778931df
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review
      env:
        CL_review_api_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_review_api_MONGODB_ROOT_PASSWORD }}
        CL_review_api_MONGODB_REPLICASET_KEY: \${{ secrets.CL_review_api_MONGODB_REPLICASET_KEY }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:8c93778931df
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache api-node-modules
          id: cache-node-modules
          uses: actions/cache/restore@v4
          with:
            path: |-
              api/node_modules
              api/.yarn/install-state.gz
            key: api-node-modules-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-node-modules-
        - name: Cache api-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache/restore@v4
          with:
            path: api/.yarn
            key: api-yarn-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-yarn-
        - name: 🧪 test
          id: main
          run: bash .catladder-generated/github/scripts/api-test-review.sh
          shell: bash
    api-app-review:
      name: api 🔨 app | review
      runs-on: ubuntu-latest
      needs:
        - catladder-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:8c93778931df
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review
      env:
        CL_review_api_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_review_api_MONGODB_ROOT_PASSWORD }}
        CL_review_api_MONGODB_REPLICASET_KEY: \${{ secrets.CL_review_api_MONGODB_REPLICASET_KEY }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:8c93778931df
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache api-node-modules
          id: cache-node-modules
          uses: actions/cache@v4
          with:
            path: |-
              api/node_modules
              api/.yarn/install-state.gz
            key: api-node-modules-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-node-modules-
        - name: Cache api-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache@v4
          with:
            path: api/.yarn
            key: api-yarn-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-yarn-
        - name: 🔨 app
          id: main
          run: bash .catladder-generated/github/scripts/api-app-review.sh
          shell: bash
        - name: Upload artifacts
          uses: actions/upload-artifact@v4
          with:
            name: api-app-review
            path: |-
              api/__build_info.json
              api/.next
              api/dist
            if-no-files-found: warn
            include-hidden-files: true
    api-docker-review:
      name: api 🔨 docker | review
      runs-on: ubuntu-latest
      needs:
        - api-app-review
        - catladder-image-docker-build
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review
      env:
        DOCKER_BUILDKIT: '1'
        CL_review_api_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_review_api_MONGODB_ROOT_PASSWORD }}
        CL_review_api_MONGODB_REPLICASET_KEY: \${{ secrets.CL_review_api_MONGODB_REPLICASET_KEY }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/docker-build:b343b099980e
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache api-yarn
          uses: actions/cache/restore@v4
          with:
            path: api/.yarn
            key: api-yarn-\${{ hashFiles('api/yarn.lock') }}
            restore-keys: api-yarn-
        - name: Download artifacts from api-app-review
          uses: actions/download-artifact@v4
          with:
            name: api-app-review
        - name: 🔨 docker
          id: main
          run: bash .catladder-generated/github/scripts/api-docker-review.sh
          shell: bash
    api-deploy-review:
      name: api 🚀 Deploy | review
      runs-on: ubuntu-latest
      needs:
        - api-app-review
        - api-audit-review
        - api-docker-review
        - api-lint-review
        - api-test-review
        - catladder-image-kubernetes
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/kubernetes:e5e779a652a4
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review-api
        url: \${{ steps.main.outputs.url }}
      env:
        CL_review_api_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_review_api_MONGODB_ROOT_PASSWORD }}
        CL_review_api_MONGODB_REPLICASET_KEY: \${{ secrets.CL_review_api_MONGODB_REPLICASET_KEY }}
        CL_review_api_KUBE_URL: \${{ secrets.CL_review_api_KUBE_URL }}
        CL_review_api_KUBE_CA_PEM: \${{ secrets.CL_review_api_KUBE_CA_PEM }}
        CL_review_api_KUBE_TOKEN: \${{ secrets.CL_review_api_KUBE_TOKEN }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/kubernetes:e5e779a652a4
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🚀 Deploy
          id: main
          run: bash .catladder-generated/github/scripts/api-deploy-review.sh
          shell: bash
