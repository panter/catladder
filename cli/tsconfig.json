{
  "compilerOptions": {
    "lib": ["es2021", "DOM"],
    "module": "CommonJS",

    "declaration": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "dist",
    "strict": false,
    "incremental": true,
    "resolveJsonModule": true
  },
  "include": ["./src/**/*"]
}
