#!/bin/bash
ncc build dist/cli/src/catenv.js -o dist/bundles/catenv $( ((SHOULD_MINIFY == 1)) && printf %s '-m')

ncc build dist/cli/src/cli.js -o dist/bundles/cli $( ((SHOULD_MINIFY == 1)) && printf %s '-m')

# catci: minimal CI companion, materialized into .catladder-generated by
# pipeline generation (always minified — it is committed to consumer repos)
ncc build dist/cli/src/catci.js -o dist/bundles/catci -m --no-source-map-register
