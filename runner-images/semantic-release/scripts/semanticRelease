#!/bin/bash
set -e

# 0. check and evalaute security audit or create MR with security audit template (and exit 1)
# 1. create "@semantic-release/changelog"
# 2. commit it to git (and push)
# 3. optional: update package.json

# better branches settings: https://github.com/semantic-release/semantic-release/issues/1581

if [ "$GITHUB_ACTIONS" = "true" ]; then
  # github container jobs: the workspace volume is owned by the host
  # runner user while this step runs as the container user, and the
  # safe.directory entry actions/checkout writes goes to a temporary
  # HOME that is gone by now — git would refuse the repo ("dubious
  # ownership", surfacing as ENOGITREPO from semantic-release)
  git config --global --add safe.directory "$(pwd)"
fi

echo "doing security audit check"
CATCI=".catladder-generated/catci/index.js"
if [ -f "$CATCI" ]; then
  # catci is materialized by pipeline generation — always the exact
  # catladder version that generated this pipeline
  if [ "$GITHUB_ACTIONS" = "true" ]; then
    # github: gate only — the MR remediation is gitlab-specific
    node "$CATCI" security-audit check ./
  else
    node "$CATCI" security-audit ci-job ./ "$GL_TOKEN" "$CI_DEFAULT_BRANCH" "$CI_PROJECT_ID" "$GITLAB_USER_ID"
  fi
elif command -v catladder > /dev/null 2>&1; then
  # repos generated by old catladder versions (no materialized catci):
  # the central image still bakes the cli in
  catladder security audit ci-job ./ "$GL_TOKEN" "$CI_DEFAULT_BRANCH" "$CI_PROJECT_ID" "$GITLAB_USER_ID"
else
  echo "neither $CATCI nor the catladder cli found — regenerate the pipeline with a current catladder version (catenv)"
  exit 1
fi

echo "doing semantic release"

if [ "$GITHUB_ACTIONS" = "true" ]; then
  # the github counterpart of the gitlab plugin below: it creates the
  # entry on the releases page with the generated notes. Everything
  # beyond that is switched off on purpose — commenting on the
  # pull requests/issues of a release and labelling them would need
  # `issues: write` / `pull-requests: write` on the release job, which
  # only exists to release.
  PUBLISH_PLUGIN=',
    ["@semantic-release/github", {
      "successComment": false,
      "failComment": false,
      "failTitle": false,
      "labels": false,
      "releasedLabels": false
    }]'
else
  # no gitlabUrl: the plugin derives it from the CI-provided variables
  # of the running instance. It used to be hardcoded to panter's gitlab,
  # which broke the release on every other instance.
  PUBLISH_PLUGIN=',
    "@semantic-release/gitlab"'
fi

if [ ! -e .releaserc ]; then
  cat >.releaserc <<EOF
{
  "plugins": [
      [
      "@semantic-release/commit-analyzer",
      {
        preset: "angular",
        releaseRules: [
          { breaking: true, release: "major" },
          { revert: true, release: "patch" },

          { type: "feat", release: "minor" },
          { type: "docs", release: "patch" },
          { type: "fix", release: "patch" },
          { type: "perf", release: "patch" },
          # always fall back to a patch release
          {
            header: "**",
            release: "patch",
          },
        ],
      },
    ],
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    # message prefix hardcoded to "release" on purpose. Ideally this would be
    # "chore(\${branch.type})", but upstream @semantic-release/git passes the
    # branch *name* (not the object) into the template, so \${branch.type} is
    # never available (see https://github.com/semantic-release/git/pull/213,
    # open/ignored since 2020 — the README documents branch.type but the code
    # never wired it up; the old panter fork existed only to patch this). On the
    # default branch branch.type is always "release", and the pipeline
    # loop-prevention rule keys on the literal "chore(release)" prefix, so keep
    # this literal. Don't "fix" it back to \${branch.type}.
    ["@semantic-release/git", {
      "message": "chore(release): \${nextRelease.version}\n\n\${nextRelease.notes}"
    }]${PUBLISH_PLUGIN}
    ],
  "branches": [
    "+([0-9])?(.{+([0-9]),x}).x",
    "master",
    "main",
    "next",
    "next-major",
    {
      "name": "beta",
      "prerelease": true
    },
    {
      "name": "alpha",
      "prerelease": true
    }
  ],
}
EOF
fi

if [ "$GITHUB_ACTIONS" = "true" ]; then
  TAGS_BEFORE=$(git tag --list 'v[0-9]*')
fi

semantic-release

# tags pushed with the default GITHUB_TOKEN don't trigger `on: push:
# tags` workflows (github's recursion guard) — dispatch the
# taggedRelease workflow explicitly for a tag semantic-release created
if [ "$GITHUB_ACTIONS" = "true" ] && [ -f "$CATCI" ]; then
  if [ -z "$TAGS_BEFORE" ]; then
    NEW_TAG=$(git tag --list 'v[0-9]*' | tail -n1)
  else
    NEW_TAG=$(git tag --list 'v[0-9]*' | grep -Fxv -f <(printf '%s\n' "$TAGS_BEFORE") | tail -n1 || true)
  fi
  if [ -n "$NEW_TAG" ]; then
    node "$CATCI" release dispatch-tagged-workflow "$NEW_TAG"
  else
    echo "no new release tag created — skipping taggedRelease dispatch"
  fi
fi
