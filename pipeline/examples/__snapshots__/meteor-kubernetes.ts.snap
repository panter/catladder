          "kubectl config use-context "kube-pan-my-app-stage-web"",
          "kubernetesRollback",
        ],
        "stage": "rollback stage",
        "variables": {
          "APP_DIR": "app",
          "BUILD_ID": "some-id",
          "BUILD_INFO_BUILD_TIME": "01-01-2023 12:13:14",
          "BUILD_INFO_CURRENT_VERSION": "3.2.1",
