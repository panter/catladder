// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`matches snapshot 1`] = `
{
  "mainBranch": {
    "image": "path/to/docker/jobs-default:the-version",
    "jobs": {
      "web ↩️ Rollback ⚠️ | dev ": {
        "environment": {
          "action": "access",
          "name": "dev/web",
          "url": "https://web.dev.my-app.pan.panter.cloud",
        },
        "image": "path/to/docker/kubernetes:the-version",
        "interruptible": true,
        "needs": [],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "rules": [
          {
            "allow_failure": true,
            "when": "manual",
          },
        ],
        "script": [
          "kubectl config set-cluster "kube-pan-my-app-dev-web" --server="$CL_dev_web_KUBE_URL" --certificate-authority <(echo $CL_dev_web_KUBE_CA_PEM | base64 -d) --embed-certs=true",
          "kubectl config set-credentials "kube-pan-my-app-dev-web" --token="$CL_dev_web_KUBE_TOKEN"",
          "kubectl config set-context "kube-pan-my-app-dev-web" --cluster="kube-pan-my-app-dev-web" --user="kube-pan-my-app-dev-web" --namespace="pan-my-app-dev"",
          "kubectl config use-context "kube-pan-my-app-dev-web"",
          "kubernetesRollback",
        ],
        "stage": "rollback dev",
        "variables": {
          "APP_DIR": "app",
          "BUILD_ID": "some-id",
          "BUILD_INFO_BUILD_TIME": "01-01-2023 12:13:14",
          "BUILD_INFO_CURRENT_VERSION": "3.2.1",
          "BUILD_INFO_ID": "some-id",
          "COMPONENT_NAME": "web",
          "ENV_SHORT": "dev",
          "ENV_TYPE": "dev",
          "GIT_STRATEGY": "none",
          "HELM_ARGS": "",
          "HELM_EXPERIMENTAL_OCI": "1",
          "HELM_GITLAB_CHART_NAME": "/helm-charts/the-panter-chart",
          "HOST": "web.dev.my-app.pan.panter.cloud",
          "HOST_CANONICAL": "web.dev.my-app.pan.panter.cloud",
          "HOST_INTERNAL": "web.dev.my-app.pan.panter.cloud",
          "KUBERNETES_CPU_LIMIT": "1",
          "KUBERNETES_CPU_REQUEST": "0.5",
          "KUBERNETES_MEMORY_LIMIT": "400Mi",
          "KUBERNETES_MEMORY_REQUEST": "200Mi",
          "KUBE_APP_NAME": "web",
          "KUBE_APP_NAME_PREFIX": "",
          "KUBE_DOCKER_IMAGE_PULL_SECRET": "gitlab-registry-web",
          "KUBE_NAMESPACE": "pan-my-app-dev",
          "KUBE_VALUES": "env:
  secret:
    MONGODB_ROOT_PASSWORD: '$CL_dev_web_MONGODB_ROOT_PASSWORD'
    MONGO_URL: 'mongodb://root:$CL_dev_web_MONGODB_ROOT_PASSWORD@web-mongodb.pan-my-app-dev.svc.cluster.local:27017/app?authSource=admin'
  public:
    ENV_SHORT: 'dev'
    APP_DIR: 'app'
    ENV_TYPE: 'dev'
    BUILD_INFO_ID: 'some-id'
    BUILD_INFO_BUILD_TIME: '01-01-2023 12:13:14'
    BUILD_INFO_CURRENT_VERSION: '3.2.1'
    HOST: 'web.dev.my-app.pan.panter.cloud'
    ROOT_URL: 'https://web.dev.my-app.pan.panter.cloud'
    HOST_CANONICAL: 'web.dev.my-app.pan.panter.cloud'
    ROOT_URL_INTERNAL: 'https://web.dev.my-app.pan.panter.cloud'
    KUBE_NAMESPACE: 'pan-my-app-dev'
    KUBE_APP_NAME: 'web'
    KUBE_APP_NAME_PREFIX: ''
    HOST_INTERNAL: 'web.dev.my-app.pan.panter.cloud'
    _ALL_ENV_VAR_KEYS: '["ENV_SHORT","APP_DIR","ENV_TYPE","BUILD_INFO_ID","BUILD_INFO_BUILD_TIME","BUILD_INFO_CURRENT_VERSION","HOST","ROOT_URL","HOST_CANONICAL","ROOT_URL_INTERNAL","KUBE_NAMESPACE","KUBE_APP_NAME","KUBE_APP_NAME_PREFIX","HOST_INTERNAL","MONGODB_ROOT_PASSWORD"]'
application:
  host: 'web.dev.my-app.pan.panter.cloud'
  command: 'node main.js'
  livenessProbe:
    httpGet:
      path: '__health'
  readinessProbe:
    httpGet:
      path: '__health'
  startupProbe:
    httpGet:
      path: '__health'
  worker:
    enabled: true
mongodb:
  enabled: true
  auth:
    enabled: true
    rootPassword: '$CL_dev_web_MONGODB_ROOT_PASSWORD'
    replicaSetKey: '$CL_dev_web_MONGODB_REPLICASET_KEY'
  persistence:
    storageClass: 'standard-rwo'
  backup:
    enabled: false
    hostToBackup: 'web-mongodb.pan-my-app-dev.svc.cluster.local:27017'
    pvcToBackup: 'web-mongodb'
    image: 'mrelite/kubectlmongoshell:v1.0'
    schedule: '0 4 * * *'
    volumeSnapshotClass: 'snapshotclass'
  architecture: 'standalone'
",
          "MONGODB_ROOT_PASSWORD": "$CL_dev_web_MONGODB_ROOT_PASSWORD",
          "RELEASE_NAME": "pan-my-app-dev-web",
          "ROOT_URL": "https://web.dev.my-app.pan.panter.cloud",
          "ROOT_URL_INTERNAL": "https://web.dev.my-app.pan.panter.cloud",
          "_ALL_ENV_VAR_KEYS": "["ENV_SHORT","APP_DIR","ENV_TYPE","BUILD_INFO_ID","BUILD_INFO_BUILD_TIME","BUILD_INFO_CURRENT_VERSION","HOST","ROOT_URL","HOST_CANONICAL","ROOT_URL_INTERNAL","KUBE_NAMESPACE","KUBE_APP_NAME","KUBE_APP_NAME_PREFIX","HOST_INTERNAL","MONGODB_ROOT_PASSWORD"]",
        },
      },
      "web 👮 lint": {
        "cache": [
          {
            "key": "app-yarn",
            "paths": [
              "app/.yarn",
            ],
            "policy": "pull-push",
          },
          {
            "key": "app-node-modules",
            "paths": [
              "app/node_modules",
            ],
            "policy": "pull-push",
          },
        ],
        "image": "path/to/docker/jobs-default:the-version",
        "interruptible": true,
        "needs": [],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "script": [
          "cd app",
          "echo -e "\\e[0Ksection_start:$(date +%s):yarn prepare[collapsed=true]\\r\\e[0KNode and yarn install"",
          "echo -e "\\e[0Ksection_start:$(date +%s):node install[collapsed=true]\\r\\e[0KEnsure node version"",
          "if [ -f ~/.nvm/nvm.sh ];  then source ~/.nvm/nvm.sh; fi",
          "if command -v nvm &> /dev/null && [ -f ./.nvmrc ]; then nvm install; fi",
          "echo -e "\\e[0Ksection_end:$(date +%s):node install\\r\\e[0K"",
          "yarn install --immutable",
          "echo -e "\\e[0Ksection_end:$(date +%s):yarn prepare\\r\\e[0K"",
          "yarn lint",
        ],
        "stage": "test",
        "variables": {
          "APP_PATH": "app",
          "KUBERNETES_CPU_LIMIT": "2",
          "KUBERNETES_CPU_REQUEST": "0.5",
          "KUBERNETES_MEMORY_LIMIT": "4Gi",
          "KUBERNETES_MEMORY_REQUEST": "2Gi",
        },
      },
      "web 🔨 app | dev ": {
        "artifacts": {
          "paths": [
            "app/__build_info.json",
            "app/dist",
          ],
          "reports": {
            "junit": undefined,
          },
        },
        "cache": [
          {
            "key": "app-yarn",
            "paths": [
              "app/.yarn",
            ],
            "policy": "pull-push",
          },
          {
            "key": "app-node-modules",
            "paths": [
              "app/node_modules",
            ],
            "policy": "pull-push",
          },
          {
            "key": "webmeteor-build-cache",
            "paths": [
              "app/.meteor/local/resolver-result-cache.json",
              "app/.meteor/local/plugin-cache",
              "app/.meteor/local/isopacks",
              "app/.meteor/local/bundler-cache/scanner",
            ],
            "policy": "pull-push",
          },
        ],
        "image": "path/to/docker/jobs-meteor:the-version",
        "interruptible": true,
        "needs": [],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "script": [
          "echo '{"id":"some-id","time":"01-01-2023 12:13:14"}' > app/__build_info.json",
          "echo -e "\\e[0Ksection_start:$(date +%s):node install[collapsed=true]\\r\\e[0KEnsure node version"",
          "if [ -f ~/.nvm/nvm.sh ];  then source ~/.nvm/nvm.sh; fi",
          "if command -v nvm &> /dev/null && [ -f ./.nvmrc ]; then nvm install; fi",
          "echo -e "\\e[0Ksection_end:$(date +%s):node install\\r\\e[0K"",
          "cd app",
          "echo -e "\\e[0Ksection_start:$(date +%s):yarn prepare[collapsed=true]\\r\\e[0KNode and yarn install"",
          "echo -e "\\e[0Ksection_start:$(date +%s):node install[collapsed=true]\\r\\e[0KEnsure node version"",
          "if [ -f ~/.nvm/nvm.sh ];  then source ~/.nvm/nvm.sh; fi",
          "if command -v nvm &> /dev/null && [ -f ./.nvmrc ]; then nvm install; fi",
          "echo -e "\\e[0Ksection_end:$(date +%s):node install\\r\\e[0K"",
          "yarn install --immutable",
          "echo -e "\\e[0Ksection_end:$(date +%s):yarn prepare\\r\\e[0K"",
          "echo "add healthcheck package"",
          "meteor add panter:healthroute --allow-superuser",
          "meteor add qualia:prod-shell --allow-superuser",
          "TOOL_NODE_FLAGS="--max_old_space_size=3584 --min_semi_space_size=8 --max_semi_space_size=256 --optimize_for_size" meteor build ./dist --architecture os.linux.x86_64 --allow-superuser --server-only --directory",
          "cp ./__build_info.json ./dist/bundle/programs/server",
        ],
        "stage": "build",
        "variables": {
          "APP_DIR": "app",
          "BUILD_INFO_BUILD_TIME": "01-01-2023 12:13:14",
          "BUILD_INFO_CURRENT_VERSION": "3.2.1",
          "BUILD_INFO_ID": "some-id",
          "ENV_SHORT": "dev",
          "ENV_TYPE": "dev",
          "HOST": "web.dev.my-app.pan.panter.cloud",
          "HOST_CANONICAL": "web.dev.my-app.pan.panter.cloud",
          "HOST_INTERNAL": "web.dev.my-app.pan.panter.cloud",
          "KUBERNETES_CPU_LIMIT": "2",
          "KUBERNETES_CPU_REQUEST": "0.5",
          "KUBERNETES_MEMORY_LIMIT": "4Gi",
          "KUBERNETES_MEMORY_REQUEST": "1Gi",
          "KUBE_APP_NAME": "web",
          "KUBE_APP_NAME_PREFIX": "",
          "KUBE_NAMESPACE": "pan-my-app-dev",
          "METEOR_DISABLE_OPTIMISTIC_CACHING": "1",
          "MONGODB_ROOT_PASSWORD": "$CL_dev_web_MONGODB_ROOT_PASSWORD",
          "ROOT_URL": "https://web.dev.my-app.pan.panter.cloud",
          "ROOT_URL_INTERNAL": "https://web.dev.my-app.pan.panter.cloud",
          "_ALL_ENV_VAR_KEYS": "["ENV_SHORT","APP_DIR","ENV_TYPE","BUILD_INFO_ID","BUILD_INFO_BUILD_TIME","BUILD_INFO_CURRENT_VERSION","HOST","ROOT_URL","HOST_CANONICAL","ROOT_URL_INTERNAL","KUBE_NAMESPACE","KUBE_APP_NAME","KUBE_APP_NAME_PREFIX","HOST_INTERNAL","MONGODB_ROOT_PASSWORD"]",
        },
      },
      "web 🔨 docker | dev ": {
        "image": "path/to/docker/docker-build:the-version",
        "interruptible": true,
        "needs": [
          "web 🔨 app | dev ",
        ],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "script": [
          "ensureMeteorDockerfile",
          "echo -e "\\e[0Ksection_start:$(date +%s):docker-login[collapsed=true]\\r\\e[0KDocker Login"",
          "docker login --username gitlab-ci-token --password $CI_JOB_TOKEN $CI_REGISTRY",
          "echo -e "\\e[0Ksection_end:$(date +%s):docker-login\\r\\e[0K"",
          "echo -e "\\e[0Ksection_start:$(date +%s):docker-build[collapsed=true]\\r\\e[0KDocker build"",
          "docker build --network host --cache-from $DOCKER_CACHE_IMAGE --tag $DOCKER_IMAGE:$DOCKER_IMAGE_TAG -f $APP_DIR/Dockerfile . --build-arg BUILDKIT_INLINE_CACHE=1",
          "echo -e "\\e[0Ksection_end:$(date +%s):docker-build\\r\\e[0K"",
          "echo -e "\\e[0Ksection_start:$(date +%s):docker-push[collapsed=true]\\r\\e[0KDocker push and tag"",
          "docker push $DOCKER_IMAGE:$DOCKER_IMAGE_TAG",
          "docker tag $DOCKER_IMAGE:$DOCKER_IMAGE_TAG $DOCKER_CACHE_IMAGE",
          "docker push $DOCKER_CACHE_IMAGE",
          "echo -e "\\e[0Ksection_end:$(date +%s):docker-push\\r\\e[0K"",
        ],
        "services": [
          {
            "command": [
              "--tls=false",
            ],
            "name": "docker:24.0.6-dind",
          },
        ],
        "stage": "build",
        "variables": {
          "APP_DIR": "app",
          "DOCKERFILE_ADDITIONS": undefined,
          "DOCKERFILE_ADDITIONS_END": undefined,
          "DOCKER_BUILDKIT": "1",
          "DOCKER_CACHE_IMAGE": "$CI_REGISTRY_IMAGE/caches/web",
          "DOCKER_DIR": ".",
          "DOCKER_DRIVER": "overlay2",
          "DOCKER_HOST": "tcp://0.0.0.0:2375",
          "DOCKER_IMAGE": "$CI_REGISTRY_IMAGE/$DOCKER_IMAGE_NAME",
          "DOCKER_IMAGE_NAME": "dev/web",
          "DOCKER_IMAGE_TAG": "$CI_COMMIT_SHA",
          "DOCKER_REGISTRY": "$CI_REGISTRY",
          "DOCKER_TLS_CERTDIR": "",
          "KUBERNETES_CPU_LIMIT": "1",
          "KUBERNETES_CPU_REQUEST": "0.5",
          "KUBERNETES_MEMORY_LIMIT": "2Gi",
          "KUBERNETES_MEMORY_REQUEST": "1Gi",
          "METEOR_INSTALL_SCRIPTS": "",
        },
      },
      "web 🚀 Deploy | dev ": {
        "allow_failure": false,
        "environment": {
          "auto_stop_in": "4 weeks",
          "name": "dev/web",
          "on_stop": "web 🛑 Stop ⚠️ | dev ",
          "url": "https://web.dev.my-app.pan.panter.cloud",
        },
        "image": "path/to/docker/kubernetes:the-version",
        "interruptible": true,
        "needs": [
          {
            "artifacts": false,
            "job": "web 👮 lint",
          },
          {
            "artifacts": false,
            "job": "web 🔨 app | dev ",
          },
          {
            "artifacts": false,
            "job": "web 🔨 docker | dev ",
          },
          {
            "artifacts": false,
            "job": "web 🧪 test",
          },
          {
            "artifacts": true,
            "job": "web 🧾 sbom | dev ",
          },
          {
            "artifacts": false,
            "job": "web 🛡 audit",
          },
        ],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "rules": [
          {
            "when": "on_success",
          },
        ],
        "script": [
          "kubectl config set-cluster "kube-pan-my-app-dev-web" --server="$CL_dev_web_KUBE_URL" --certificate-authority <(echo $CL_dev_web_KUBE_CA_PEM | base64 -d) --embed-certs=true",
          "kubectl config set-credentials "kube-pan-my-app-dev-web" --token="$CL_dev_web_KUBE_TOKEN"",
          "kubectl config set-context "kube-pan-my-app-dev-web" --cluster="kube-pan-my-app-dev-web" --user="kube-pan-my-app-dev-web" --namespace="pan-my-app-dev"",
          "kubectl config use-context "kube-pan-my-app-dev-web"",
          "kubernetesCreateSecret",
          "kubernetesDeploy",
          "echo Uploading SBOM to Dependency Track",
          "/dtrackuploader https://dep.panter.swiss/ "$DT_KEY_PROD" upload "pan-my-app/web" "https://web.dev.my-app.pan.panter.cloud" "__sbom.json" vex.json || true",
          "echo deployment successful 😻",
        ],
        "stage": "deploy dev",
        "variables": {
          "APP_DIR": "app",
          "BUILD_ID": "some-id",
          "BUILD_INFO_BUILD_TIME": "01-01-2023 12:13:14",
          "BUILD_INFO_CURRENT_VERSION": "3.2.1",
          "BUILD_INFO_ID": "some-id",
          "COMPONENT_NAME": "web",
          "DOCKER_CACHE_IMAGE": "$CI_REGISTRY_IMAGE/caches/web",
          "DOCKER_IMAGE": "$CI_REGISTRY_IMAGE/$DOCKER_IMAGE_NAME",
          "DOCKER_IMAGE_NAME": "dev/web",
          "DOCKER_IMAGE_TAG": "$CI_COMMIT_SHA",
          "DOCKER_REGISTRY": "$CI_REGISTRY",
          "ENV_SHORT": "dev",
          "ENV_TYPE": "dev",
          "HELM_ARGS": "",
          "HELM_EXPERIMENTAL_OCI": "1",
          "HELM_GITLAB_CHART_NAME": "/helm-charts/the-panter-chart",
          "HOST": "web.dev.my-app.pan.panter.cloud",
          "HOST_CANONICAL": "web.dev.my-app.pan.panter.cloud",
          "HOST_INTERNAL": "web.dev.my-app.pan.panter.cloud",
          "KUBERNETES_CPU_LIMIT": "1",
          "KUBERNETES_CPU_REQUEST": "0.5",
          "KUBERNETES_MEMORY_LIMIT": "400Mi",
          "KUBERNETES_MEMORY_REQUEST": "200Mi",
          "KUBE_APP_NAME": "web",
          "KUBE_APP_NAME_PREFIX": "",
          "KUBE_DOCKER_IMAGE_PULL_SECRET": "gitlab-registry-web",
          "KUBE_NAMESPACE": "pan-my-app-dev",
          "KUBE_VALUES": "env:
  secret:
    MONGODB_ROOT_PASSWORD: '$CL_dev_web_MONGODB_ROOT_PASSWORD'
    MONGO_URL: 'mongodb://root:$CL_dev_web_MONGODB_ROOT_PASSWORD@web-mongodb.pan-my-app-dev.svc.cluster.local:27017/app?authSource=admin'
  public:
    ENV_SHORT: 'dev'
    APP_DIR: 'app'
    ENV_TYPE: 'dev'
    BUILD_INFO_ID: 'some-id'
    BUILD_INFO_BUILD_TIME: '01-01-2023 12:13:14'
    BUILD_INFO_CURRENT_VERSION: '3.2.1'
    HOST: 'web.dev.my-app.pan.panter.cloud'
    ROOT_URL: 'https://web.dev.my-app.pan.panter.cloud'
    HOST_CANONICAL: 'web.dev.my-app.pan.panter.cloud'
    ROOT_URL_INTERNAL: 'https://web.dev.my-app.pan.panter.cloud'
    KUBE_NAMESPACE: 'pan-my-app-dev'
    KUBE_APP_NAME: 'web'
    KUBE_APP_NAME_PREFIX: ''
    HOST_INTERNAL: 'web.dev.my-app.pan.panter.cloud'
    _ALL_ENV_VAR_KEYS: '["ENV_SHORT","APP_DIR","ENV_TYPE","BUILD_INFO_ID","BUILD_INFO_BUILD_TIME","BUILD_INFO_CURRENT_VERSION","HOST","ROOT_URL","HOST_CANONICAL","ROOT_URL_INTERNAL","KUBE_NAMESPACE","KUBE_APP_NAME","KUBE_APP_NAME_PREFIX","HOST_INTERNAL","MONGODB_ROOT_PASSWORD"]'
application:
  host: 'web.dev.my-app.pan.panter.cloud'
  command: 'node main.js'
  livenessProbe:
    httpGet:
      path: '__health'
  readinessProbe:
    httpGet:
      path: '__health'
  startupProbe:
    httpGet:
      path: '__health'
  worker:
    enabled: true
mongodb:
  enabled: true
  auth:
    enabled: true
    rootPassword: '$CL_dev_web_MONGODB_ROOT_PASSWORD'
    replicaSetKey: '$CL_dev_web_MONGODB_REPLICASET_KEY'
  persistence:
    storageClass: 'standard-rwo'
  backup:
    enabled: false
    hostToBackup: 'web-mongodb.pan-my-app-dev.svc.cluster.local:27017'
    pvcToBackup: 'web-mongodb'
    image: 'mrelite/kubectlmongoshell:v1.0'
    schedule: '0 4 * * *'
    volumeSnapshotClass: 'snapshotclass'
  architecture: 'standalone'
",
          "MONGODB_ROOT_PASSWORD": "$CL_dev_web_MONGODB_ROOT_PASSWORD",
          "RELEASE_NAME": "pan-my-app-dev-web",
          "ROOT_URL": "https://web.dev.my-app.pan.panter.cloud",
          "ROOT_URL_INTERNAL": "https://web.dev.my-app.pan.panter.cloud",
          "_ALL_ENV_VAR_KEYS": "["ENV_SHORT","APP_DIR","ENV_TYPE","BUILD_INFO_ID","BUILD_INFO_BUILD_TIME","BUILD_INFO_CURRENT_VERSION","HOST","ROOT_URL","HOST_CANONICAL","ROOT_URL_INTERNAL","KUBE_NAMESPACE","KUBE_APP_NAME","KUBE_APP_NAME_PREFIX","HOST_INTERNAL","MONGODB_ROOT_PASSWORD"]",
        },
      },
      "web 🛑 Stop ⚠️ | dev ": {
        "environment": {
          "action": "stop",
          "name": "dev/web",
          "url": "https://web.dev.my-app.pan.panter.cloud",
        },
        "image": "path/to/docker/kubernetes:the-version",
        "interruptible": true,
        "needs": [],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "rules": [
          {
            "allow_failure": true,
            "if": "$CI_COMMIT_BRANCH =~ /^[0-9]+\\.([0-9]+|x)\\.x$/",
            "when": "on_success",
          },
          {
            "allow_failure": true,
            "when": "manual",
          },
        ],
        "script": [
          "kubectl config set-cluster "kube-pan-my-app-dev-web" --server="$CL_dev_web_KUBE_URL" --certificate-authority <(echo $CL_dev_web_KUBE_CA_PEM | base64 -d) --embed-certs=true",
          "kubectl config set-credentials "kube-pan-my-app-dev-web" --token="$CL_dev_web_KUBE_TOKEN"",
          "kubectl config set-context "kube-pan-my-app-dev-web" --cluster="kube-pan-my-app-dev-web" --user="kube-pan-my-app-dev-web" --namespace="pan-my-app-dev"",
          "kubectl config use-context "kube-pan-my-app-dev-web"",
          "kubernetesDelete",
          "echo Disabling component in Dependency Track",
          "/dtrackuploader https://dep.panter.swiss/ "$DT_KEY_PROD" disable "pan-my-app/web" "https://web.dev.my-app.pan.panter.cloud" || true",
        ],
        "stage": "stop dev",
        "variables": {
          "APP_DIR": "app",
          "BUILD_ID": "some-id",
          "BUILD_INFO_BUILD_TIME": "01-01-2023 12:13:14",
          "BUILD_INFO_CURRENT_VERSION": "3.2.1",
          "BUILD_INFO_ID": "some-id",
          "COMPONENT_NAME": "web",
          "ENV_SHORT": "dev",
          "ENV_TYPE": "dev",
          "GIT_STRATEGY": "none",
          "HELM_ARGS": "",
          "HELM_EXPERIMENTAL_OCI": "1",
          "HELM_GITLAB_CHART_NAME": "/helm-charts/the-panter-chart",
          "HOST": "web.dev.my-app.pan.panter.cloud",
