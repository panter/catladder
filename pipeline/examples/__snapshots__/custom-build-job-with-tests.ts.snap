      "GIT_DEPTH": 1,
    },
    "workflow": {
      "rules": [
        {
          "if": "$CI_COMMIT_TAG",
        },
        {
          "if": "$CI_COMMIT_MESSAGE =~ /^chore\\(release\\).*/",
          "when": "never",
