    web-audit-review:
      name: web 🛡 audit | review
      runs-on: ubuntu-latest
      needs:
        - job-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review
      env:
        CL_review_web_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_review_web_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🛡 audit
          id: main
          run: bash .catladder-generated/github/scripts/web-audit-review.sh
          shell: bash
    web-lint-review:
      name: web 👮 lint | review
      runs-on: ubuntu-latest
      needs:
        - job-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review
      env:
        CL_review_web_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_review_web_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache web-node-modules
          id: cache-node-modules
          uses: actions/cache/restore@v4
          with:
            path: |-
              web/node_modules
              web/.yarn/install-state.gz
            key: web-node-modules-\${{ hashFiles('web/yarn.lock') }}
            restore-keys: web-node-modules-
        - name: Cache web-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache/restore@v4
          with:
            path: web/.yarn
            key: web-yarn-\${{ hashFiles('web/yarn.lock') }}
            restore-keys: web-yarn-
        - name: 👮 lint
          id: main
          run: bash .catladder-generated/github/scripts/web-lint-review.sh
          shell: bash
    web-test-review:
      name: web 🧪 test | review
      runs-on: ubuntu-latest
      needs:
        - job-image-jobs-testing-chrome
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-testing-chrome:c9799d0c3dc3
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review
      env:
        CL_review_web_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_review_web_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-testing-chrome:c9799d0c3dc3
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache web-node-modules
          id: cache-node-modules
          uses: actions/cache/restore@v4
          with:
            path: |-
              web/node_modules
              web/.yarn/install-state.gz
            key: web-node-modules-\${{ hashFiles('web/yarn.lock') }}
            restore-keys: web-node-modules-
        - name: Cache web-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache/restore@v4
          with:
            path: web/.yarn
            key: web-yarn-\${{ hashFiles('web/yarn.lock') }}
            restore-keys: web-yarn-
        - name: 🧪 test
          id: main
          run: bash .catladder-generated/github/scripts/web-test-review.sh
          shell: bash
    web-app-review:
      name: web 🔨 app | review
      runs-on: ubuntu-latest
      needs:
        - job-image-jobs-meteor
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-meteor:66ec3fa9846d
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review
      env:
        CL_review_web_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_review_web_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-meteor:66ec3fa9846d
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache web-node-modules
          id: cache-node-modules
          uses: actions/cache@v4
          with:
            path: |-
              web/node_modules
              web/.yarn/install-state.gz
            key: web-node-modules-\${{ hashFiles('web/yarn.lock') }}
            restore-keys: web-node-modules-
        - name: Cache web-meteor-build-cache
          uses: actions/cache@v4
          with:
            path: |-
              web/.meteor/local/resolver-result-cache.json
              web/.meteor/local/plugin-cache
              web/.meteor/local/isopacks
              web/.meteor/local/bundler-cache/scanner
            key: web-meteor-build-cache-\${{ github.run_id }}
            restore-keys: web-meteor-build-cache-
        - name: Cache web-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache@v4
          with:
            path: web/.yarn
            key: web-yarn-\${{ hashFiles('web/yarn.lock') }}
            restore-keys: web-yarn-
        - name: 🔨 app
          id: main
          run: bash .catladder-generated/github/scripts/web-app-review.sh
          shell: bash
        - name: Upload artifacts
          uses: actions/upload-artifact@v4
          with:
            name: web-app-review
            path: |-
              web/__build_info.json
              web/dist
            if-no-files-found: warn
            include-hidden-files: true
    web-docker-review:
      name: web 🔨 docker | review
      runs-on: ubuntu-latest
      needs:
        - job-image-docker-build
        - web-app-review
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/docker-build:d97f1ac6c3c5
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review
      env:
        DOCKER_BUILDKIT: '1'
        CL_review_web_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_review_web_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/docker-build:d97f1ac6c3c5
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Download artifacts from web-app-review
          uses: actions/download-artifact@v4
          with:
            name: web-app-review
        - name: 🔨 docker
          id: main
          run: bash .catladder-generated/github/scripts/web-docker-review.sh
          shell: bash
    web-deploy-review:
      name: web 🚀 Deploy | review
      runs-on: ubuntu-latest
      needs:
        - web-app-review
        - web-audit-review
        - web-docker-review
        - web-lint-review
        - web-test-review
      container:
        image: google/cloud-sdk:525.0.0
      environment:
        name: review-web
        url: \${{ steps.main.outputs.url }}
      env:
        CL_review_web_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_review_web_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: google/cloud-sdk:525.0.0
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🚀 Deploy
          id: main
          run: bash .catladder-generated/github/scripts/web-deploy-review.sh
          shell: bash
catladder-release.yml:
  name: catladder release
  on:
    push:
      tags:
        - v*
    workflow_dispatch: {}
  permissions:
    contents: read
    packages: write
  env: *a1
  jobs:
    job-image-jobs-default:
      name: 🐳 job image jobs-default
      runs-on: ubuntu-latest
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🐳 job image jobs-default
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "docker-login" "Docker Login"
            docker login --username $CL_REGISTRY_USER --password $CL_JOB_TOKEN $CL_REGISTRY
            collapseable_section_end "docker-login"
            collapseable_section_start "check-image" "Checking if image exists"
            if docker manifest inspect ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b > /dev/null 2>&1; then
              echo "Image ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b already exists, skipping build"
              exit 0
            fi
            collapseable_section_end "check-image"
            collapseable_section_start "docker-build" "Building image"
            DOCKER_BUILDKIT=1 docker build -t ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b -f .catladder-generated/images/jobs-default/Dockerfile .catladder-generated/images
            collapseable_section_end "docker-build"
            collapseable_section_start "docker-push" "Pushing image"
            docker push ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
            collapseable_section_end "docker-push"
          shell: bash
