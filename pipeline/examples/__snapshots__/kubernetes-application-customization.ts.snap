          {
            "artifacts": false,
            "job": "api 🔨 docker | dev ",
          },
          {
            "artifacts": false,
            "job": "api 🧪 test",
          },
          {
            "artifacts": false,
            "job": "api 🛡 audit",
          },
        ],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "rules": [
          {
            "when": "on_success",
