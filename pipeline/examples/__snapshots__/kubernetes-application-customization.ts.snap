          "KUBERNETES_CPU_REQUEST": "0.5",
          "KUBERNETES_MEMORY_LIMIT": "4Gi",
          "KUBERNETES_MEMORY_REQUEST": "2Gi",
        },
      },
      "api 🧪 test": {
        "cache": [
          {
            "key": "api-yarn",
            "paths": [
              "api/.yarn",
            ],
            "policy": "pull-push",
          },
          {
            "key": "api-node-modules",
            "paths": [
              "api/node_modules",
            ],
            "policy": "pull-push",
          },
        ],
        "image": "path/to/docker/jobs-testing-chrome:the-version",
        "interruptible": true,
        "needs": [],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "script": [
          "cd api",
          "if [ -f ~/.nvm/nvm.sh ];  then source ~/.nvm/nvm.sh; fi",
          "if command -v nvm &> /dev/null && [ -f ./.nvmrc ]; then nvm install; fi",
          "yarn install --immutable",
          "yarn test",
        ],
        "stage": "test",
        "variables": {
          "APP_PATH": "api",
          "KUBERNETES_CPU_LIMIT": "2",
          "KUBERNETES_CPU_REQUEST": "0.5",
          "KUBERNETES_MEMORY_LIMIT": "4Gi",
          "KUBERNETES_MEMORY_REQUEST": "2Gi",
        },
      },
      "api 🧾 sbom upload | review ": {
        "allow_failure": true,
        "image": "git.panter.ch:5001/open-source/dependency-track-uploader:dtrackuploader-v0.2.1",
        "interruptible": true,
        "needs": [
          "api 🧾 sbom | review ",
        ],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "script": [
          "/dtrackuploader https://dep.panter.swiss/ "$DT_KEY_PROD" upload "pan-test-app/api" "review" "__sbom.json" vex.json",
        ],
        "stage": "verify",
        "variables": {},
