        "image": "aquasec/trivy:0.38.3",
        "interruptible": true,
        "needs": [
          "api 🚀 Deploy | review ",
        ],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "script": [
          "trivy fs --quiet --format cyclonedx --output "__sbom.json" api",
        ],
        "stage": "verify",
        "variables": {},
      },
