// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`matches snapshot 1`] = `
{
  "mainBranch": {
    "image": "path/to/docker/jobs-default:the-version",
    "jobs": {
      "api ↩️ Rollback ⚠️ | dev ": {
        "environment": {
          "action": "access",
          "kubernetes": {
            "namespace": "pan-test-app-dev",
          },
          "name": "dev/api",
          "url": "https://api.dev.test-app.pan.panter.cloud",
        },
        "image": "path/to/docker/kubernetes:the-version",
        "interruptible": true,
        "needs": [],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "rules": [
          {
            "allow_failure": true,
            "when": "manual",
          },
        ],
        "script": [
          "kubectl config set-cluster "kube-pan-test-app-dev-api" --server="$CL_dev_api_KUBE_URL" --certificate-authority <(echo $CL_dev_api_KUBE_CA_PEM | base64 -d) --embed-certs=true",
          "kubectl config set-credentials "kube-pan-test-app-dev-api" --token="$CL_dev_api_KUBE_TOKEN"",
          "kubectl config set-context "kube-pan-test-app-dev-api" --cluster="kube-pan-test-app-dev-api" --user="kube-pan-test-app-dev-api" --namespace="pan-test-app-dev"",
          "kubectl config use-context "kube-pan-test-app-dev-api"",
          "kubernetesRollback",
        ],
        "stage": "rollback dev",
        "variables": {
          "APP_DIR": "api",
          "BUILD_ID": "some-id",
          "BUILD_INFO_BUILD_TIME": "01-01-2023 12:13:14",
          "BUILD_INFO_CURRENT_VERSION": "3.2.1",
          "BUILD_INFO_ID": "some-id",
          "COMPONENT_NAME": "api",
          "ENV_SHORT": "dev",
          "ENV_TYPE": "dev",
          "GIT_STRATEGY": "none",
          "HELM_ARGS": "",
          "HELM_EXPERIMENTAL_OCI": "1",
          "HELM_GITLAB_CHART_NAME": "/helm-charts/the-panter-chart",
          "HOST": "api.dev.test-app.pan.panter.cloud",
          "HOST_CANONICAL": "api.dev.test-app.pan.panter.cloud",
          "KUBERNETES_CPU_LIMIT": "1",
          "KUBERNETES_CPU_REQUEST": "0.5",
          "KUBERNETES_MEMORY_LIMIT": "400Mi",
          "KUBERNETES_MEMORY_REQUEST": "200Mi",
          "KUBE_APP_NAME": "api",
          "KUBE_APP_NAME_PREFIX": "",
          "KUBE_DOCKER_IMAGE_PULL_SECRET": "gitlab-registry-api",
          "KUBE_NAMESPACE": "pan-test-app-dev",
          "KUBE_VALUES": "env:
  secret: {}
  public:
    ENV_SHORT: 'dev'
    APP_DIR: 'api'
    ENV_TYPE: 'dev'
    BUILD_INFO_ID: 'some-id'
    BUILD_INFO_BUILD_TIME: '01-01-2023 12:13:14'
    BUILD_INFO_CURRENT_VERSION: '3.2.1'
    HOST: 'api.dev.test-app.pan.panter.cloud'
    ROOT_URL: 'https://api.dev.test-app.pan.panter.cloud'
    KUBE_NAMESPACE: 'pan-test-app-dev'
    KUBE_APP_NAME: 'api'
    KUBE_APP_NAME_PREFIX: ''
    HOST_CANONICAL: 'api.dev.test-app.pan.panter.cloud'
    _ALL_ENV_VAR_KEYS: '["ENV_SHORT","APP_DIR","ENV_TYPE","BUILD_INFO_ID","BUILD_INFO_BUILD_TIME","BUILD_INFO_CURRENT_VERSION","HOST","ROOT_URL","KUBE_NAMESPACE","KUBE_APP_NAME","KUBE_APP_NAME_PREFIX","HOST_CANONICAL"]'
application:
  host: 'api.dev.test-app.pan.panter.cloud'
  command: 'node main.js'
  livenessProbe:
    httpGet:
      path: '__health'
  readinessProbe:
    httpGet:
      path: '__health'
  startupProbe:
    httpGet:
      path: '__health'
  autoscale:
    minReplicas: 2
    maxReplicas: 5
    metrics:
      - type: 'Resource'
        resource:
          name: 'cpu'
          target:
            type: 'Utilization'
            averageUtilization: 0.5
  resources:
    limits:
      cpu: '1'
      memory: '2048Mi'
",
          "RELEASE_NAME": "pan-test-app-dev-api",
          "ROOT_URL": "https://api.dev.test-app.pan.panter.cloud",
          "_ALL_ENV_VAR_KEYS": "["ENV_SHORT","APP_DIR","ENV_TYPE","BUILD_INFO_ID","BUILD_INFO_BUILD_TIME","BUILD_INFO_CURRENT_VERSION","HOST","ROOT_URL","KUBE_NAMESPACE","KUBE_APP_NAME","KUBE_APP_NAME_PREFIX","HOST_CANONICAL"]",
        },
      },
      "api 👮 lint": {
        "cache": [
          {
            "key": "api-yarn",
            "paths": [
              "api/.yarn",
            ],
            "policy": "pull-push",
          },
          {
            "key": "api-node-modules",
            "paths": [
              "api/node_modules",
            ],
            "policy": "pull-push",
          },
        ],
        "image": "path/to/docker/jobs-default:the-version",
        "interruptible": true,
        "needs": [],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "script": [
          "cd api",
          "if [ -f ~/.nvm/nvm.sh ];  then source ~/.nvm/nvm.sh; fi",
          "if command -v nvm &> /dev/null && [ -f ./.nvmrc ]; then nvm install; fi",
          "yarn install --immutable",
          "yarn lint",
        ],
        "stage": "test",
        "variables": {
          "APP_PATH": "api",
          "KUBERNETES_CPU_LIMIT": "2",
          "KUBERNETES_CPU_REQUEST": "0.5",
          "KUBERNETES_MEMORY_LIMIT": "4Gi",
          "KUBERNETES_MEMORY_REQUEST": "2Gi",
        },
      },
      "api 🔨 app | dev ": {
        "artifacts": {
          "expire_in": "1 day",
          "paths": [
            "api/__build_info.json",
            "api/dist",
            "api/.next",
          ],
          "reports": {
            "junit": undefined,
          },
        },
        "cache": [
          {
            "key": "api-yarn",
            "paths": [
              "api/.yarn",
            ],
            "policy": "pull-push",
          },
          {
            "key": "api-node-modules",
            "paths": [
              "api/node_modules",
            ],
            "policy": "pull-push",
          },
          {
            "key": "api-next-cache",
            "paths": [
              "api/.next/cache/",
            ],
            "policy": "pull-push",
          },
        ],
        "image": "path/to/docker/jobs-default:the-version",
        "interruptible": true,
        "needs": [],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "script": [
          "echo '{"id":"some-id","time":"01-01-2023 12:13:14"}' > api/__build_info.json",
          "if [ -f ~/.nvm/nvm.sh ];  then source ~/.nvm/nvm.sh; fi",
          "if command -v nvm &> /dev/null && [ -f ./.nvmrc ]; then nvm install; fi",
          "cd api",
          "if [ -f ~/.nvm/nvm.sh ];  then source ~/.nvm/nvm.sh; fi",
          "if command -v nvm &> /dev/null && [ -f ./.nvmrc ]; then nvm install; fi",
          "yarn install --immutable",
          "yarn build",
        ],
        "stage": "build",
        "variables": {
          "APP_DIR": "api",
          "BUILD_INFO_BUILD_TIME": "01-01-2023 12:13:14",
          "BUILD_INFO_CURRENT_VERSION": "3.2.1",
          "BUILD_INFO_ID": "some-id",
          "ENV_SHORT": "dev",
          "ENV_TYPE": "dev",
          "HOST": "api.dev.test-app.pan.panter.cloud",
          "HOST_CANONICAL": "api.dev.test-app.pan.panter.cloud",
          "KUBERNETES_CPU_LIMIT": "2",
          "KUBERNETES_CPU_REQUEST": "0.5",
          "KUBERNETES_MEMORY_LIMIT": "4Gi",
          "KUBERNETES_MEMORY_REQUEST": "2Gi",
          "KUBE_APP_NAME": "api",
          "KUBE_APP_NAME_PREFIX": "",
          "KUBE_NAMESPACE": "pan-test-app-dev",
          "ROOT_URL": "https://api.dev.test-app.pan.panter.cloud",
          "_ALL_ENV_VAR_KEYS": "["ENV_SHORT","APP_DIR","ENV_TYPE","BUILD_INFO_ID","BUILD_INFO_BUILD_TIME","BUILD_INFO_CURRENT_VERSION","HOST","ROOT_URL","KUBE_NAMESPACE","KUBE_APP_NAME","KUBE_APP_NAME_PREFIX","HOST_CANONICAL"]",
        },
      },
      "api 🔨 docker | dev ": {
        "cache": [
          {
            "key": "api-yarn",
            "paths": [
              "api/.yarn",
            ],
            "policy": "pull",
          },
        ],
        "image": "path/to/docker/docker-build:the-version",
        "interruptible": true,
        "needs": [
          "api 🔨 app | dev ",
        ],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "script": [
          "ensureNodeDockerfile",
          "docker login --username gitlab-ci-token --password $CI_JOB_TOKEN $CI_REGISTRY",
          "docker version",
          "docker build --network host --cache-from $DOCKER_CACHE_IMAGE --tag $DOCKER_IMAGE:$DOCKER_IMAGE_TAG -f $APP_DIR/Dockerfile . --build-arg BUILDKIT_INLINE_CACHE=1",
          "docker push $DOCKER_IMAGE:$DOCKER_IMAGE_TAG",
          "docker tag $DOCKER_IMAGE:$DOCKER_IMAGE_TAG $DOCKER_CACHE_IMAGE",
          "docker push $DOCKER_CACHE_IMAGE",
        ],
        "services": [
          {
            "command": [
              "--tls=false",
            ],
            "name": "docker:20-dind",
          },
        ],
        "stage": "build",
        "variables": {
          "APP_DIR": "api",
          "DOCKERFILE_ADDITIONS": undefined,
          "DOCKERFILE_ADDITIONS_END": undefined,
          "DOCKER_BUILDKIT": "1",
          "DOCKER_CACHE_IMAGE": "$DOCKER_REGISTRY_IMAGE_PATH/caches/api",
          "DOCKER_COPY_AND_INSTALL_APP": "COPY --chown=node:node $APP_DIR .
RUN yarn plugin import workspace-tools
RUN yarn workspaces focus --production && yarn rebuild",
          "DOCKER_COPY_WORKSPACE_FILES": "COPY --chown=node:node api/package.json /app/api/package.json
COPY --chown=node:node api/yarn.lock /app/api/yarn.lock
COPY --chown=node:node .yarnrc.yml /app/.yarnrc.yml
COPY --chown=node:node .yarn /app/.yarn",
          "DOCKER_DIR": ".",
          "DOCKER_DRIVER": "overlay2",
          "DOCKER_HOST": "tcp://0.0.0.0:2375",
          "DOCKER_IMAGE": "$DOCKER_REGISTRY_IMAGE_PATH/$DOCKER_IMAGE_NAME",
          "DOCKER_IMAGE_NAME": "dev/api",
          "DOCKER_IMAGE_TAG": "$CI_COMMIT_SHA",
          "DOCKER_REGISTRY": "$CI_REGISTRY",
          "DOCKER_REGISTRY_IMAGE_PATH": "$CI_REGISTRY_IMAGE",
          "DOCKER_TLS_CERTDIR": "",
          "KUBERNETES_CPU_LIMIT": "1",
          "KUBERNETES_CPU_REQUEST": "0.5",
          "KUBERNETES_MEMORY_LIMIT": "2Gi",
          "KUBERNETES_MEMORY_REQUEST": "1Gi",
        },
      },
      "api 🚀 Deploy | dev ": {
        "allow_failure": false,
        "environment": {
          "auto_stop_in": "4 weeks",
          "kubernetes": {
            "namespace": "pan-test-app-dev",
