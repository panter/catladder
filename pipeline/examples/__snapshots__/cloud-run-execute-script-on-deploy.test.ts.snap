        europe-west6
      GCLOUD_RUN_canonicalHostSuffix: |-
        $(printf %s "$CL_review_app_GCLOUD_RUN_canonicalHostSuffix" | sed '1!s/^/  /')
      _ALL_ENV_VAR_KEYS: |-
