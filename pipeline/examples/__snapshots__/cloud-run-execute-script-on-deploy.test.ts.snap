        name: prod-app
      env:
        CL_prod_app_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_prod_app_GCLOUD_DEPLOY_credentialsKey }}
        CL_prod_app_GCLOUD_RUN_canonicalHostSuffix: \${{ secrets.CL_prod_app_GCLOUD_RUN_canonicalHostSuffix }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
      steps:
        - name: 🛑 Stop ⚠️
