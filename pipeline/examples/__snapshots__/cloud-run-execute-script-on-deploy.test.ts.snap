    app-stop-dev:
      name: app 🛑 Stop ⚠️ | dev
      runs-on: ubuntu-latest
      needs:
        - job-image-gcloud
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev-app
      env:
        CL_dev_app_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_dev_app_GCLOUD_DEPLOY_credentialsKey }}
        CL_dev_app_GCLOUD_RUN_canonicalHostSuffix: \${{ secrets.CL_dev_app_GCLOUD_RUN_canonicalHostSuffix }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
      steps:
        - name: 🛑 Stop ⚠️
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "injectvars" "Injecting variables"
            export CLOUDSDK_CORE_DISABLE_PROMPTS="1"
            collapseable_section_end "injectvars"
            set +e
            gcloud auth activate-service-account --key-file=<(echo "$CL_dev_app_GCLOUD_DEPLOY_credentialsKey")
            echo 'stopping'
            gcloud run services delete pan-test-app-dev-app --project=google-project-id --region=europe-west6
            echo 'stopped'
            gcloud artifacts docker images delete europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-test-app/dev/app --quiet --delete-tags
            gcloud artifacts docker images list europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-test-app/caches/app --sort-by=~CREATE_TIME --format="value(version)" | tail -n +2 | while read -r version; do gcloud artifacts docker images delete europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-test-app/caches/app@$version --quiet --delete-tags; done
            set -e
          shell: bash
      if: \${{ inputs.job == 'app-stop-dev' }}
    create-release:
      name: create release
      runs-on: ubuntu-latest
      container:
        image: path/to/docker/semantic-release:the-version
      permissions:
        contents: write
      env:
        GITHUB_TOKEN: \${{ github.token }}
      steps:
        - name: Checkout
          uses: actions/checkout@v4
          with:
            fetch-depth: 0
        - name: create release
          run: semanticRelease
          shell: bash
      if: \${{ inputs.job == 'create-release' }}
    app-stop-stage:
      name: app 🛑 Stop ⚠️ | stage
      runs-on: ubuntu-latest
      needs:
        - job-image-gcloud
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: stage-app
      env:
        CL_stage_app_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_stage_app_GCLOUD_DEPLOY_credentialsKey }}
        CL_stage_app_GCLOUD_RUN_canonicalHostSuffix: \${{ secrets.CL_stage_app_GCLOUD_RUN_canonicalHostSuffix }}
