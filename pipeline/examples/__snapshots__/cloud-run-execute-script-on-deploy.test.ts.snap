        CL_review_app_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_review_app_GCLOUD_DEPLOY_credentialsKey }}
        CL_review_app_GCLOUD_RUN_canonicalHostSuffix: \${{ secrets.CL_review_app_GCLOUD_RUN_canonicalHostSuffix }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🛡 audit
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "injectvars" "Injecting variables"
            export APP_PATH="app"
            collapseable_section_end "injectvars"
            cd app
            yarn npm audit --environment production --severity critical
          shell: bash
    app-lint-review:
      name: app 👮 lint | review
      runs-on: ubuntu-latest
      needs:
        - job-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      env:
        CL_review_app_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_review_app_GCLOUD_DEPLOY_credentialsKey }}
        CL_review_app_GCLOUD_RUN_canonicalHostSuffix: \${{ secrets.CL_review_app_GCLOUD_RUN_canonicalHostSuffix }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app-yarn
          uses: actions/cache@v4
          with:
            path: app/.yarn
            key: app-yarn-\${{ github.run_id }}
            restore-keys: app-yarn-
        - name: Cache app-node-modules
          uses: actions/cache@v4
          with:
            path: |-
              app/node_modules
              app/.yarn/install-state.gz
            key: app-node-modules-\${{ github.run_id }}
            restore-keys: app-node-modules-
        - name: 👮 lint
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "injectvars" "Injecting variables"
            export APP_PATH="app"
            collapseable_section_end "injectvars"
            collapseable_section_start "nodeinstall" "Ensure node version"
            if [ -f "$HOME/.nvm/nvm.sh" ]; then source "$HOME/.nvm/nvm.sh"; elif [ -f /root/.nvm/nvm.sh ]; then export NVM_DIR=/root/.nvm; source /root/.nvm/nvm.sh; fi
            if command -v nvm &> /dev/null && [ -f ./.nvmrc ]; then nvm install; fi
            collapseable_section_end "nodeinstall"
            cd app
            collapseable_section_start "nodeinstall" "Ensure node version"
            if [ -f "$HOME/.nvm/nvm.sh" ]; then source "$HOME/.nvm/nvm.sh"; elif [ -f /root/.nvm/nvm.sh ]; then export NVM_DIR=/root/.nvm; source /root/.nvm/nvm.sh; fi
            if command -v nvm &> /dev/null && [ -f ./.nvmrc ]; then nvm install; fi
            collapseable_section_end "nodeinstall"
            collapseable_section_start "yarninstall" "Yarn install"
            yarn install --immutable --inline-builds
            collapseable_section_end "yarninstall"
            yarn lint
          shell: bash
