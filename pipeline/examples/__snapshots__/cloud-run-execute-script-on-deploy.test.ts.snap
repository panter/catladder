    app-stop-review:
      name: app 🛑 Stop ⚠️ | review
      runs-on: ubuntu-latest
      needs:
        - job-image-gcloud
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review-pr\${{ github.event.number }}-app
      env:
        CL_review_app_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_review_app_GCLOUD_DEPLOY_credentialsKey }}
        CL_review_app_GCLOUD_RUN_canonicalHostSuffix: \${{ secrets.CL_review_app_GCLOUD_RUN_canonicalHostSuffix }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
      steps:
        - name: 🛑 Stop ⚠️
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "injectvars" "Injecting variables"
            export CLOUDSDK_CORE_DISABLE_PROMPTS="1"
            collapseable_section_end "injectvars"
            set +e
            gcloud auth activate-service-account --key-file=<(echo "$CL_review_app_GCLOUD_DEPLOY_credentialsKey")
            echo 'stopping'
            gcloud run services delete $(printf %s "pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-app" | awk '{print tolower($0)}') --project=google-project-id --region=europe-west6
            echo 'stopped'
            gcloud artifacts docker images delete europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-test-app/review/app/$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown") --quiet --delete-tags
            gcloud artifacts docker images list europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-test-app/caches/app --sort-by=~CREATE_TIME --format="value(version)" | tail -n +2 | while read -r version; do gcloud artifacts docker images delete europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-test-app/caches/app@$version --quiet --delete-tags; done
            set +e
            gcloud artifacts docker images delete europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-test-app/review/app --quiet --delete-tags
            set -e
            set -e
          shell: bash
catladder-manual.yml:
  name: catladder manual tasks
  on:
    workflow_dispatch:
      inputs:
        job:
          description: the task to run
          required: true
          type: choice
          options:
            - app-stop-dev
            - create-release
            - app-stop-stage
            - app-stop-prod
  permissions:
    contents: read
    packages: write
  env: *a1
  jobs:
    job-image-jobs-default:
      name: 🐳 job image jobs-default
      runs-on: ubuntu-latest
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🐳 job image jobs-default
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "docker-login" "Docker Login"
            docker login --username $CL_REGISTRY_USER --password $CL_JOB_TOKEN $CL_REGISTRY
            collapseable_section_end "docker-login"
            collapseable_section_start "check-image" "Checking if image exists"
            if docker manifest inspect ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b > /dev/null 2>&1; then
              echo "Image ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b already exists, skipping build"
              exit 0
            fi
            collapseable_section_end "check-image"
            collapseable_section_start "docker-build" "Building image"
            DOCKER_BUILDKIT=1 docker build -t ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b -f .catladder-generated/images/jobs-default/Dockerfile .catladder-generated/images
            collapseable_section_end "docker-build"
            collapseable_section_start "docker-push" "Pushing image"
            docker push ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
            collapseable_section_end "docker-push"
          shell: bash
    job-image-jobs-testing-chrome:
      name: 🐳 job image jobs-testing-chrome
      runs-on: ubuntu-latest
      steps:
        - name: Checkout
          uses: actions/checkout@v4
