              echo "Image ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115 already exists, skipping build"
              exit 0
            fi
            collapseable_section_end "check-image"
            collapseable_section_start "docker-build" "Building image"
            DOCKER_BUILDKIT=1 docker build -t ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115 -f .catladder-generated/images/gcloud/Dockerfile .catladder-generated/images/gcloud
            collapseable_section_end "docker-build"
            collapseable_section_start "docker-push" "Pushing image"
            docker push ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
            collapseable_section_end "docker-push"
          shell: bash
    app-audit-review:
      name: app 🛡 audit | review
      runs-on: ubuntu-latest
      needs:
        - job-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
