    - echo 'Uploading SBOM to Dependency Track'
    - /dtrackuploader https://dep.panter.swiss/ "$DT_KEY_PROD" upload "pan-test-app/api" "https://unknown-host.example.com" "__sbom.json" vex.json || true
  cache: []
  rules:
    - when: manual
      if: $CI_COMMIT_TAG
  needs:
    - job: 'api 🔨 app | prod '
      artifacts: true
    - job: 'api 🧾 sbom | prod '
