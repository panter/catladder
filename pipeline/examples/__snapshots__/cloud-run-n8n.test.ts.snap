// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`matches snapshot for cloud-run-n8n github workflows YAML 1`] = `
"catladder-main.yml:
  name: catladder main
  on:
    push:
      branches:
        - main
  permissions:
    contents: read
    packages: write
  env: &a1
    CL_JOB_TOKEN: \${{ github.token }}
    CL_REGISTRY: ghcr.io
    CL_REGISTRY_IMAGE: ghcr.io/\${{ github.repository }}
    CL_REGISTRY_USER: \${{ github.actor }}
    CL_PR_NUMBER: \${{ github.event.number }}
  jobs:
    job-image-gcloud:
      name: 🐳 job image gcloud
      runs-on: ubuntu-latest
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🐳 job image gcloud
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "docker-login" "Docker Login"
            docker login --username $CL_REGISTRY_USER --password $CL_JOB_TOKEN $CL_REGISTRY
            collapseable_section_end "docker-login"
            collapseable_section_start "check-image" "Checking if image exists"
            if docker manifest inspect ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115 > /dev/null 2>&1; then
              echo "Image ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115 already exists, skipping build"
              exit 0
            fi
            collapseable_section_end "check-image"
            collapseable_section_start "docker-build" "Building image"
            DOCKER_BUILDKIT=1 docker build -t ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115 -f .catladder-generated/images/gcloud/Dockerfile .catladder-generated/images/gcloud
            collapseable_section_end "docker-build"
            collapseable_section_start "docker-push" "Pushing image"
            docker push ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
            collapseable_section_end "docker-push"
          shell: bash
    n8n-deploy-dev:
      name: n8n 🚀 Deploy | dev
      runs-on: ubuntu-latest
      needs:
        - job-image-gcloud
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev-n8n
        url: \${{ steps.main.outputs.url }}
      env:
        CL_dev_n8n_N8N_ENCRYPTION_KEY: \${{ secrets.CL_dev_n8n_N8N_ENCRYPTION_KEY }}
        CL_dev_n8n_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_dev_n8n_GCLOUD_DEPLOY_credentialsKey }}
        CL_dev_n8n_GCLOUD_RUN_canonicalHostSuffix: \${{ secrets.CL_dev_n8n_GCLOUD_RUN_canonicalHostSuffix }}
        CL_dev_n8n_DB_PASSWORD: \${{ secrets.CL_dev_n8n_DB_PASSWORD }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🚀 Deploy
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "injectvars" "Injecting variables"
            export ENV_SHORT="dev"
            export APP_DIR="n8n"
            export ENV_TYPE="dev"
            export BUILD_INFO_BUILD_ID="$(git describe --tags 2>/dev/null || git rev-parse HEAD)"
            export BUILD_INFO_BUILD_TIME="unknown-build-time"
            export BUILD_INFO_CURRENT_VERSION="$(tag=$(git ls-remote origin "refs/tags/v*[0-9]" 2>/dev/null | cut -f 2- | sort -V | tail -1 | sed 's/refs\\/tags\\/v//'); [ -z "$tag" ] && echo "0.0.0" || echo "$tag")"
            export HOSTNAME="$(printf %s "pan-my-n8n-app-dev-n8n-$CL_dev_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')"
            export ROOT_URL="https://$(printf %s "pan-my-n8n-app-dev-n8n-$CL_dev_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')"
            export HOSTNAME_INTERNAL="$(printf %s "pan-my-n8n-app-dev-n8n-$CL_dev_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')"
            export ROOT_URL_INTERNAL="https://$(printf %s "pan-my-n8n-app-dev-n8n-$CL_dev_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')"
            export CLOUD_SQL_INSTANCE_CONNECTION_NAME="projectId:region:instancename"
            export DB_NAME="pan-my-n8n-app-dev-n8n"
            export DB_USER="postgres"
            export DB_PASSWORD="$CL_dev_n8n_DB_PASSWORD"
            export DATABASE_URL="postgresql://$DB_USER:$DB_PASSWORD@localhost/$DB_NAME?host=/cloudsql/$CLOUD_SQL_INSTANCE_CONNECTION_NAME"
            export DATABASE_JDBC_URL="jdbc:postgresql:///$DB_NAME?cloudSqlInstance=$CLOUD_SQL_INSTANCE_CONNECTION_NAME&socketFactory=com.google.cloud.sql.postgres.SocketFactory&user=$DB_USER&password=$DB_PASSWORD"
            export DEPLOY_CLOUD_RUN_SERVICE_NAME="pan-my-n8n-app-dev-n8n"
            export DEPLOY_CLOUD_RUN_PROJECT_ID="google-project-id"
            export DEPLOY_CLOUD_RUN_REGION="europe-west6"
            export N8N_ENCRYPTION_KEY="$CL_dev_n8n_N8N_ENCRYPTION_KEY"
            export GCLOUD_DEPLOY_credentialsKey="$CL_dev_n8n_GCLOUD_DEPLOY_credentialsKey"
            export GCLOUD_RUN_canonicalHostSuffix="$CL_dev_n8n_GCLOUD_RUN_canonicalHostSuffix"
            export N8N_PORT="8080"
            export N8N_PROTOCOL="https"
            export DB_TYPE="postgresdb"
            export DB_POSTGRESDB_DATABASE="pan-my-n8n-app-dev-n8n"
            export DB_POSTGRESDB_HOST="/cloudsql/projectId:region:instancename"
            export DB_POSTGRESDB_USER="postgres"
            export DB_POSTGRESDB_PASSWORD="$CL_dev_n8n_DB_PASSWORD"
            export DB_POSTGRESDB_PORT="5432"
            export DB_POSTGRESDB_SCHEMA="public"
            export GENERIC_TIMEZONE="Europe/Zurich"
            export N8N_DIAGNOSTICS_ENABLED="false"
            export N8N_PERSONALIZATION_ENABLED="false"
            export QUEUE_HEALTH_CHECK_ACTIVE="true"
            export WEBHOOK_URL="https://$(printf %s "pan-my-n8n-app-dev-n8n-$CL_dev_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')"
            export N8N_EDITOR_BASE_URL="https://$(printf %s "pan-my-n8n-app-dev-n8n-$CL_dev_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')"
            export _ALL_ENV_VAR_KEYS="[\\"ENV_SHORT\\",\\"APP_DIR\\",\\"ENV_TYPE\\",\\"BUILD_INFO_BUILD_ID\\",\\"BUILD_INFO_BUILD_TIME\\",\\"BUILD_INFO_CURRENT_VERSION\\",\\"HOSTNAME\\",\\"ROOT_URL\\",\\"HOSTNAME_INTERNAL\\",\\"ROOT_URL_INTERNAL\\",\\"CLOUD_SQL_INSTANCE_CONNECTION_NAME\\",\\"DB_NAME\\",\\"DB_USER\\",\\"DB_PASSWORD\\",\\"DATABASE_URL\\",\\"DATABASE_JDBC_URL\\",\\"DEPLOY_CLOUD_RUN_SERVICE_NAME\\",\\"DEPLOY_CLOUD_RUN_PROJECT_ID\\",\\"DEPLOY_CLOUD_RUN_REGION\\",\\"N8N_ENCRYPTION_KEY\\",\\"GCLOUD_DEPLOY_credentialsKey\\",\\"GCLOUD_RUN_canonicalHostSuffix\\",\\"N8N_PORT\\",\\"N8N_PROTOCOL\\",\\"DB_TYPE\\",\\"DB_POSTGRESDB_DATABASE\\",\\"DB_POSTGRESDB_HOST\\",\\"DB_POSTGRESDB_USER\\",\\"DB_POSTGRESDB_PASSWORD\\",\\"DB_POSTGRESDB_PORT\\",\\"DB_POSTGRESDB_SCHEMA\\",\\"GENERIC_TIMEZONE\\",\\"N8N_DIAGNOSTICS_ENABLED\\",\\"N8N_PERSONALIZATION_ENABLED\\",\\"QUEUE_HEALTH_CHECK_ACTIVE\\",\\"WEBHOOK_URL\\",\\"N8N_EDITOR_BASE_URL\\"]"
            export DOCKER_REGISTRY="europe-west6-docker.pkg.dev"
            export DOCKER_IMAGE="europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/dev/n8n"
            export DOCKER_CACHE_IMAGE="europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/caches/n8n"
            export DOCKER_IMAGE_TAG="$GITHUB_SHA"
            export CLOUDSDK_CORE_DISABLE_PROMPTS="1"
            collapseable_section_end "injectvars"
            collapseable_section_start "prepare" "Prepare..."
            gcloud auth activate-service-account --key-file=<(echo "$CL_dev_n8n_GCLOUD_DEPLOY_credentialsKey")
            export GCLOUD_PROJECT_NUMBER=$(gcloud projects describe google-project-id --format="value(projectNumber)")
            echo "GCLOUD_PROJECT_NUMBER: $GCLOUD_PROJECT_NUMBER"
            collapseable_section_end "prepare"
            collapseable_section_start "writeenvvars" "Write env vars to file"
            cat > ____envvars.yaml <<EOF
            ENV_SHORT: |-
              dev
            APP_DIR: |-
              n8n
            ENV_TYPE: |-
              dev
            BUILD_INFO_BUILD_ID: |-
              $(printf %s "$(git describe --tags 2>/dev/null || git rev-parse HEAD)" | sed '1!s/^/  /')
            BUILD_INFO_BUILD_TIME: |-
              unknown-build-time
            BUILD_INFO_CURRENT_VERSION: |-
              $(printf %s "$(tag=$(git ls-remote origin "refs/tags/v*[0-9]" 2>/dev/null | cut -f 2- | sort -V | tail -1 | sed 's/refs\\/tags\\/v//'); [ -z "$tag" ] && echo "0.0.0" || echo "$tag")" | sed '1!s/^/  /')
            HOSTNAME: |-
              $(printf %s "$(printf %s "pan-my-n8n-app-dev-n8n-$CL_dev_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')" | sed '1!s/^/  /')
            ROOT_URL: |-
              $(printf %s "https://$(printf %s "pan-my-n8n-app-dev-n8n-$CL_dev_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')" | sed '1!s/^/  /')
            HOSTNAME_INTERNAL: |-
              $(printf %s "$(printf %s "pan-my-n8n-app-dev-n8n-$CL_dev_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')" | sed '1!s/^/  /')
            ROOT_URL_INTERNAL: |-
              $(printf %s "https://$(printf %s "pan-my-n8n-app-dev-n8n-$CL_dev_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')" | sed '1!s/^/  /')
            CLOUD_SQL_INSTANCE_CONNECTION_NAME: |-
              projectId:region:instancename
            DB_NAME: |-
              pan-my-n8n-app-dev-n8n
            DB_USER: |-
              postgres
            DB_PASSWORD: |-
              $(printf %s "$CL_dev_n8n_DB_PASSWORD" | sed '1!s/^/  /')
            DATABASE_URL: |-
              postgresql://$DB_USER:$DB_PASSWORD@localhost/$DB_NAME?host=/cloudsql/$CLOUD_SQL_INSTANCE_CONNECTION_NAME
            DATABASE_JDBC_URL: |-
              jdbc:postgresql:///$DB_NAME?cloudSqlInstance=$CLOUD_SQL_INSTANCE_CONNECTION_NAME&socketFactory=com.google.cloud.sql.postgres.SocketFactory&user=$DB_USER&password=$DB_PASSWORD
            DEPLOY_CLOUD_RUN_SERVICE_NAME: |-
              pan-my-n8n-app-dev-n8n
            DEPLOY_CLOUD_RUN_PROJECT_ID: |-
              google-project-id
            DEPLOY_CLOUD_RUN_REGION: |-
              europe-west6
            N8N_ENCRYPTION_KEY: |-
              $(printf %s "$CL_dev_n8n_N8N_ENCRYPTION_KEY" | sed '1!s/^/  /')
            GCLOUD_RUN_canonicalHostSuffix: |-
              $(printf %s "$CL_dev_n8n_GCLOUD_RUN_canonicalHostSuffix" | sed '1!s/^/  /')
            N8N_PORT: |-
              8080
            N8N_PROTOCOL: |-
              https
            DB_TYPE: |-
              postgresdb
            DB_POSTGRESDB_DATABASE: |-
              pan-my-n8n-app-dev-n8n
            DB_POSTGRESDB_HOST: |-
              /cloudsql/projectId:region:instancename
            DB_POSTGRESDB_USER: |-
              postgres
            DB_POSTGRESDB_PASSWORD: |-
              $(printf %s "$CL_dev_n8n_DB_PASSWORD" | sed '1!s/^/  /')
            DB_POSTGRESDB_PORT: |-
              5432
            DB_POSTGRESDB_SCHEMA: |-
              public
            GENERIC_TIMEZONE: |-
              Europe/Zurich
            N8N_DIAGNOSTICS_ENABLED: |-
              false
            N8N_PERSONALIZATION_ENABLED: |-
              false
            QUEUE_HEALTH_CHECK_ACTIVE: |-
              true
            WEBHOOK_URL: |-
              $(printf %s "https://$(printf %s "pan-my-n8n-app-dev-n8n-$CL_dev_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')" | sed '1!s/^/  /')
            N8N_EDITOR_BASE_URL: |-
              $(printf %s "https://$(printf %s "pan-my-n8n-app-dev-n8n-$CL_dev_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')" | sed '1!s/^/  /')
            _ALL_ENV_VAR_KEYS: |-
              ["ENV_SHORT","APP_DIR","ENV_TYPE","BUILD_INFO_BUILD_ID","BUILD_INFO_BUILD_TIME","BUILD_INFO_CURRENT_VERSION","HOSTNAME","ROOT_URL","HOSTNAME_INTERNAL","ROOT_URL_INTERNAL","CLOUD_SQL_INSTANCE_CONNECTION_NAME","DB_NAME","DB_USER","DB_PASSWORD","DATABASE_URL","DATABASE_JDBC_URL","DEPLOY_CLOUD_RUN_SERVICE_NAME","DEPLOY_CLOUD_RUN_PROJECT_ID","DEPLOY_CLOUD_RUN_REGION","N8N_ENCRYPTION_KEY","GCLOUD_DEPLOY_credentialsKey","GCLOUD_RUN_canonicalHostSuffix","N8N_PORT","N8N_PROTOCOL","DB_TYPE","DB_POSTGRESDB_DATABASE","DB_POSTGRESDB_HOST","DB_POSTGRESDB_USER","DB_POSTGRESDB_PASSWORD","DB_POSTGRESDB_PORT","DB_POSTGRESDB_SCHEMA","GENERIC_TIMEZONE","N8N_DIAGNOSTICS_ENABLED","N8N_PERSONALIZATION_ENABLED","QUEUE_HEALTH_CHECK_ACTIVE","WEBHOOK_URL","N8N_EDITOR_BASE_URL"]

            EOF

            collapseable_section_end "writeenvvars"
            collapseable_section_start "deploy" "Deploy to cloud run"
            set +e
            echo "ensuring Database..."
            gcloud sql databases create pan-my-n8n-app-dev-n8n --instance=instancename --project projectId
            set -e
            gcloud run deploy pan-my-n8n-app-dev-n8n --command="/bin/sh" --args="-c","sleep 5; n8n start" --image=n8nio/n8n:2.12.0 --project=google-project-id --region=europe-west6 --set-cloudsql-instances=projectId:region:instancename --labels=customer-name=pan,component-name=n8n,app-name=my-n8n-app,env-type=dev,env-name=dev,build-type=disabled,cloud-run-service-name=pan-my-n8n-app-dev-n8n --env-vars-file=____envvars.yaml --min-instances=1 --max-instances=1 --no-cpu-throttling --cpu=2 --memory=2Gi --timeout=3600s --allow-unauthenticated --ingress=all --session-affinity --cpu-boost --execution-environment=gen2
            collapseable_section_end "deploy"
            collapseable_section_start "cleanup" "Cleanup"
            set +e
            gcloud run revisions list --project=google-project-id --region=europe-west6 --service=pan-my-n8n-app-dev-n8n --limit=unlimited --sort-by=metadata.creationTimestamp --format="value(name)" --filter='(status.conditions.status=False OR status.conditions.status=Unknown)' | while read -r revisionname; do gcloud run revisions delete --project=google-project-id --region=europe-west6 --quiet $revisionname ; done
            gcloud artifacts docker images list europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/dev/n8n --sort-by=~CREATE_TIME --format="value(version)" | tail -n +2 | while read -r version; do gcloud artifacts docker images delete europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/dev/n8n@$version --quiet --delete-tags; done
            gcloud artifacts docker images list europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/caches/n8n --sort-by=~CREATE_TIME --format="value(version)" | tail -n +2 | while read -r version; do gcloud artifacts docker images delete europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/caches/n8n@$version --quiet --delete-tags; done
            set -e
            collapseable_section_end "cleanup"
            echo "url=$ROOT_URL" >> "$GITHUB_OUTPUT"
          shell: bash
catladder-review.yml:
  name: catladder review
  on:
    pull_request:
      types:
        - opened
        - synchronize
        - reopened
  concurrency:
    group: catladder-review-\${{ github.event.number }}
    cancel-in-progress: true
  permissions:
    contents: read
    packages: write
  env: *a1
  jobs:
    job-image-gcloud:
      name: 🐳 job image gcloud
      runs-on: ubuntu-latest
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🐳 job image gcloud
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "docker-login" "Docker Login"
            docker login --username $CL_REGISTRY_USER --password $CL_JOB_TOKEN $CL_REGISTRY
            collapseable_section_end "docker-login"
            collapseable_section_start "check-image" "Checking if image exists"
            if docker manifest inspect ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115 > /dev/null 2>&1; then
              echo "Image ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115 already exists, skipping build"
              exit 0
            fi
            collapseable_section_end "check-image"
            collapseable_section_start "docker-build" "Building image"
            DOCKER_BUILDKIT=1 docker build -t ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115 -f .catladder-generated/images/gcloud/Dockerfile .catladder-generated/images/gcloud
            collapseable_section_end "docker-build"
            collapseable_section_start "docker-push" "Pushing image"
            docker push ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
            collapseable_section_end "docker-push"
          shell: bash
    n8n-deploy-review:
      name: n8n 🚀 Deploy | review
      runs-on: ubuntu-latest
      needs:
        - job-image-gcloud
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review-pr\${{ github.event.number }}-n8n
        url: \${{ steps.main.outputs.url }}
      env:
        CL_review_n8n_N8N_ENCRYPTION_KEY: \${{ secrets.CL_review_n8n_N8N_ENCRYPTION_KEY }}
        CL_review_n8n_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_review_n8n_GCLOUD_DEPLOY_credentialsKey }}
        CL_review_n8n_GCLOUD_RUN_canonicalHostSuffix: \${{ secrets.CL_review_n8n_GCLOUD_RUN_canonicalHostSuffix }}
        CL_review_n8n_DB_PASSWORD: \${{ secrets.CL_review_n8n_DB_PASSWORD }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🚀 Deploy
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "injectvars" "Injecting variables"
            export ENV_SHORT="review"
            export APP_DIR="n8n"
            export ENV_TYPE="review"
            export BUILD_INFO_BUILD_ID="$(git describe --tags 2>/dev/null || git rev-parse HEAD)"
            export BUILD_INFO_BUILD_TIME="unknown-build-time"
            export BUILD_INFO_CURRENT_VERSION="$(tag=$(git ls-remote origin "refs/tags/v*[0-9]" 2>/dev/null | cut -f 2- | sort -V | tail -1 | sed 's/refs\\/tags\\/v//'); [ -z "$tag" ] && echo "0.0.0" || echo "$tag")"
            export HOSTNAME="$(printf %s "pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n-$CL_review_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')"
            export ROOT_URL="https://$(printf %s "pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n-$CL_review_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')"
            export HOSTNAME_INTERNAL="$(printf %s "pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n-$CL_review_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')"
            export ROOT_URL_INTERNAL="https://$(printf %s "pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n-$CL_review_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')"
            export CLOUD_SQL_INSTANCE_CONNECTION_NAME="projectId:region:instancename"
            export DB_NAME="pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n"
            export DB_USER="postgres"
            export DB_PASSWORD="$CL_review_n8n_DB_PASSWORD"
            export DATABASE_URL="postgresql://$DB_USER:$DB_PASSWORD@localhost/$DB_NAME?host=/cloudsql/$CLOUD_SQL_INSTANCE_CONNECTION_NAME"
            export DATABASE_JDBC_URL="jdbc:postgresql:///$DB_NAME?cloudSqlInstance=$CLOUD_SQL_INSTANCE_CONNECTION_NAME&socketFactory=com.google.cloud.sql.postgres.SocketFactory&user=$DB_USER&password=$DB_PASSWORD"
            export DEPLOY_CLOUD_RUN_SERVICE_NAME="$(printf %s "pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n" | awk '{print tolower($0)}')"
            export DEPLOY_CLOUD_RUN_PROJECT_ID="google-project-id"
            export DEPLOY_CLOUD_RUN_REGION="europe-west6"
            export N8N_ENCRYPTION_KEY="$CL_review_n8n_N8N_ENCRYPTION_KEY"
            export GCLOUD_DEPLOY_credentialsKey="$CL_review_n8n_GCLOUD_DEPLOY_credentialsKey"
            export GCLOUD_RUN_canonicalHostSuffix="$CL_review_n8n_GCLOUD_RUN_canonicalHostSuffix"
            export N8N_PORT="8080"
            export N8N_PROTOCOL="https"
            export DB_TYPE="postgresdb"
            export DB_POSTGRESDB_DATABASE="pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n"
            export DB_POSTGRESDB_HOST="/cloudsql/projectId:region:instancename"
            export DB_POSTGRESDB_USER="postgres"
            export DB_POSTGRESDB_PASSWORD="$CL_review_n8n_DB_PASSWORD"
            export DB_POSTGRESDB_PORT="5432"
            export DB_POSTGRESDB_SCHEMA="public"
            export GENERIC_TIMEZONE="Europe/Zurich"
            export N8N_DIAGNOSTICS_ENABLED="false"
            export N8N_PERSONALIZATION_ENABLED="false"
            export QUEUE_HEALTH_CHECK_ACTIVE="true"
            export WEBHOOK_URL="https://$(printf %s "pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n-$CL_review_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')"
            export N8N_EDITOR_BASE_URL="https://$(printf %s "pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n-$CL_review_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')"
            export _ALL_ENV_VAR_KEYS="[\\"ENV_SHORT\\",\\"APP_DIR\\",\\"ENV_TYPE\\",\\"BUILD_INFO_BUILD_ID\\",\\"BUILD_INFO_BUILD_TIME\\",\\"BUILD_INFO_CURRENT_VERSION\\",\\"HOSTNAME\\",\\"ROOT_URL\\",\\"HOSTNAME_INTERNAL\\",\\"ROOT_URL_INTERNAL\\",\\"CLOUD_SQL_INSTANCE_CONNECTION_NAME\\",\\"DB_NAME\\",\\"DB_USER\\",\\"DB_PASSWORD\\",\\"DATABASE_URL\\",\\"DATABASE_JDBC_URL\\",\\"DEPLOY_CLOUD_RUN_SERVICE_NAME\\",\\"DEPLOY_CLOUD_RUN_PROJECT_ID\\",\\"DEPLOY_CLOUD_RUN_REGION\\",\\"N8N_ENCRYPTION_KEY\\",\\"GCLOUD_DEPLOY_credentialsKey\\",\\"GCLOUD_RUN_canonicalHostSuffix\\",\\"N8N_PORT\\",\\"N8N_PROTOCOL\\",\\"DB_TYPE\\",\\"DB_POSTGRESDB_DATABASE\\",\\"DB_POSTGRESDB_HOST\\",\\"DB_POSTGRESDB_USER\\",\\"DB_POSTGRESDB_PASSWORD\\",\\"DB_POSTGRESDB_PORT\\",\\"DB_POSTGRESDB_SCHEMA\\",\\"GENERIC_TIMEZONE\\",\\"N8N_DIAGNOSTICS_ENABLED\\",\\"N8N_PERSONALIZATION_ENABLED\\",\\"QUEUE_HEALTH_CHECK_ACTIVE\\",\\"WEBHOOK_URL\\",\\"N8N_EDITOR_BASE_URL\\"]"
            export DOCKER_REGISTRY="europe-west6-docker.pkg.dev"
            export DOCKER_IMAGE="europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/review/n8n/$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")"
            export DOCKER_CACHE_IMAGE="europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/caches/n8n"
            export DOCKER_IMAGE_TAG="$GITHUB_SHA"
            export CLOUDSDK_CORE_DISABLE_PROMPTS="1"
            collapseable_section_end "injectvars"
            collapseable_section_start "prepare" "Prepare..."
            gcloud auth activate-service-account --key-file=<(echo "$CL_review_n8n_GCLOUD_DEPLOY_credentialsKey")
            export GCLOUD_PROJECT_NUMBER=$(gcloud projects describe google-project-id --format="value(projectNumber)")
            echo "GCLOUD_PROJECT_NUMBER: $GCLOUD_PROJECT_NUMBER"
            collapseable_section_end "prepare"
            collapseable_section_start "writeenvvars" "Write env vars to file"
            cat > ____envvars.yaml <<EOF
            ENV_SHORT: |-
              review
            APP_DIR: |-
              n8n
            ENV_TYPE: |-
              review
            BUILD_INFO_BUILD_ID: |-
              $(printf %s "$(git describe --tags 2>/dev/null || git rev-parse HEAD)" | sed '1!s/^/  /')
            BUILD_INFO_BUILD_TIME: |-
              unknown-build-time
            BUILD_INFO_CURRENT_VERSION: |-
              $(printf %s "$(tag=$(git ls-remote origin "refs/tags/v*[0-9]" 2>/dev/null | cut -f 2- | sort -V | tail -1 | sed 's/refs\\/tags\\/v//'); [ -z "$tag" ] && echo "0.0.0" || echo "$tag")" | sed '1!s/^/  /')
            HOSTNAME: |-
              $(printf %s "$(printf %s "pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n-$CL_review_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')" | sed '1!s/^/  /')
            ROOT_URL: |-
              $(printf %s "https://$(printf %s "pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n-$CL_review_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')" | sed '1!s/^/  /')
            HOSTNAME_INTERNAL: |-
              $(printf %s "$(printf %s "pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n-$CL_review_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')" | sed '1!s/^/  /')
            ROOT_URL_INTERNAL: |-
              $(printf %s "https://$(printf %s "pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n-$CL_review_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')" | sed '1!s/^/  /')
            CLOUD_SQL_INSTANCE_CONNECTION_NAME: |-
              projectId:region:instancename
            DB_NAME: |-
              $(printf %s "pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n" | sed '1!s/^/  /')
            DB_USER: |-
              postgres
            DB_PASSWORD: |-
              $(printf %s "$CL_review_n8n_DB_PASSWORD" | sed '1!s/^/  /')
            DATABASE_URL: |-
              postgresql://$DB_USER:$DB_PASSWORD@localhost/$DB_NAME?host=/cloudsql/$CLOUD_SQL_INSTANCE_CONNECTION_NAME
            DATABASE_JDBC_URL: |-
              jdbc:postgresql:///$DB_NAME?cloudSqlInstance=$CLOUD_SQL_INSTANCE_CONNECTION_NAME&socketFactory=com.google.cloud.sql.postgres.SocketFactory&user=$DB_USER&password=$DB_PASSWORD
            DEPLOY_CLOUD_RUN_SERVICE_NAME: |-
              $(printf %s "$(printf %s "pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n" | awk '{print tolower($0)}')" | sed '1!s/^/  /')
            DEPLOY_CLOUD_RUN_PROJECT_ID: |-
              google-project-id
            DEPLOY_CLOUD_RUN_REGION: |-
              europe-west6
            N8N_ENCRYPTION_KEY: |-
              $(printf %s "$CL_review_n8n_N8N_ENCRYPTION_KEY" | sed '1!s/^/  /')
            GCLOUD_RUN_canonicalHostSuffix: |-
              $(printf %s "$CL_review_n8n_GCLOUD_RUN_canonicalHostSuffix" | sed '1!s/^/  /')
            N8N_PORT: |-
              8080
            N8N_PROTOCOL: |-
              https
            DB_TYPE: |-
              postgresdb
            DB_POSTGRESDB_DATABASE: |-
              $(printf %s "pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n" | sed '1!s/^/  /')
            DB_POSTGRESDB_HOST: |-
              /cloudsql/projectId:region:instancename
            DB_POSTGRESDB_USER: |-
              postgres
            DB_POSTGRESDB_PASSWORD: |-
              $(printf %s "$CL_review_n8n_DB_PASSWORD" | sed '1!s/^/  /')
            DB_POSTGRESDB_PORT: |-
              5432
            DB_POSTGRESDB_SCHEMA: |-
              public
            GENERIC_TIMEZONE: |-
              Europe/Zurich
            N8N_DIAGNOSTICS_ENABLED: |-
              false
            N8N_PERSONALIZATION_ENABLED: |-
              false
            QUEUE_HEALTH_CHECK_ACTIVE: |-
              true
            WEBHOOK_URL: |-
              $(printf %s "https://$(printf %s "pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n-$CL_review_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')" | sed '1!s/^/  /')
            N8N_EDITOR_BASE_URL: |-
              $(printf %s "https://$(printf %s "pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n-$CL_review_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')" | sed '1!s/^/  /')
            _ALL_ENV_VAR_KEYS: |-
              ["ENV_SHORT","APP_DIR","ENV_TYPE","BUILD_INFO_BUILD_ID","BUILD_INFO_BUILD_TIME","BUILD_INFO_CURRENT_VERSION","HOSTNAME","ROOT_URL","HOSTNAME_INTERNAL","ROOT_URL_INTERNAL","CLOUD_SQL_INSTANCE_CONNECTION_NAME","DB_NAME","DB_USER","DB_PASSWORD","DATABASE_URL","DATABASE_JDBC_URL","DEPLOY_CLOUD_RUN_SERVICE_NAME","DEPLOY_CLOUD_RUN_PROJECT_ID","DEPLOY_CLOUD_RUN_REGION","N8N_ENCRYPTION_KEY","GCLOUD_DEPLOY_credentialsKey","GCLOUD_RUN_canonicalHostSuffix","N8N_PORT","N8N_PROTOCOL","DB_TYPE","DB_POSTGRESDB_DATABASE","DB_POSTGRESDB_HOST","DB_POSTGRESDB_USER","DB_POSTGRESDB_PASSWORD","DB_POSTGRESDB_PORT","DB_POSTGRESDB_SCHEMA","GENERIC_TIMEZONE","N8N_DIAGNOSTICS_ENABLED","N8N_PERSONALIZATION_ENABLED","QUEUE_HEALTH_CHECK_ACTIVE","WEBHOOK_URL","N8N_EDITOR_BASE_URL"]

            EOF

            collapseable_section_end "writeenvvars"
            collapseable_section_start "deploy" "Deploy to cloud run"
            set +e
            echo "ensuring Database..."
            gcloud sql databases create pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n --instance=instancename --project projectId
            set -e
            gcloud run deploy $(printf %s "pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n" | awk '{print tolower($0)}') --command="/bin/sh" --args="-c","sleep 5; n8n start" --image=n8nio/n8n:2.12.0 --project=google-project-id --region=europe-west6 --set-cloudsql-instances=projectId:region:instancename --labels=customer-name=pan,component-name=n8n,app-name=my-n8n-app,env-type=review,env-name=review,build-type=disabled,cloud-run-service-name=$(printf %s "pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n" | awk '{print tolower($0)}') --env-vars-file=____envvars.yaml --min-instances=1 --max-instances=1 --no-cpu-throttling --cpu=2 --memory=2Gi --timeout=3600s --allow-unauthenticated --ingress=all --session-affinity --cpu-boost --execution-environment=gen2
            collapseable_section_end "deploy"
            collapseable_section_start "cleanup" "Cleanup"
            set +e
            gcloud run revisions list --project=google-project-id --region=europe-west6 --service=$(printf %s "pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n" | awk '{print tolower($0)}') --limit=unlimited --sort-by=metadata.creationTimestamp --format="value(name)" --filter='(status.conditions.status=False OR status.conditions.status=Unknown)' | while read -r revisionname; do gcloud run revisions delete --project=google-project-id --region=europe-west6 --quiet $revisionname ; done
            gcloud artifacts docker images list europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/review/n8n/$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown") --sort-by=~CREATE_TIME --format="value(version)" | tail -n +2 | while read -r version; do gcloud artifacts docker images delete europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/review/n8n/$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")@$version --quiet --delete-tags; done
            gcloud artifacts docker images list europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/caches/n8n --sort-by=~CREATE_TIME --format="value(version)" | tail -n +2 | while read -r version; do gcloud artifacts docker images delete europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/caches/n8n@$version --quiet --delete-tags; done
            set +e
            gcloud artifacts docker images delete europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/review/n8n --quiet --delete-tags
            set -e
            set -e
            collapseable_section_end "cleanup"
            echo "url=$ROOT_URL" >> "$GITHUB_OUTPUT"
          shell: bash
catladder-release.yml:
  name: catladder release
  on:
    push:
      tags:
        - v*
  permissions:
    contents: read
    packages: write
  env: *a1
  jobs:
    job-image-gcloud:
      name: 🐳 job image gcloud
      runs-on: ubuntu-latest
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🐳 job image gcloud
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "docker-login" "Docker Login"
            docker login --username $CL_REGISTRY_USER --password $CL_JOB_TOKEN $CL_REGISTRY
            collapseable_section_end "docker-login"
            collapseable_section_start "check-image" "Checking if image exists"
            if docker manifest inspect ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115 > /dev/null 2>&1; then
              echo "Image ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115 already exists, skipping build"
              exit 0
            fi
            collapseable_section_end "check-image"
            collapseable_section_start "docker-build" "Building image"
            DOCKER_BUILDKIT=1 docker build -t ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115 -f .catladder-generated/images/gcloud/Dockerfile .catladder-generated/images/gcloud
            collapseable_section_end "docker-build"
            collapseable_section_start "docker-push" "Pushing image"
            docker push ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
            collapseable_section_end "docker-push"
          shell: bash
    n8n-deploy-stage:
      name: n8n 🚀 Deploy | stage
      runs-on: ubuntu-latest
      needs:
        - job-image-gcloud
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: stage-n8n
        url: \${{ steps.main.outputs.url }}
      env:
        CL_stage_n8n_N8N_ENCRYPTION_KEY: \${{ secrets.CL_stage_n8n_N8N_ENCRYPTION_KEY }}
        CL_stage_n8n_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_stage_n8n_GCLOUD_DEPLOY_credentialsKey }}
        CL_stage_n8n_GCLOUD_RUN_canonicalHostSuffix: \${{ secrets.CL_stage_n8n_GCLOUD_RUN_canonicalHostSuffix }}
        CL_stage_n8n_DB_PASSWORD: \${{ secrets.CL_stage_n8n_DB_PASSWORD }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🚀 Deploy
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "injectvars" "Injecting variables"
            export ENV_SHORT="stage"
            export APP_DIR="n8n"
            export ENV_TYPE="stage"
            export BUILD_INFO_BUILD_ID="$(git describe --tags 2>/dev/null || git rev-parse HEAD)"
            export BUILD_INFO_BUILD_TIME="unknown-build-time"
            export BUILD_INFO_CURRENT_VERSION="$(tag=$(git ls-remote origin "refs/tags/v*[0-9]" 2>/dev/null | cut -f 2- | sort -V | tail -1 | sed 's/refs\\/tags\\/v//'); [ -z "$tag" ] && echo "0.0.0" || echo "$tag")"
            export HOSTNAME="$(printf %s "pan-my-n8n-app-stage-n8n-$CL_stage_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')"
            export ROOT_URL="https://$(printf %s "pan-my-n8n-app-stage-n8n-$CL_stage_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')"
            export HOSTNAME_INTERNAL="$(printf %s "pan-my-n8n-app-stage-n8n-$CL_stage_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')"
            export ROOT_URL_INTERNAL="https://$(printf %s "pan-my-n8n-app-stage-n8n-$CL_stage_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')"
            export CLOUD_SQL_INSTANCE_CONNECTION_NAME="projectId:region:instancename"
            export DB_NAME="pan-my-n8n-app-stage-n8n"
            export DB_USER="postgres"
            export DB_PASSWORD="$CL_stage_n8n_DB_PASSWORD"
            export DATABASE_URL="postgresql://$DB_USER:$DB_PASSWORD@localhost/$DB_NAME?host=/cloudsql/$CLOUD_SQL_INSTANCE_CONNECTION_NAME"
            export DATABASE_JDBC_URL="jdbc:postgresql:///$DB_NAME?cloudSqlInstance=$CLOUD_SQL_INSTANCE_CONNECTION_NAME&socketFactory=com.google.cloud.sql.postgres.SocketFactory&user=$DB_USER&password=$DB_PASSWORD"
            export DEPLOY_CLOUD_RUN_SERVICE_NAME="pan-my-n8n-app-stage-n8n"
            export DEPLOY_CLOUD_RUN_PROJECT_ID="google-project-id"
            export DEPLOY_CLOUD_RUN_REGION="europe-west6"
            export N8N_ENCRYPTION_KEY="$CL_stage_n8n_N8N_ENCRYPTION_KEY"
            export GCLOUD_DEPLOY_credentialsKey="$CL_stage_n8n_GCLOUD_DEPLOY_credentialsKey"
            export GCLOUD_RUN_canonicalHostSuffix="$CL_stage_n8n_GCLOUD_RUN_canonicalHostSuffix"
            export N8N_PORT="8080"
            export N8N_PROTOCOL="https"
            export DB_TYPE="postgresdb"
            export DB_POSTGRESDB_DATABASE="pan-my-n8n-app-stage-n8n"
            export DB_POSTGRESDB_HOST="/cloudsql/projectId:region:instancename"
            export DB_POSTGRESDB_USER="postgres"
            export DB_POSTGRESDB_PASSWORD="$CL_stage_n8n_DB_PASSWORD"
            export DB_POSTGRESDB_PORT="5432"
            export DB_POSTGRESDB_SCHEMA="public"
            export GENERIC_TIMEZONE="Europe/Zurich"
            export N8N_DIAGNOSTICS_ENABLED="false"
            export N8N_PERSONALIZATION_ENABLED="false"
            export QUEUE_HEALTH_CHECK_ACTIVE="true"
            export WEBHOOK_URL="https://$(printf %s "pan-my-n8n-app-stage-n8n-$CL_stage_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')"
            export N8N_EDITOR_BASE_URL="https://$(printf %s "pan-my-n8n-app-stage-n8n-$CL_stage_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')"
