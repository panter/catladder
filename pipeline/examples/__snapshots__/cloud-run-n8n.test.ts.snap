            ROOT_URL_INTERNAL: |-
              $(printf %s "https://$(printf %s "pan-my-n8n-app-stage-n8n-$CL_stage_n8n_GCLOUD_RUN_canonicalHostSuffix" | awk '{print tolower($0)}')" | sed '1!s/^/  /')
            CLOUD_SQL_INSTANCE_CONNECTION_NAME: |-
