            gcloud sql databases create pan-my-n8n-app-prod-n8n --instance=instancename --project projectId
            set -e
            gcloud run deploy pan-my-n8n-app-prod-n8n --command="/bin/sh" --args="-c","sleep 5; n8n start" --image=n8nio/n8n:2.12.0 --project=google-project-id --region=europe-west6 --set-cloudsql-instances=projectId:region:instancename --labels=customer-name=pan,component-name=n8n,app-name=my-n8n-app,env-type=prod,env-name=prod,build-type=disabled,cloud-run-service-name=pan-my-n8n-app-prod-n8n --env-vars-file=____envvars.yaml --min-instances=1 --max-instances=1 --no-cpu-throttling --cpu=2 --memory=2Gi --timeout=3600s --allow-unauthenticated --ingress=all --session-affinity --cpu-boost --execution-environment=gen2
            collapseable_section_end "deploy"
            collapseable_section_start "cleanup" "Cleanup"
            set +e
            gcloud run revisions list --project=google-project-id --region=europe-west6 --service=pan-my-n8n-app-prod-n8n --limit=unlimited --sort-by=metadata.creationTimestamp --format="value(name)" --filter='(status.conditions.status=False OR status.conditions.status=Unknown)' | tail -n +6 | while read -r revisionname; do gcloud run revisions delete --project=google-project-id --region=europe-west6 --quiet $revisionname ; done
            gcloud artifacts docker images list europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/prod/n8n --sort-by=~CREATE_TIME --format="value(version)" | tail -n +7 | while read -r version; do gcloud artifacts docker images delete europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/prod/n8n@$version --quiet --delete-tags; done
            gcloud artifacts docker images list europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/caches/n8n --sort-by=~CREATE_TIME --format="value(version)" | tail -n +2 | while read -r version; do gcloud artifacts docker images delete europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/caches/n8n@$version --quiet --delete-tags; done
            set -e
            collapseable_section_end "cleanup"
            echo "url=$ROOT_URL" >> "$GITHUB_OUTPUT"
          shell: bash
catladder-review-stop.yml:
  name: catladder review stop
  on:
    pull_request:
      types:
        - closed
  permissions:
    contents: read
    packages: write
  env: *a1
  jobs:
    job-image-gcloud:
      name: 🐳 job image gcloud
      runs-on: ubuntu-latest
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🐳 job image gcloud
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "docker-login" "Docker Login"
            docker login --username $CL_REGISTRY_USER --password $CL_JOB_TOKEN $CL_REGISTRY
            collapseable_section_end "docker-login"
            collapseable_section_start "check-image" "Checking if image exists"
            if docker manifest inspect ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115 > /dev/null 2>&1; then
              echo "Image ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115 already exists, skipping build"
              exit 0
            fi
            collapseable_section_end "check-image"
            collapseable_section_start "docker-build" "Building image"
            DOCKER_BUILDKIT=1 docker build -t ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115 -f .catladder-generated/images/gcloud/Dockerfile .catladder-generated/images/gcloud
            collapseable_section_end "docker-build"
            collapseable_section_start "docker-push" "Pushing image"
            docker push ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
            collapseable_section_end "docker-push"
          shell: bash
    n8n-stop-review:
      name: n8n 🛑 Stop ⚠️ | review
      runs-on: ubuntu-latest
      needs:
        - job-image-gcloud
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review-pr\${{ github.event.number }}-n8n
      env:
        CL_review_n8n_N8N_ENCRYPTION_KEY: \${{ secrets.CL_review_n8n_N8N_ENCRYPTION_KEY }}
        CL_review_n8n_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_review_n8n_GCLOUD_DEPLOY_credentialsKey }}
        CL_review_n8n_GCLOUD_RUN_canonicalHostSuffix: \${{ secrets.CL_review_n8n_GCLOUD_RUN_canonicalHostSuffix }}
        CL_review_n8n_DB_PASSWORD: \${{ secrets.CL_review_n8n_DB_PASSWORD }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
      steps:
        - name: 🛑 Stop ⚠️
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "injectvars" "Injecting variables"
            export CLOUDSDK_CORE_DISABLE_PROMPTS="1"
            collapseable_section_end "injectvars"
            set +e
            gcloud auth activate-service-account --key-file=<(echo "$CL_review_n8n_GCLOUD_DEPLOY_credentialsKey")
            gcloud run services delete $(printf %s "pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n" | awk '{print tolower($0)}') --project=google-project-id --region=europe-west6
            echo "deleting database pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n..."
            echo "👆 this can take multiple attemps (3-5min), because google cloud run may still have a connection to the database after the cloud run service is shut down"

                until gcloud sql databases delete pan-my-n8n-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-n8n --instance=instancename --project projectId
                do
                  echo "Trying again."
                  sleep 10
                done
              
            gcloud artifacts docker images delete europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/review/n8n/$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown") --quiet --delete-tags
            gcloud artifacts docker images list europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/caches/n8n --sort-by=~CREATE_TIME --format="value(version)" | tail -n +2 | while read -r version; do gcloud artifacts docker images delete europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/caches/n8n@$version --quiet --delete-tags; done
            set +e
            gcloud artifacts docker images delete europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-my-n8n-app/review/n8n --quiet --delete-tags
            set -e
            set -e
          shell: bash
catladder-manual.yml:
