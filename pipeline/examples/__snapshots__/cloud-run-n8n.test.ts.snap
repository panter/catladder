      container:
        image: path/to/docker/semantic-release:the-version
      permissions:
        contents: write
      env:
        GITHUB_TOKEN: \${{ github.token }}
      steps:
        - name: Checkout
          uses: actions/checkout@v4
          with:
            fetch-depth: 0
        - name: create release
          run: semanticRelease
          shell: bash
      if: \${{ inputs.job == 'create-release' }}
    n8n-stop-stage:
