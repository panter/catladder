      "www 🛑 Stop ⚠️ | review ": {
        "allow_failure": true,
        "artifacts": {
          "reports": {
            "dotenv": "gitlab_environment.env",
          },
        },
        "environment": {
          "action": "stop",
          "name": "review/$CI_COMMIT_REF_NAME/www",
          "url": "$CL_GITLAB_ENVIRONMENT_URL",
        },
        "image": "path/to/docker/jobs-default:the-version",
        "interruptible": true,
        "needs": [],
