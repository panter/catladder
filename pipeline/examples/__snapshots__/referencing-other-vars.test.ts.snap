  retry: *a1
  interruptible: true
  allow_failure: true
'app1 👮 lint | review ':
  stage: test
  image: path/to/docker/jobs-default:the-version
  variables:
    KUBERNETES_CPU_REQUEST: '0.45'
    KUBERNETES_MEMORY_REQUEST: 1Gi
    KUBERNETES_MEMORY_LIMIT: 4Gi
