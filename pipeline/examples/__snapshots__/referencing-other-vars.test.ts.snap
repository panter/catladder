    - kubernetesDelete
  environment:
    name: review/$CI_COMMIT_REF_NAME/app3
    action: stop
  rules:
    - when: never
      if: $CI_PIPELINE_SOURCE  == "trigger"
    - when: manual
      if: $CI_MERGE_REQUEST_ID
  needs: []
  retry: *a1
  interruptible: true
  allow_failure: true
