    - export HELM_ARGS=""
    - export COMPONENT_NAME="app3"
    - collapseable_section_end "injectvars"
    - kubectl config set-cluster "kube-pan-test-app-prod-app3" --server="$CL_prod_app3_KUBE_URL" --certificate-authority <(echo $CL_prod_app3_KUBE_CA_PEM | base64 -d) --embed-certs=true
    - kubectl config set-credentials "kube-pan-test-app-prod-app3" --token="$CL_prod_app3_KUBE_TOKEN"
    - kubectl config set-context "kube-pan-test-app-prod-app3" --cluster="kube-pan-test-app-prod-app3" --user="kube-pan-test-app-prod-app3" --namespace="pan-test-app-prod"
    - kubectl config use-context "kube-pan-test-app-prod-app3"
    - kubernetesRollback
  environment:
    name: prod/app3
    action: access
  rules:
    - when: never
      if: $CI_PIPELINE_SOURCE  == "trigger"
    - when: manual
      if: $CI_COMMIT_TAG
  needs: []
  retry: *a1
  interruptible: true
  allow_failure: true
create release:
  stage: release
  image: path/to/docker/semantic-release:the-version
  script:
    - semanticRelease
  after_script:
    - echo '👉 If this job failed with access denied, the project access token might be invald - run \`project-renew-token\` in catladder CLI to fix.'
  rules:
    - &a8
      if: $CI_COMMIT_MESSAGE =~ /^chore\\(release\\).*/
      when: never
    - &a9
      if: $CI_PIPELINE_SOURCE  == "trigger"
      when: never
    - &a10
      if: $CI_PIPELINE_SOURCE  == "schedule"
      when: never
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
      when: manual
    - if: $CI_COMMIT_BRANCH =~ /^[0-9]+.([0-9]+|x).x$/
      when: manual
⚠️ force create release:
  stage: release
  image: path/to/docker/semantic-release:the-version
  script:
    - semanticRelease
  after_script:
    - echo '👉 If this job failed with access denied, the project access token might be invald - run \`project-renew-token\` in catladder CLI to fix.'
  rules:
    - *a8
    - *a9
    - *a10
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
      when: manual
    - if: $CI_COMMIT_BRANCH =~ /^[0-9]+.([0-9]+|x).x$/
      when: manual
  needs: []
"
`;
