        - app2/.yarn/install-state.gz
      fallback_keys:
        - app2-node-modules
  rules:
    - when: never
      if: $CI_PIPELINE_SOURCE  == "trigger"
    - if: $CI_MERGE_REQUEST_ID
  needs: []
  retry: *a1
  interruptible: true
'app2 🧪 test | review ':
