        CL_review_app_POSTGRESQL_PASSWORD: \${{ secrets.CL_review_app_POSTGRESQL_PASSWORD }}
        CL_review_app_cloudsqlProxyCredentials: \${{ secrets.CL_review_app_cloudsqlProxyCredentials }}
        CL_JOB_IMAGE: ruby:3.2.1
      steps:
        - name: Checkout
