            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "injectvars" "Injecting variables"
            export APP_DIR="."
            export DOCKER_BUILD_CONTEXT="."
            export DOCKER_REGISTRY="$CL_REGISTRY"
            export DOCKER_CACHE_IMAGE="$CL_REGISTRY_IMAGE/caches/app"
            export DOCKER_IMAGE_NAME="prod/app"
            export DOCKER_IMAGE="$CL_REGISTRY_IMAGE/$DOCKER_IMAGE_NAME"
            export DOCKER_IMAGE_TAG="$GITHUB_SHA"
            collapseable_section_end "injectvars"
            docker login --username gitlab-ci-token --password $CL_JOB_TOKEN $CL_REGISTRY
            cd .
            wget --output-document=- https://github.com/buildpacks/pack/releases/download/v0.36.4/pack-v0.36.4-linux.tgz | tar -zx --directory /usr/local/bin pack
            chmod +x /usr/local/bin/pack
            sed --in-place 's|git@\\([^:]*\\):|https://\\1/|g' Gemfile Gemfile.lock
            pack config registry-mirrors add index.docker.io --mirror mirror.gcr.io
            pack build "$DOCKER_IMAGE:$DOCKER_IMAGE_TAG" --builder 'heroku/builder:24' --publish --cache-image "$DOCKER_CACHE_IMAGE" --env 'SECRET_KEY_BASE=dummy-value' 
          shell: bash
    app-deploy-prod:
      name: app 🚀 Deploy | prod
      runs-on: ubuntu-latest
      needs:
        - app-docker-prod
      container:
        image: path/to/docker/kubernetes:the-version
      environment:
        name: prod-app
        url: \${{ steps.main.outputs.url }}
      env:
        CL_prod_app_SECRET_KEY_BASE: \${{ secrets.CL_prod_app_SECRET_KEY_BASE }}
        CL_prod_app_POSTGRESQL_PASSWORD: \${{ secrets.CL_prod_app_POSTGRESQL_PASSWORD }}
        CL_prod_app_cloudsqlProxyCredentials: \${{ secrets.CL_prod_app_cloudsqlProxyCredentials }}
        CL_JOB_IMAGE: path/to/docker/kubernetes:the-version
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🚀 Deploy
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "injectvars" "Injecting variables"
            export ENV_SHORT="prod"
            export APP_DIR="."
            export ENV_TYPE="prod"
            export BUILD_INFO_BUILD_ID="$(git describe --tags 2>/dev/null || git rev-parse HEAD)"
            export BUILD_INFO_BUILD_TIME="unknown-build-time"
            export BUILD_INFO_CURRENT_VERSION="$(tag=$(git ls-remote origin "refs/tags/v*[0-9]" 2>/dev/null | cut -f 2- | sort -V | tail -1 | sed 's/refs\\/tags\\/v//'); [ -z "$tag" ] && echo "0.0.0" || echo "$tag")"
            export HOSTNAME="my-fancy-website.com"
            export ROOT_URL="https://my-fancy-website.com"
            export HOSTNAME_INTERNAL="app.prod.test-app.pan.panter.cloud"
            export ROOT_URL_INTERNAL="https://app.prod.test-app.pan.panter.cloud"
            export KUBE_NAMESPACE="pan-test-app-prod"
            export KUBE_APP_NAME="app"
            export KUBE_APP_NAME_PREFIX=""
            export SECRET_KEY_BASE="$CL_prod_app_SECRET_KEY_BASE"
            export POSTGRESQL_PASSWORD="$CL_prod_app_POSTGRESQL_PASSWORD"
            export cloudsqlProxyCredentials="$CL_prod_app_cloudsqlProxyCredentials"
            export RAILS_ENV="production"
            export _ALL_ENV_VAR_KEYS="[\\"ENV_SHORT\\",\\"APP_DIR\\",\\"ENV_TYPE\\",\\"BUILD_INFO_BUILD_ID\\",\\"BUILD_INFO_BUILD_TIME\\",\\"BUILD_INFO_CURRENT_VERSION\\",\\"HOSTNAME\\",\\"ROOT_URL\\",\\"HOSTNAME_INTERNAL\\",\\"ROOT_URL_INTERNAL\\",\\"KUBE_NAMESPACE\\",\\"KUBE_APP_NAME\\",\\"KUBE_APP_NAME_PREFIX\\",\\"SECRET_KEY_BASE\\",\\"POSTGRESQL_PASSWORD\\",\\"cloudsqlProxyCredentials\\",\\"RAILS_ENV\\"]"
            export DOCKER_REGISTRY="$CL_REGISTRY"
            export DOCKER_CACHE_IMAGE="$CL_REGISTRY_IMAGE/caches/app"
            export DOCKER_IMAGE_NAME="prod/app"
            export DOCKER_IMAGE="$CL_REGISTRY_IMAGE/$DOCKER_IMAGE_NAME"
            export DOCKER_IMAGE_TAG="$GITHUB_SHA"
            export RELEASE_NAME="pan-test-app-prod-app"
            export HELM_EXPERIMENTAL_OCI="1"
            export KUBE_DOCKER_IMAGE_PULL_SECRET="gitlab-registry-app"
            export HELM_GITLAB_CHART_NAME="/helm-charts/the-panter-chart"
            export HELM_ARGS=""
            export COMPONENT_NAME="app"
            collapseable_section_end "injectvars"
            kubectl config set-cluster "kube-pan-test-app-prod-app" --server="$CL_prod_app_KUBE_URL" --certificate-authority <(echo $CL_prod_app_KUBE_CA_PEM | base64 -d) --embed-certs=true
            kubectl config set-credentials "kube-pan-test-app-prod-app" --token="$CL_prod_app_KUBE_TOKEN"
            kubectl config set-context "kube-pan-test-app-prod-app" --cluster="kube-pan-test-app-prod-app" --user="kube-pan-test-app-prod-app" --namespace="pan-test-app-prod"
            kubectl config use-context "kube-pan-test-app-prod-app"
            collapseable_section_start "writeallvalues" "Write __all_values.yml for helm deployment"
            cat > __all_values.yml <<EOF
            env:
              secret:
                SECRET_KEY_BASE: |-
                  $(printf %s "$CL_prod_app_SECRET_KEY_BASE" | sed '1!s/^/      /')
                POSTGRESQL_PASSWORD: |-
                  $(printf %s "$CL_prod_app_POSTGRESQL_PASSWORD" | sed '1!s/^/      /')
                cloudsqlProxyCredentials: |-
                  $(printf %s "$CL_prod_app_cloudsqlProxyCredentials" | sed '1!s/^/      /')
              public:
                ENV_SHORT: |-
                  prod
                APP_DIR: |-
                  .
                ENV_TYPE: |-
                  prod
                BUILD_INFO_BUILD_ID: |-
                  $(printf %s "$(git describe --tags 2>/dev/null || git rev-parse HEAD)" | sed '1!s/^/      /')
                BUILD_INFO_BUILD_TIME: |-
                  unknown-build-time
                BUILD_INFO_CURRENT_VERSION: |-
                  $(printf %s "$(tag=$(git ls-remote origin "refs/tags/v*[0-9]" 2>/dev/null | cut -f 2- | sort -V | tail -1 | sed 's/refs\\/tags\\/v//'); [ -z "$tag" ] && echo "0.0.0" || echo "$tag")" | sed '1!s/^/      /')
                HOSTNAME: |-
                  my-fancy-website.com
                ROOT_URL: |-
                  https://my-fancy-website.com
                HOSTNAME_INTERNAL: |-
                  app.prod.test-app.pan.panter.cloud
                ROOT_URL_INTERNAL: |-
                  https://app.prod.test-app.pan.panter.cloud
                KUBE_NAMESPACE: |-
                  pan-test-app-prod
                KUBE_APP_NAME: |-
                  app
                KUBE_APP_NAME_PREFIX: ""
                RAILS_ENV: |-
                  production
                _ALL_ENV_VAR_KEYS: |-
                  ["ENV_SHORT","APP_DIR","ENV_TYPE","BUILD_INFO_BUILD_ID","BUILD_INFO_BUILD_TIME","BUILD_INFO_CURRENT_VERSION","HOSTNAME","ROOT_URL","HOSTNAME_INTERNAL","ROOT_URL_INTERNAL","KUBE_NAMESPACE","KUBE_APP_NAME","KUBE_APP_NAME_PREFIX","SECRET_KEY_BASE","POSTGRESQL_PASSWORD","cloudsqlProxyCredentials","RAILS_ENV"]
            application:
              host: |-
                my-fancy-website.com
              livenessProbe:
                httpGet:
                  path: |-
                    __health
              readinessProbe:
                httpGet:
                  path: |-
                    __health
              startupProbe:
                httpGet:
                  path: |-
                    __health
              worker:
                enabled: true
                command: |-
                  launcher bundle exec rake jobs:work
                livenessProbe: false
            cloudsql:
              enabled: true
              dbUser: |-
                postgres
              instanceConnectionName: |-
                myproject:europe-west6:instance-name
              proxyCredentials: |-
                $CL_prod_app_cloudsqlProxyCredentials
              fullDbName: |-
                pan-test-app-prod-app
              type: |-
                unmanaged
            jobs:
              db-migrate:
                hook: |-
                  post-install,post-upgrade
                command: |-
                  launcher bundle exec rake db:migrate

            EOF

            collapseable_section_end "writeallvalues"
            kubernetesCreateSecret
            kubernetesDeploy
            echo deployment successful 😻
            echo "url=$ROOT_URL" >> "$GITHUB_OUTPUT"
          shell: bash
catladder-review-stop.yml:
  name: catladder review stop
  on:
    pull_request:
      types:
        - closed
  env: *a1
  jobs:
    app-stop-review:
      name: app 🛑 Stop ⚠️ | review
      runs-on: ubuntu-latest
      container:
        image: path/to/docker/kubernetes:the-version
      environment:
        name: review-pr\${{ github.event.number }}-app
      env:
        CL_review_app_SECRET_KEY_BASE: \${{ secrets.CL_review_app_SECRET_KEY_BASE }}
        CL_review_app_POSTGRESQL_PASSWORD: \${{ secrets.CL_review_app_POSTGRESQL_PASSWORD }}
        CL_review_app_cloudsqlProxyCredentials: \${{ secrets.CL_review_app_cloudsqlProxyCredentials }}
        CL_JOB_IMAGE: path/to/docker/kubernetes:the-version
      steps:
        - name: 🛑 Stop ⚠️
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "injectvars" "Injecting variables"
            export ENV_SHORT="review"
            export APP_DIR="."
            export ENV_TYPE="review"
            export BUILD_INFO_BUILD_ID="$(git describe --tags 2>/dev/null || git rev-parse HEAD)"
            export BUILD_INFO_BUILD_TIME="unknown-build-time"
            export BUILD_INFO_CURRENT_VERSION="$(tag=$(git ls-remote origin "refs/tags/v*[0-9]" 2>/dev/null | cut -f 2- | sort -V | tail -1 | sed 's/refs\\/tags\\/v//'); [ -z "$tag" ] && echo "0.0.0" || echo "$tag")"
            export HOSTNAME="app.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud"
            export ROOT_URL="https://app.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud"
            export HOSTNAME_INTERNAL="app.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud"
            export ROOT_URL_INTERNAL="https://app.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud"
            export KUBE_NAMESPACE="pan-test-app-review"
            export KUBE_APP_NAME="$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-app"
            export KUBE_APP_NAME_PREFIX="$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-"
            export SECRET_KEY_BASE="$CL_review_app_SECRET_KEY_BASE"
            export POSTGRESQL_PASSWORD="$CL_review_app_POSTGRESQL_PASSWORD"
            export cloudsqlProxyCredentials="$CL_review_app_cloudsqlProxyCredentials"
            export RAILS_ENV="production"
            export _ALL_ENV_VAR_KEYS="[\\"ENV_SHORT\\",\\"APP_DIR\\",\\"ENV_TYPE\\",\\"BUILD_INFO_BUILD_ID\\",\\"BUILD_INFO_BUILD_TIME\\",\\"BUILD_INFO_CURRENT_VERSION\\",\\"HOSTNAME\\",\\"ROOT_URL\\",\\"HOSTNAME_INTERNAL\\",\\"ROOT_URL_INTERNAL\\",\\"KUBE_NAMESPACE\\",\\"KUBE_APP_NAME\\",\\"KUBE_APP_NAME_PREFIX\\",\\"SECRET_KEY_BASE\\",\\"POSTGRESQL_PASSWORD\\",\\"cloudsqlProxyCredentials\\",\\"RAILS_ENV\\"]"
            export RELEASE_NAME="pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-app"
            export HELM_EXPERIMENTAL_OCI="1"
            export KUBE_DOCKER_IMAGE_PULL_SECRET="gitlab-registry-app"
            export HELM_GITLAB_CHART_NAME="/helm-charts/the-panter-chart"
            export HELM_ARGS=""
            export COMPONENT_NAME="app"
            collapseable_section_end "injectvars"
            kubectl config set-cluster "kube-pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-app" --server="$CL_review_app_KUBE_URL" --certificate-authority <(echo $CL_review_app_KUBE_CA_PEM | base64 -d) --embed-certs=true
            kubectl config set-credentials "kube-pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-app" --token="$CL_review_app_KUBE_TOKEN"
            kubectl config set-context "kube-pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-app" --cluster="kube-pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-app" --user="kube-pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-app" --namespace="pan-test-app-review"
            kubectl config use-context "kube-pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-app"
            kubernetesDelete
          shell: bash
catladder-manual.yml:
  name: catladder manual tasks
  on:
    workflow_dispatch:
      inputs:
        job:
          description: the task to run
          required: true
          type: choice
          options:
            - app-stop-dev
            - app-rollback-dev
            - create-release
            - app-rollback-review
            - app-stop-stage
            - app-rollback-stage
            - app-stop-prod
            - app-rollback-prod
  env: *a1
  jobs:
    app-stop-dev:
      name: app 🛑 Stop ⚠️ | dev
      runs-on: ubuntu-latest
      container:
        image: path/to/docker/kubernetes:the-version
      environment:
        name: dev-app
      env:
        CL_dev_app_SECRET_KEY_BASE: \${{ secrets.CL_dev_app_SECRET_KEY_BASE }}
