                  $(printf %s "$CL_stage_app_SECRET_KEY_BASE" | sed '1!s/^/      /')
                POSTGRESQL_PASSWORD: |-
                  $(printf %s "$CL_stage_app_POSTGRESQL_PASSWORD" | sed '1!s/^/      /')
                cloudsqlProxyCredentials: |-
                  $(printf %s "$CL_stage_app_cloudsqlProxyCredentials" | sed '1!s/^/      /')
