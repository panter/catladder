      },
      "app 🛡 audit": {
        "allow_failure": true,
        "image": "ruby:3.2.1",
        "interruptible": true,
        "needs": [],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
