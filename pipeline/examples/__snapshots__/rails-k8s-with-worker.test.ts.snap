          "echo -e "\\e[0Ksection_end:$(date +%s):injectvars\\r\\e[0K"",
          "cd .",
          "bundle config set path 'tmp/cache'",
          "bundle install -j $(nproc)",
          "bundle exec rubocop",
        ],
        "stage": "test",
        "variables": {},
      },
      "app 🔨 docker | review ": {
        "image": "path/to/docker/docker-build:the-version",
