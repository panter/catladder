  variables:
    KUBERNETES_CPU_REQUEST: '0.22'
    KUBERNETES_MEMORY_REQUEST: 200Mi
    KUBERNETES_MEMORY_LIMIT: 400Mi
  script:
    - echo -e "\\e[0Ksection_start:$(date +%s):injectvars[collapsed=true]\\r\\e[0KInjecting variables"
    - export ENV_SHORT="review"
