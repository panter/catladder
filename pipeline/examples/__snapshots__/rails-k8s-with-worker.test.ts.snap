// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`matches snapshot for rails-k8s-with-worker github workflows YAML 1`] = `
"catladder-main.yml:
  name: catladder main
  on:
    push:
      branches:
        - main
  env: &a1
    CL_JOB_TOKEN: \${{ github.token }}
    CL_REGISTRY: ghcr.io
    CL_REGISTRY_IMAGE: ghcr.io/\${{ github.repository }}
    CL_PR_NUMBER: \${{ github.event.number }}
  jobs:
    app-audit-dev:
      name: app 🛡 audit | dev
      runs-on: ubuntu-latest
      container:
        image: ruby:3.2.1
      env:
        CL_dev_app_SECRET_KEY_BASE: \${{ secrets.CL_dev_app_SECRET_KEY_BASE }}
        CL_dev_app_POSTGRESQL_PASSWORD: \${{ secrets.CL_dev_app_POSTGRESQL_PASSWORD }}
        CL_dev_app_cloudsqlProxyCredentials: \${{ secrets.CL_dev_app_cloudsqlProxyCredentials }}
        CL_JOB_IMAGE: ruby:3.2.1
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🛡 audit
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "injectvars" "Injecting variables"
            collapseable_section_end "injectvars"
            cd .
            gem install bundler-audit
            bundle audit check
          shell: bash
    app-lint-dev:
      name: app 👮 lint | dev
      runs-on: ubuntu-latest
      container:
        image: ruby:3.2.1
      env:
        CL_dev_app_SECRET_KEY_BASE: \${{ secrets.CL_dev_app_SECRET_KEY_BASE }}
        CL_dev_app_POSTGRESQL_PASSWORD: \${{ secrets.CL_dev_app_POSTGRESQL_PASSWORD }}
        CL_dev_app_cloudsqlProxyCredentials: \${{ secrets.CL_dev_app_cloudsqlProxyCredentials }}
        CL_JOB_IMAGE: ruby:3.2.1
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 👮 lint
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "injectvars" "Injecting variables"
            collapseable_section_end "injectvars"
            cd .
            bundle config set path 'tmp/cache'
            bundle install -j $(nproc)
            bundle exec rubocop
          shell: bash
    app-test-dev:
      name: app 🧪 test | dev
      runs-on: ubuntu-latest
      container:
        image: ruby:3.2.1
      services:
        database:
          image: docker.io/postgres:latest
          env:
            POSTGRES_HOST_AUTH_METHOD: trust
      env:
        RAILS_ENV: test
        DATABASE_URL: postgresql://postgres@database
        CL_dev_app_SECRET_KEY_BASE: \${{ secrets.CL_dev_app_SECRET_KEY_BASE }}
        CL_dev_app_POSTGRESQL_PASSWORD: \${{ secrets.CL_dev_app_POSTGRESQL_PASSWORD }}
        CL_dev_app_cloudsqlProxyCredentials: \${{ secrets.CL_dev_app_cloudsqlProxyCredentials }}
        CL_JOB_IMAGE: ruby:3.2.1
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🧪 test
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "injectvars" "Injecting variables"
            collapseable_section_end "injectvars"
            cd .
            bundle config set path 'tmp/cache'
            bundle install -j $(nproc)
            bundle exec rake db:test:prepare
            bundle exec rake assets:precompile assets:clean
            bundle exec rspec
          shell: bash
    app-docker-dev:
      name: app 🔨 docker | dev
      runs-on: ubuntu-latest
      container:
        image: path/to/docker/docker-build:the-version
      env:
        DOCKER_BUILDKIT: '1'
        CL_dev_app_SECRET_KEY_BASE: \${{ secrets.CL_dev_app_SECRET_KEY_BASE }}
        CL_dev_app_POSTGRESQL_PASSWORD: \${{ secrets.CL_dev_app_POSTGRESQL_PASSWORD }}
        CL_dev_app_cloudsqlProxyCredentials: \${{ secrets.CL_dev_app_cloudsqlProxyCredentials }}
        CL_JOB_IMAGE: path/to/docker/docker-build:the-version
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🔨 docker
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "injectvars" "Injecting variables"
            export APP_DIR="."
            export DOCKER_BUILD_CONTEXT="."
            export DOCKER_REGISTRY="$CL_REGISTRY"
            export DOCKER_CACHE_IMAGE="$CL_REGISTRY_IMAGE/caches/app"
            export DOCKER_IMAGE_NAME="dev/app"
            export DOCKER_IMAGE="$CL_REGISTRY_IMAGE/$DOCKER_IMAGE_NAME"
            export DOCKER_IMAGE_TAG="$GITHUB_SHA"
            collapseable_section_end "injectvars"
            docker login --username gitlab-ci-token --password $CL_JOB_TOKEN $CL_REGISTRY
            cd .
            wget --output-document=- https://github.com/buildpacks/pack/releases/download/v0.36.4/pack-v0.36.4-linux.tgz | tar -zx --directory /usr/local/bin pack
            chmod +x /usr/local/bin/pack
            sed --in-place 's|git@\\([^:]*\\):|https://\\1/|g' Gemfile Gemfile.lock
            pack config registry-mirrors add index.docker.io --mirror mirror.gcr.io
            pack build "$DOCKER_IMAGE:$DOCKER_IMAGE_TAG" --builder 'heroku/builder:24' --publish --cache-image "$DOCKER_CACHE_IMAGE" --env 'SECRET_KEY_BASE=dummy-value' 
          shell: bash
    app-deploy-dev:
      name: app 🚀 Deploy | dev
      runs-on: ubuntu-latest
      needs:
        - app-audit-dev
        - app-docker-dev
        - app-lint-dev
        - app-test-dev
      container:
        image: path/to/docker/kubernetes:the-version
      environment:
        name: dev-app
        url: \${{ steps.main.outputs.url }}
      env:
        CL_dev_app_SECRET_KEY_BASE: \${{ secrets.CL_dev_app_SECRET_KEY_BASE }}
        CL_dev_app_POSTGRESQL_PASSWORD: \${{ secrets.CL_dev_app_POSTGRESQL_PASSWORD }}
        CL_dev_app_cloudsqlProxyCredentials: \${{ secrets.CL_dev_app_cloudsqlProxyCredentials }}
        CL_JOB_IMAGE: path/to/docker/kubernetes:the-version
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🚀 Deploy
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "injectvars" "Injecting variables"
            export ENV_SHORT="dev"
            export APP_DIR="."
            export ENV_TYPE="dev"
            export BUILD_INFO_BUILD_ID="$(git describe --tags 2>/dev/null || git rev-parse HEAD)"
            export BUILD_INFO_BUILD_TIME="unknown-build-time"
            export BUILD_INFO_CURRENT_VERSION="$(tag=$(git ls-remote origin "refs/tags/v*[0-9]" 2>/dev/null | cut -f 2- | sort -V | tail -1 | sed 's/refs\\/tags\\/v//'); [ -z "$tag" ] && echo "0.0.0" || echo "$tag")"
            export HOSTNAME="app.dev.test-app.pan.panter.cloud"
            export ROOT_URL="https://app.dev.test-app.pan.panter.cloud"
            export HOSTNAME_INTERNAL="app.dev.test-app.pan.panter.cloud"
            export ROOT_URL_INTERNAL="https://app.dev.test-app.pan.panter.cloud"
            export KUBE_NAMESPACE="pan-test-app-dev"
            export KUBE_APP_NAME="app"
            export KUBE_APP_NAME_PREFIX=""
            export SECRET_KEY_BASE="$CL_dev_app_SECRET_KEY_BASE"
            export POSTGRESQL_PASSWORD="$CL_dev_app_POSTGRESQL_PASSWORD"
            export cloudsqlProxyCredentials="$CL_dev_app_cloudsqlProxyCredentials"
            export RAILS_ENV="production"
            export _ALL_ENV_VAR_KEYS="[\\"ENV_SHORT\\",\\"APP_DIR\\",\\"ENV_TYPE\\",\\"BUILD_INFO_BUILD_ID\\",\\"BUILD_INFO_BUILD_TIME\\",\\"BUILD_INFO_CURRENT_VERSION\\",\\"HOSTNAME\\",\\"ROOT_URL\\",\\"HOSTNAME_INTERNAL\\",\\"ROOT_URL_INTERNAL\\",\\"KUBE_NAMESPACE\\",\\"KUBE_APP_NAME\\",\\"KUBE_APP_NAME_PREFIX\\",\\"SECRET_KEY_BASE\\",\\"POSTGRESQL_PASSWORD\\",\\"cloudsqlProxyCredentials\\",\\"RAILS_ENV\\"]"
            export DOCKER_REGISTRY="$CL_REGISTRY"
            export DOCKER_CACHE_IMAGE="$CL_REGISTRY_IMAGE/caches/app"
            export DOCKER_IMAGE_NAME="dev/app"
            export DOCKER_IMAGE="$CL_REGISTRY_IMAGE/$DOCKER_IMAGE_NAME"
            export DOCKER_IMAGE_TAG="$GITHUB_SHA"
            export RELEASE_NAME="pan-test-app-dev-app"
            export HELM_EXPERIMENTAL_OCI="1"
            export KUBE_DOCKER_IMAGE_PULL_SECRET="gitlab-registry-app"
            export HELM_GITLAB_CHART_NAME="/helm-charts/the-panter-chart"
            export HELM_ARGS=""
            export COMPONENT_NAME="app"
            collapseable_section_end "injectvars"
            kubectl config set-cluster "kube-pan-test-app-dev-app" --server="$CL_dev_app_KUBE_URL" --certificate-authority <(echo $CL_dev_app_KUBE_CA_PEM | base64 -d) --embed-certs=true
            kubectl config set-credentials "kube-pan-test-app-dev-app" --token="$CL_dev_app_KUBE_TOKEN"
            kubectl config set-context "kube-pan-test-app-dev-app" --cluster="kube-pan-test-app-dev-app" --user="kube-pan-test-app-dev-app" --namespace="pan-test-app-dev"
            kubectl config use-context "kube-pan-test-app-dev-app"
            collapseable_section_start "writeallvalues" "Write __all_values.yml for helm deployment"
            cat > __all_values.yml <<EOF
            env:
              secret:
                SECRET_KEY_BASE: |-
                  $(printf %s "$CL_dev_app_SECRET_KEY_BASE" | sed '1!s/^/      /')
                POSTGRESQL_PASSWORD: |-
                  $(printf %s "$CL_dev_app_POSTGRESQL_PASSWORD" | sed '1!s/^/      /')
                cloudsqlProxyCredentials: |-
                  $(printf %s "$CL_dev_app_cloudsqlProxyCredentials" | sed '1!s/^/      /')
              public:
                ENV_SHORT: |-
                  dev
                APP_DIR: |-
                  .
                ENV_TYPE: |-
                  dev
                BUILD_INFO_BUILD_ID: |-
                  $(printf %s "$(git describe --tags 2>/dev/null || git rev-parse HEAD)" | sed '1!s/^/      /')
                BUILD_INFO_BUILD_TIME: |-
                  unknown-build-time
                BUILD_INFO_CURRENT_VERSION: |-
                  $(printf %s "$(tag=$(git ls-remote origin "refs/tags/v*[0-9]" 2>/dev/null | cut -f 2- | sort -V | tail -1 | sed 's/refs\\/tags\\/v//'); [ -z "$tag" ] && echo "0.0.0" || echo "$tag")" | sed '1!s/^/      /')
                HOSTNAME: |-
                  app.dev.test-app.pan.panter.cloud
                ROOT_URL: |-
                  https://app.dev.test-app.pan.panter.cloud
                HOSTNAME_INTERNAL: |-
                  app.dev.test-app.pan.panter.cloud
                ROOT_URL_INTERNAL: |-
                  https://app.dev.test-app.pan.panter.cloud
                KUBE_NAMESPACE: |-
                  pan-test-app-dev
                KUBE_APP_NAME: |-
                  app
                KUBE_APP_NAME_PREFIX: ""
                RAILS_ENV: |-
                  production
                _ALL_ENV_VAR_KEYS: |-
                  ["ENV_SHORT","APP_DIR","ENV_TYPE","BUILD_INFO_BUILD_ID","BUILD_INFO_BUILD_TIME","BUILD_INFO_CURRENT_VERSION","HOSTNAME","ROOT_URL","HOSTNAME_INTERNAL","ROOT_URL_INTERNAL","KUBE_NAMESPACE","KUBE_APP_NAME","KUBE_APP_NAME_PREFIX","SECRET_KEY_BASE","POSTGRESQL_PASSWORD","cloudsqlProxyCredentials","RAILS_ENV"]
            application:
              host: |-
                app.dev.test-app.pan.panter.cloud
              livenessProbe:
                httpGet:
                  path: |-
                    __health
              readinessProbe:
                httpGet:
                  path: |-
                    __health
              startupProbe:
                httpGet:
                  path: |-
                    __health
              worker:
                enabled: true
                command: |-
                  launcher bundle exec rake jobs:work
                livenessProbe: false
            cloudsql:
              enabled: true
              dbUser: |-
                postgres
              instanceConnectionName: |-
                myproject:europe-west6:instance-name
              proxyCredentials: |-
                $CL_dev_app_cloudsqlProxyCredentials
              fullDbName: |-
                pan-test-app-dev-app
              type: |-
                unmanaged
            jobs:
              db-migrate:
                hook: |-
                  post-install,post-upgrade
                command: |-
                  launcher bundle exec rake db:migrate

            EOF

            collapseable_section_end "writeallvalues"
            kubernetesCreateSecret
            kubernetesDeploy
            echo deployment successful 😻
            echo "url=$ROOT_URL" >> "$GITHUB_OUTPUT"
          shell: bash
catladder-review.yml:
  name: catladder review
  on:
    pull_request:
      types:
        - opened
        - synchronize
        - reopened
  concurrency:
    group: catladder-review-\${{ github.event.number }}
    cancel-in-progress: true
  env: *a1
  jobs:
    app-audit-review:
      name: app 🛡 audit | review
      runs-on: ubuntu-latest
      container:
        image: ruby:3.2.1
      env:
        CL_review_app_SECRET_KEY_BASE: \${{ secrets.CL_review_app_SECRET_KEY_BASE }}
        CL_review_app_POSTGRESQL_PASSWORD: \${{ secrets.CL_review_app_POSTGRESQL_PASSWORD }}
        CL_review_app_cloudsqlProxyCredentials: \${{ secrets.CL_review_app_cloudsqlProxyCredentials }}
        CL_JOB_IMAGE: ruby:3.2.1
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🛡 audit
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "injectvars" "Injecting variables"
            collapseable_section_end "injectvars"
            cd .
            gem install bundler-audit
            bundle audit check
          shell: bash
    app-lint-review:
      name: app 👮 lint | review
      runs-on: ubuntu-latest
      container:
        image: ruby:3.2.1
