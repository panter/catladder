          "KUBERNETES_MEMORY_REQUEST": "2Gi",
          "LANG": "en_US.UTF-8",
          "LC_A": "L=en_US.UTF-8",
        },
      },
      "app 🧪 test": {
        "cache": [
          {
            "key": "app-yarn",
            "paths": [
