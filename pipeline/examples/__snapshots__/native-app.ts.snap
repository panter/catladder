          {
            "artifacts": false,
            "job": "app 👮 lint",
          },
          {
            "artifacts": true,
            "job": "app 🔨 app | dev ",
          },
          {
            "artifacts": false,
            "job": "app 🧪 test",
          },
          {
            "artifacts": false,
            "job": "app 🛡 audit",
          },
        ],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "rules": [
          {
            "when": "on_success",
          },
        ],
        "script": [
          "cd app",
          "bundle config set --local path 'vendor/ruby'",
          "gem install bundler",
          "bundle install",
          "bundle exec fastlane deploy_test",
        ],
        "stage": "deploy dev",
        "tags": [
          "mac-runner",
        ],
        "variables": {
          "APP_DIR": "app",
          "APP_STORE_CONNECT_API_KEY_CONTENT": "$CL_dev_app_APP_STORE_CONNECT_API_KEY_CONTENT",
          "APP_STORE_CONNECT_API_KEY_ID": "$CL_dev_app_APP_STORE_CONNECT_API_KEY_ID",
          "APP_STORE_CONNECT_ISSUER_ID": "$CL_dev_app_APP_STORE_CONNECT_ISSUER_ID",
          "BUILD_INFO_BUILD_TIME": "01-01-2023 12:13:14",
          "BUILD_INFO_CURRENT_VERSION": "3.2.1",
          "BUILD_INFO_ID": "some-id",
          "ENV_SHORT": "dev",
          "ENV_TYPE": "dev",
          "GRAPHQL_URL": "https://pan-test-app-dev-api-unknown-host.example.com/graphql",
          "HOST": "unknown-host.example.com",
          "KUBERNETES_CPU_LIMIT": "1",
          "KUBERNETES_CPU_REQUEST": "0.5",
          "KUBERNETES_MEMORY_LIMIT": "400Mi",
          "KUBERNETES_MEMORY_REQUEST": "200Mi",
          "LANG": "en_US.UTF-8",
          "LC_A": "L=en_US.UTF-8",
          "ROOT_URL": "https://unknown-host.example.com",
          "_ALL_ENV_VAR_KEYS": "["ENV_SHORT","APP_DIR","ENV_TYPE","BUILD_INFO_ID","BUILD_INFO_BUILD_TIME","BUILD_INFO_CURRENT_VERSION","HOST","ROOT_URL","APP_STORE_CONNECT_API_KEY_CONTENT","APP_STORE_CONNECT_ISSUER_ID","APP_STORE_CONNECT_API_KEY_ID","GRAPHQL_URL"]",
        },
      },
      "app 🛡 audit": {
        "allow_failure": true,
        "interruptible": true,
