        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "script": [
          "trivy fs --quiet --format cyclonedx --output "__sbom.json" app",
        ],
        "stage": "verify",
        "variables": {},
      },
