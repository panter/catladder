      "worker 🔨 docker | prod ": {
        "cache": [
          {
            "key": "api-yarn",
            "paths": [
              "api/.yarn",
            ],
            "policy": "pull",
          },
        ],
        "image": "path/to/docker/docker-build:the-version",
        "interruptible": true,
        "needs": [
          "worker 🔨 app | prod ",
        ],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "script": [
          "ensureNodeDockerfile",
          "docker login --username gitlab-ci-token --password $CI_JOB_TOKEN $CI_REGISTRY",
          "docker version",
          "docker build --network host --cache-from $DOCKER_CACHE_IMAGE --tag $DOCKER_IMAGE:$DOCKER_IMAGE_TAG -f $APP_DIR/Dockerfile . --build-arg BUILDKIT_INLINE_CACHE=1",
          "docker push $DOCKER_IMAGE:$DOCKER_IMAGE_TAG",
          "docker tag $DOCKER_IMAGE:$DOCKER_IMAGE_TAG $DOCKER_CACHE_IMAGE",
          "docker push $DOCKER_CACHE_IMAGE",
        ],
        "services": [
          {
            "command": [
              "--tls=false",
            ],
            "name": "docker:20-dind",
          },
        ],
        "stage": "build",
        "variables": {
          "APP_DIR": "api",
          "DOCKERFILE_ADDITIONS": undefined,
          "DOCKERFILE_ADDITIONS_END": undefined,
          "DOCKER_BUILDKIT": "1",
          "DOCKER_CACHE_IMAGE": "$DOCKER_REGISTRY_IMAGE_PATH/caches/worker",
          "DOCKER_COPY_AND_INSTALL_APP": "COPY --chown=node:node $APP_DIR .
RUN yarn plugin import workspace-tools
RUN yarn workspaces focus --production && yarn rebuild",
          "DOCKER_COPY_WORKSPACE_FILES": "COPY --chown=node:node api/package.json /app/api/package.json
COPY --chown=node:node api/yarn.lock /app/api/yarn.lock
COPY --chown=node:node .yarnrc.yml /app/.yarnrc.yml
COPY --chown=node:node .yarn /app/.yarn",
          "DOCKER_DIR": ".",
          "DOCKER_DRIVER": "overlay2",
          "DOCKER_HOST": "tcp://0.0.0.0:2375",
          "DOCKER_IMAGE": "$DOCKER_REGISTRY_IMAGE_PATH/$DOCKER_IMAGE_NAME",
          "DOCKER_IMAGE_NAME": "prod/worker",
          "DOCKER_IMAGE_TAG": "$CI_COMMIT_SHA",
          "DOCKER_REGISTRY": "$CI_REGISTRY",
          "DOCKER_REGISTRY_IMAGE_PATH": "$CI_REGISTRY_IMAGE",
          "DOCKER_TLS_CERTDIR": "",
          "KUBERNETES_CPU_LIMIT": "1",
          "KUBERNETES_CPU_REQUEST": "0.5",
          "KUBERNETES_MEMORY_LIMIT": "2Gi",
          "KUBERNETES_MEMORY_REQUEST": "1Gi",
        },
      },
