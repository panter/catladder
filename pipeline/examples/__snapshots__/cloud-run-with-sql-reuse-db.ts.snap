      "worker 🚀 Deploy | prod ": {
        "allow_failure": true,
        "artifacts": {
          "paths": [
            "____envvars.yaml",
          ],
        },
        "environment": {
          "auto_stop_in": undefined,
          "name": "prod/worker",
          "on_stop": "worker 🛑 Stop ⚠️ | prod ",
          "url": "https://pan-test-app-prod-worker-unknown-host.example.com",
        },
        "image": "path/to/docker/gcloud:the-version",
        "interruptible": true,
        "needs": [
          {
            "artifacts": false,
            "job": "worker 🔨 app | prod ",
          },
          {
            "artifacts": false,
            "job": "worker 🔨 docker | prod ",
          },
          {
            "artifacts": true,
            "job": "worker 🧾 sbom | prod ",
          },
        ],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "rules": [
          {
            "when": "manual",
          },
        ],
        "script": [
          "echo -e "\\e[0Ksection_start:$(date +%s):prepare[collapsed=true]\\r\\e[0KPrepare..."",
          "echo $CL_prod_worker_GCLOUD_DEPLOY_credentialsKey > ./____keyfile.json
          ",
          "gcloud auth activate-service-account --key-file="./____keyfile.json"",
          "export GCLOUD_PROJECT_NUMBER=$(gcloud projects describe google-project-id --format="value(projectNumber)")",
          "echo "GCLOUD_PROJECT_NUMBER: $GCLOUD_PROJECT_NUMBER"",
          "echo -e "\\e[0Ksection_end:$(date +%s):prepare\\r\\e[0K"",
          "echo -e "\\e[0Ksection_start:$(date +%s):pushToArtifactRegistry[collapsed=true]\\r\\e[0KPushing image to artifacts registry"",
          "docker login --username gitlab-ci-token --password $CI_JOB_TOKEN $CI_REGISTRY",
          "gcloud auth configure-docker europe-west6-docker.pkg.dev",
          "docker pull $DOCKER_IMAGE:$DOCKER_IMAGE_TAG",
          "docker tag $DOCKER_IMAGE:$DOCKER_IMAGE_TAG europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-test-app/prod/worker:$DOCKER_IMAGE_TAG",
          "docker push europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-test-app/prod/worker:$DOCKER_IMAGE_TAG",
          "echo -e "\\e[0Ksection_end:$(date +%s):pushToArtifactRegistry\\r\\e[0K"",
          "echo -e "\\e[0Ksection_start:$(date +%s):deploy[collapsed=true]\\r\\e[0KDeploy to cloud run"",
          "echo "$ENV_VARS" > ____envvars.yaml",
          "set +e",
          "echo "ensuring Database..."",
          "gcloud sql databases create pan-test-app-prod-api --instance=instancename --project projectId",
          "set -e",
          "gcloud run deploy pan-test-app-prod-worker --command="yarn,start" --image=europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-test-app/prod/worker:$DOCKER_IMAGE_TAG --project=google-project-id --region=europe-west6 --set-cloudsql-instances=projectId:region:instancename --labels=customer-name=pan,component-name=worker,app-name=test-app,env-type=prod,env-name=prod,build-type=node --env-vars-file=____envvars.yaml --min-instances=0 --max-instances=100 --cpu-throttling --allow-unauthenticated --cpu-boost",
