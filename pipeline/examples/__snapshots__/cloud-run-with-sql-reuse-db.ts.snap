BUILD_INFO_BUILD_TIME: '01-01-2023 12:13:14'
BUILD_INFO_CURRENT_VERSION: '3.2.1'
HOST: 'pan-test-app-stage-api-unknown-host.example.com'
ROOT_URL: 'https://pan-test-app-stage-api-unknown-host.example.com'
