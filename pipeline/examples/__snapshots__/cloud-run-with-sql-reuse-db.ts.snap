          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "rules": [
          {
            "when": "on_success",
          },
        ],
        "script": [
          "echo $CL_stage_worker_GCLOUD_DEPLOY_credentialsKey > ./____keyfile.json
          ",
          "gcloud auth activate-service-account --key-file="./____keyfile.json"",
          "export GCLOUD_PROJECT_NUMBER=$(gcloud projects describe google-project-id --format="value(projectNumber)")",
          "echo "GCLOUD_PROJECT_NUMBER: $GCLOUD_PROJECT_NUMBER"",
          "docker login --username gitlab-ci-token --password $CI_JOB_TOKEN $CI_REGISTRY",
          "gcloud auth configure-docker europe-west6-docker.pkg.dev",
          "docker pull $DOCKER_IMAGE:$DOCKER_IMAGE_TAG",
          "docker tag $DOCKER_IMAGE:$DOCKER_IMAGE_TAG europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-test-app/$DOCKER_IMAGE_NAME:$DOCKER_IMAGE_TAG",
          "docker push europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-test-app/$DOCKER_IMAGE_NAME:$DOCKER_IMAGE_TAG",
          "echo "$ENV_VARS" > ____envvars.yaml",
          "set +e",
          "echo "ensuring Database..."",
          "gcloud sql databases create pan-test-app-stage-api --instance=instancename --project projectId",
          "set -e",
          "gcloud run deploy pan-test-app-stage-worker --command="yarn,start" --image=europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-test-app/$DOCKER_IMAGE_NAME:$DOCKER_IMAGE_TAG --project=google-project-id --region=europe-west6 --set-cloudsql-instances=projectId:region:instancename --labels=customer-name=pan,app-name=test-app,env-type=stage,env-name=stage,build-type=node --env-vars-file=____envvars.yaml --min-instances=0 --max-instances=100 --cpu-throttling --allow-unauthenticated",
          "docker image rm europe-west6-docker.pkg.dev/google-project-id/catladder-deploy/pan-test-app/$DOCKER_IMAGE_NAME:$DOCKER_IMAGE_TAG",
        ],
        "services": [
          {
            "command": [
              "--tls=false",
            ],
            "name": "docker:20-dind",
          },
        ],
        "stage": "deploy stage",
        "variables": {
          "APP_DIR": "api",
          "CLOUDSDK_CORE_DISABLE_PROMPTS": "1",
          "CLOUD_SQL_INSTANCE_CONNECTION_NAME": "projectId:region:instancename",
          "DATABASE_JDBC_URL": "jdbc:postgresql:///$DB_NAME?cloudSqlInstance=$CLOUD_SQL_INSTANCE_CONNECTION_NAME&socketFactory=com.google.cloud.sql.postgres.SocketFactory&user=$DB_USER&password=$DB_PASSWORD",
          "DATABASE_URL": "postgresql://$DB_USER:$DB_PASSWORD@localhost/$DB_NAME?host=/cloudsql/$CLOUD_SQL_INSTANCE_CONNECTION_NAME",
          "DB_NAME": "pan-test-app-stage-api",
          "DB_PASSWORD": "$CL_stage_api_DB_PASSWORD",
          "DB_USER": "my-user",
          "DOCKER_BUILDKIT": "1",
          "DOCKER_CACHE_IMAGE": "$DOCKER_REGISTRY_IMAGE_PATH/caches/worker",
          "DOCKER_DRIVER": "overlay2",
          "DOCKER_HOST": "tcp://0.0.0.0:2375",
          "DOCKER_IMAGE": "$DOCKER_REGISTRY_IMAGE_PATH/$DOCKER_IMAGE_NAME",
          "DOCKER_IMAGE_NAME": "stage/worker",
          "DOCKER_IMAGE_TAG": "$CI_COMMIT_SHA",
          "DOCKER_REGISTRY": "$CI_REGISTRY",
          "DOCKER_REGISTRY_IMAGE_PATH": "$CI_REGISTRY_IMAGE",
          "DOCKER_TLS_CERTDIR": "",
          "ENV_SHORT": "stage",
          "ENV_TYPE": "stage",
          "ENV_VARS": "ENV_SHORT: 'stage'
APP_DIR: 'api'
ENV_TYPE: 'stage'
HOST: 'pan-test-app-stage-worker-unknown-host.example.com'
ROOT_URL: 'https://pan-test-app-stage-worker-unknown-host.example.com'
HOST_CANONICAL: 'pan-test-app-stage-worker-unknown-host.example.com'
CLOUD_SQL_INSTANCE_CONNECTION_NAME: 'projectId:region:instancename'
DB_NAME: 'pan-test-app-stage-api'
DB_USER: 'my-user'
DB_PASSWORD: '$CL_stage_api_DB_PASSWORD'
DATABASE_URL: 'postgresql://$DB_USER:$DB_PASSWORD@localhost/$DB_NAME?host=/cloudsql/$CLOUD_SQL_INSTANCE_CONNECTION_NAME'
DATABASE_JDBC_URL: 'jdbc:postgresql:///$DB_NAME?cloudSqlInstance=$CLOUD_SQL_INSTANCE_CONNECTION_NAME&socketFactory=com.google.cloud.sql.postgres.SocketFactory&user=$DB_USER&password=$DB_PASSWORD'
_ALL_ENV_VAR_KEYS: '["ENV_SHORT","APP_DIR","ENV_TYPE","HOST","ROOT_URL","HOST_CANONICAL","CLOUD_SQL_INSTANCE_CONNECTION_NAME","DB_NAME","DB_USER","DB_PASSWORD","DATABASE_URL","DATABASE_JDBC_URL","GCLOUD_DEPLOY_credentialsKey"]'
",
          "GCLOUD_DEPLOY_credentialsKey": "$CL_stage_worker_GCLOUD_DEPLOY_credentialsKey",
          "HOST": "pan-test-app-stage-worker-unknown-host.example.com",
          "HOST_CANONICAL": "pan-test-app-stage-worker-unknown-host.example.com",
          "KUBERNETES_CPU_LIMIT": "1",
          "KUBERNETES_CPU_REQUEST": "0.5",
          "KUBERNETES_MEMORY_LIMIT": "500Mi",
          "KUBERNETES_MEMORY_REQUEST": "200Mi",
          "ROOT_URL": "https://pan-test-app-stage-worker-unknown-host.example.com",
          "_ALL_ENV_VAR_KEYS": "["ENV_SHORT","APP_DIR","ENV_TYPE","HOST","ROOT_URL","HOST_CANONICAL","CLOUD_SQL_INSTANCE_CONNECTION_NAME","DB_NAME","DB_USER","DB_PASSWORD","DATABASE_URL","DATABASE_JDBC_URL","GCLOUD_DEPLOY_credentialsKey"]",
        },
      },
      "worker 🛑 Stop ⚠️ | prod ": {
        "environment": {
          "action": "stop",
          "name": "prod/worker",
          "url": "https://pan-test-app-prod-worker-unknown-host.example.com",
        },
        "image": "path/to/docker/gcloud:the-version",
        "interruptible": true,
        "needs": [],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "rules": [
          {
            "allow_failure": true,
            "if": "$CI_COMMIT_BRANCH =~ /^[0-9]+\\.([0-9]+|x)\\.x$/",
            "when": "on_success",
          },
          {
            "allow_failure": true,
            "when": "manual",
          },
        ],
        "script": [
          "echo $CL_prod_worker_GCLOUD_DEPLOY_credentialsKey > ./____keyfile.json
          ",
          "gcloud auth activate-service-account --key-file="./____keyfile.json"",
          "gcloud run services delete pan-test-app-prod-worker --project=google-project-id --region=europe-west6",
        ],
        "stage": "stop prod",
        "variables": {
          "CLOUDSDK_CORE_DISABLE_PROMPTS": "1",
          "GIT_STRATEGY": "none",
          "KUBERNETES_CPU_LIMIT": "1",
          "KUBERNETES_CPU_REQUEST": "0.5",
          "KUBERNETES_MEMORY_LIMIT": "500Mi",
          "KUBERNETES_MEMORY_REQUEST": "200Mi",
        },
      },
      "worker 🛑 Stop ⚠️ | stage ": {
        "environment": {
          "action": "stop",
          "name": "stage/worker",
          "url": "https://pan-test-app-stage-worker-unknown-host.example.com",
        },
        "image": "path/to/docker/gcloud:the-version",
        "interruptible": true,
        "needs": [],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "rules": [
          {
            "allow_failure": true,
            "if": "$CI_COMMIT_BRANCH =~ /^[0-9]+\\.([0-9]+|x)\\.x$/",
            "when": "on_success",
          },
          {
            "allow_failure": true,
            "when": "manual",
          },
        ],
        "script": [
          "echo $CL_stage_worker_GCLOUD_DEPLOY_credentialsKey > ./____keyfile.json
          ",
          "gcloud auth activate-service-account --key-file="./____keyfile.json"",
          "gcloud run services delete pan-test-app-stage-worker --project=google-project-id --region=europe-west6",
        ],
        "stage": "stop stage",
        "variables": {
          "CLOUDSDK_CORE_DISABLE_PROMPTS": "1",
          "GIT_STRATEGY": "none",
          "KUBERNETES_CPU_LIMIT": "1",
          "KUBERNETES_CPU_REQUEST": "0.5",
          "KUBERNETES_MEMORY_LIMIT": "500Mi",
          "KUBERNETES_MEMORY_REQUEST": "200Mi",
        },
      },
    },
    "stages": [
      "setup",
      "setup dev",
      "setup review",
      "setup stage",
      "setup prod",
      "setup local",
      "test",
      "test dev",
      "test review",
      "test stage",
      "test prod",
      "test local",
      "build",
      "build dev",
      "build review",
      "build stage",
      "build prod",
      "build local",
      "deploy",
      "deploy dev",
      "deploy review",
      "deploy stage",
      "deploy prod",
      "deploy local",
      "verify",
      "verify dev",
      "verify review",
      "verify stage",
      "verify prod",
      "verify local",
      "rollback",
      "rollback dev",
      "rollback review",
      "rollback stage",
      "rollback prod",
      "rollback local",
      "stop",
      "stop dev",
      "stop review",
      "stop stage",
      "stop prod",
      "stop local",
    ],
    "variables": {
      "FF_USE_FASTZIP": "true",
    },
    "workflow": {
      "rules": [
        {
          "if": "$CI_COMMIT_TAG",
        },
        {
          "if": "$CI_COMMIT_MESSAGE =~ /^chore\\(release\\).*/",
          "when": "never",
        },
        {
          "if": "$CI_COMMIT_BRANCH =~ /^[0-9]+.([0-9]+|x).x$/",
        },
        {
          "if": "$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH",
        },
        {
          "if": "$CI_MERGE_REQUEST_ID",
        },
      ],
    },
  },
}
`;
