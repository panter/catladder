          "KUBERNETES_MEMORY_REQUEST": "200Mi",
          "ROOT_URL": "https://pan-test-app-stage-app-unknown-host.example.com",
          "_ALL_ENV_VAR_KEYS": "["ENV_SHORT","APP_DIR","ENV_TYPE","BUILD_INFO_ID","BUILD_INFO_BUILD_TIME","BUILD_INFO_CURRENT_VERSION","HOST","ROOT_URL","HOST_CANONICAL","GCLOUD_DEPLOY_credentialsKey","GCLOUD_RUN_canonicalHostSuffix"]",
        },
      },
      "app 🛑 Stop ⚠️ | prod ": {
        "environment": {
          "action": "stop",
          "name": "prod/app",
          "url": "https://pan-test-app-prod-app-unknown-host.example.com",
        },
        "image": "path/to/docker/gcloud:the-version",
        "interruptible": true,
        "needs": [],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "rules": [
          {
            "allow_failure": true,
            "if": "$CI_COMMIT_BRANCH =~ /^[0-9]+\\.([0-9]+|x)\\.x$/",
            "when": "on_success",
          },
          {
            "allow_failure": true,
            "when": "manual",
          },
        ],
        "script": [
          "set +e",
          "echo $CL_prod_app_GCLOUD_DEPLOY_credentialsKey > ./____keyfile.json
          ",
          "gcloud auth activate-service-account --key-file="./____keyfile.json"",
          "gcloud run services delete pan-test-app-prod-app --project=asdf --region=asia-east1",
          "echo Disabling component in Dependency Track",
          "/dtrackuploader https://dep.panter.swiss/ "$DT_KEY_PROD" disable "pan-test-app/app" "https://pan-test-app-prod-app-unknown-host.example.com" || true",
          "set -e",
        ],
        "stage": "stop prod",
        "variables": {
          "CLOUDSDK_CORE_DISABLE_PROMPTS": "1",
          "GIT_STRATEGY": "none",
          "KUBERNETES_CPU_LIMIT": "1",
          "KUBERNETES_CPU_REQUEST": "0.5",
          "KUBERNETES_MEMORY_LIMIT": "400Mi",
          "KUBERNETES_MEMORY_REQUEST": "200Mi",
