        "interruptible": true,
        "needs": [
          {
            "artifacts": false,
            "job": "api 🔨 app | stage ",
          },
          {
            "artifacts": false,
            "job": "api 🔨 docker | stage ",
          },
          {
            "artifacts": true,
            "job": "api 🧾 sbom | stage ",
          },
        ],
        "retry": {
          "max": 2,
