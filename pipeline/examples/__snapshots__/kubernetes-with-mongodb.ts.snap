          "echo -e "\\e[0Ksection_end:$(date +%s):nodeinstall\\r\\e[0K"",
          "cd api",
          "echo -e "\\e[0Ksection_start:$(date +%s):nodeinstall[collapsed=true]\\r\\e[0KEnsure node version"",
          "if [ -f ~/.nvm/nvm.sh ];  then source ~/.nvm/nvm.sh; fi",
