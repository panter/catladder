  rules:
    - if: $CI_COMMIT_BRANCH =~ /^[0-9]+\\.([0-9]+|x)\\.x$/
      when: on_success
    - when: manual
      if: $CI_COMMIT_TAG
  needs: []
  retry: *a1
  interruptible: true
  allow_failure: true
