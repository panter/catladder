        asia-east1
      foo: |-
        foo-value
      multiline: |-
        app1 line1
        app1 line2
        app1 line3  
        
        the url of self: "$(printf %s "https://$(printf %s "pan-test-app-review-$([ -n "$CI_MERGE_REQUEST_IID" ] && echo "mr$CI_MERGE_REQUEST_IID" || { [ -n "$CI_COMMIT_REF_SLUG" ] && echo "$CI_COMMIT_REF_SLUG" || echo "unknown"; })-app1-123456789012.asia-east1.run.app" | awk '{print tolower($0)}')" | sed '1!s/^/  /')"
        
        
