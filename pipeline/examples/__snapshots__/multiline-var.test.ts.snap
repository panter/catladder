    - export BUILD_INFO_BUILD_ID="$(git describe --tags 2>/dev/null || git rev-parse HEAD)"
    - export BUILD_INFO_BUILD_TIME="$CI_JOB_STARTED_AT"
    - export BUILD_INFO_CURRENT_VERSION="$(tag=$(git ls-remote origin "refs/tags/v*[0-9]" 2>/dev/null | cut -f 2- | sort -V | tail -1 | sed 's/refs\\/tags\\/v//'); [ -z "$tag" ] && echo "0.0.0" || echo "$tag")"
    - export HOSTNAME="kube.prod.test-app.pan.panter.cloud"
    - export ROOT_URL="https://kube.prod.test-app.pan.panter.cloud"
    - export HOSTNAME_INTERNAL="kube.prod.test-app.pan.panter.cloud"
    - export ROOT_URL_INTERNAL="https://kube.prod.test-app.pan.panter.cloud"
    - export KUBE_NAMESPACE="pan-test-app-prod"
    - export KUBE_APP_NAME="kube"
    - export KUBE_APP_NAME_PREFIX=""
    - |-
      export multiline_from_app1="app1 line1
      app1 line2
      app1 line3  

      the url of self: \\"https://pan-test-app-prod-app1-123456789012.asia-east1.run.app\\"


      app1 single quote: '
      app1 doouble quote: \\"
      "
    - |-
      export multiline="kube yeah
      kube yeah2
      kube yeah3  

      kube single quote: '
      kube doouble quote: \\"

      the url of self: \\"https://kube.prod.test-app.pan.panter.cloud\\"
      the url of app1: \\"https://pan-test-app-prod-app1-123456789012.asia-east1.run.app\\"

      value from app1:
      -------
      app1 line1
