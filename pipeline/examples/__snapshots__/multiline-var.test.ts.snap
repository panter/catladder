      HOSTNAME_INTERNAL: |-
        $(printf %s "$(printf %s "pan-test-app-review-$([ -n "$CI_MERGE_REQUEST_IID" ] && echo "mr$CI_MERGE_REQUEST_IID" || { [ -n "$CI_COMMIT_REF_SLUG" ] && echo "$CI_COMMIT_REF_SLUG" || echo "unknown"; })-app1-123456789012.asia-east1.run.app" | awk '{print tolower($0)}')" | sed '1!s/^/  /')
      ROOT_URL_INTERNAL: |-
        $(printf %s "https://$(printf %s "pan-test-app-review-$([ -n "$CI_MERGE_REQUEST_IID" ] && echo "mr$CI_MERGE_REQUEST_IID" || { [ -n "$CI_COMMIT_REF_SLUG" ] && echo "$CI_COMMIT_REF_SLUG" || echo "unknown"; })-app1-123456789012.asia-east1.run.app" | awk '{print tolower($0)}')" | sed '1!s/^/  /')
      DEPLOY_CLOUD_RUN_SERVICE_NAME: |-
        $(printf %s "$(printf %s "pan-test-app-review-$([ -n "$CI_MERGE_REQUEST_IID" ] && echo "mr$CI_MERGE_REQUEST_IID" || { [ -n "$CI_COMMIT_REF_SLUG" ] && echo "$CI_COMMIT_REF_SLUG" || echo "unknown"; })-app1" | awk '{print tolower($0)}')" | sed '1!s/^/  /')
      DEPLOY_CLOUD_RUN_PROJECT_ID: |-
        asdf
