    create-release:
      name: create release
      runs-on: ubuntu-latest
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/semantic-release:a6394dac9ab5
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      permissions:
        contents: write
      needs:
        - job-image-semantic-release
      env:
        GITHUB_TOKEN: \${{ github.token }}
      steps:
        - name: Checkout
          uses: actions/checkout@v4
          with:
            fetch-depth: 0
        - name: create release
          run: semanticRelease
          shell: bash
      if: \${{ inputs.job == 'create-release' }}
