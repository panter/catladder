    - job: 'app1 🔨 app | review '
      artifacts: false
    - job: 'app1 🔨 docker | review '
      artifacts: false
    - job: 'app1 🧪 test | review '
      artifacts: false
    - job: 'app1 🛡 audit | review '
      artifacts: false
  retry: *a1
  interruptible: true
  allow_failure: false
'app1 🛑 Stop ⚠️ | review ':
  stage: stop review
  image: path/to/docker/gcloud:the-version
  variables:
    KUBERNETES_CPU_REQUEST: '0.22'
    KUBERNETES_MEMORY_REQUEST: 200Mi
    KUBERNETES_MEMORY_LIMIT: 400Mi
    GIT_STRATEGY: none
