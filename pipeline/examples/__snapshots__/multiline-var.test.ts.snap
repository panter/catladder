application:
  host: |-
    $(printf %s "kube.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud" | sed '1!s/^/    /')
  command: |-
    yarn start
