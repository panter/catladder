    app1-app-stage:
      name: app1 🔨 app | stage
      runs-on: ubuntu-latest
      needs:
        - job-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      env:
        CL_stage_app1_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_stage_app1_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app1-yarn
          uses: actions/cache@v4
          with:
            path: app1/.yarn
            key: app1-yarn-\${{ github.run_id }}
            restore-keys: app1-yarn-
        - name: Cache app1-node-modules
          uses: actions/cache@v4
          with:
            path: |-
              app1/node_modules
              app1/.yarn/install-state.gz
            key: app1-node-modules-\${{ github.run_id }}
            restore-keys: app1-node-modules-
        - name: 🔨 app
          id: main
          run: bash .catladder-generated/github/scripts/app1-app-stage.sh
          shell: bash
        - name: Upload artifacts
          uses: actions/upload-artifact@v4
          with:
            name: app1-app-stage
            path: |-
              app1/__build_info.json
              app1/.next
              app1/dist
            if-no-files-found: warn
            include-hidden-files: true
    app1-docker-stage:
      name: app1 🔨 docker | stage
      runs-on: ubuntu-latest
      needs:
        - app1-app-stage
        - job-image-docker-build
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/docker-build:d97f1ac6c3c5
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      env:
        DOCKER_BUILDKIT: '1'
        CL_stage_app1_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_stage_app1_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/docker-build:d97f1ac6c3c5
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app1-yarn
          uses: actions/cache/restore@v4
          with:
            path: app1/.yarn
            key: app1-yarn-\${{ github.run_id }}
            restore-keys: app1-yarn-
        - name: Download artifacts from app1-app-stage
          uses: actions/download-artifact@v4
          with:
            name: app1-app-stage
        - name: 🔨 docker
          id: main
          run: bash .catladder-generated/github/scripts/app1-docker-stage.sh
          shell: bash
    app1-deploy-stage:
      name: app1 🚀 Deploy | stage
      runs-on: ubuntu-latest
      needs:
        - app1-app-stage
        - app1-docker-stage
        - job-image-gcloud
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: stage-app1
        url: \${{ steps.main.outputs.url }}
      env:
        CL_stage_app1_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_stage_app1_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🚀 Deploy
          id: main
          run: bash .catladder-generated/github/scripts/app1-deploy-stage.sh
          shell: bash
    app1-app-prod:
      name: app1 🔨 app | prod
      runs-on: ubuntu-latest
