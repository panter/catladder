      the url of app1: "$(printf %s "https://$(printf %s "pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-app1-123456789012.asia-east1.run.app" | awk '{print tolower($0)}')" | sed '1!s/^/      /')"
      
