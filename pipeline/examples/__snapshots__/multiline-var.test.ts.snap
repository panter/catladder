              app2/.yarn/install-state.gz
            key: app2-node-modules-\${{ github.run_id }}
            restore-keys: app2-node-modules-
        - name: 🔨 app
          id: main
          run: bash .catladder-generated/github/scripts/app2-app-dev.sh
          shell: bash
        - name: Upload artifacts
          uses: actions/upload-artifact@v4
          with:
            name: app2-app-dev
            path: |-
              app2/__build_info.json
              app2/.next
              app2/dist
            if-no-files-found: warn
            include-hidden-files: true
