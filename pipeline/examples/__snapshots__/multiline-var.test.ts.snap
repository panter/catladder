    app1-audit-dev:
      name: app1 🛡 audit | dev
      runs-on: ubuntu-latest
      needs:
        - job-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      env:
        CL_dev_app1_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_dev_app1_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🛡 audit
          id: main
          run: bash .catladder-generated/github/scripts/app1-audit-dev.sh
          shell: bash
    app1-lint-dev:
      name: app1 👮 lint | dev
      runs-on: ubuntu-latest
      needs:
        - job-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      env:
        CL_dev_app1_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_dev_app1_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app1-yarn
          uses: actions/cache@v4
          with:
            path: app1/.yarn
            key: app1-yarn-\${{ github.run_id }}
            restore-keys: app1-yarn-
        - name: Cache app1-node-modules
          uses: actions/cache@v4
          with:
            path: |-
              app1/node_modules
              app1/.yarn/install-state.gz
            key: app1-node-modules-\${{ github.run_id }}
            restore-keys: app1-node-modules-
        - name: 👮 lint
          id: main
          run: bash .catladder-generated/github/scripts/app1-lint-dev.sh
          shell: bash
    app1-test-dev:
      name: app1 🧪 test | dev
      runs-on: ubuntu-latest
      needs:
        - job-image-jobs-testing-chrome
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-testing-chrome:c9799d0c3dc3
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      env:
        CL_dev_app1_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_dev_app1_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-testing-chrome:c9799d0c3dc3
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app1-yarn
          uses: actions/cache@v4
          with:
            path: app1/.yarn
            key: app1-yarn-\${{ github.run_id }}
            restore-keys: app1-yarn-
        - name: Cache app1-node-modules
          uses: actions/cache@v4
          with:
            path: |-
              app1/node_modules
              app1/.yarn/install-state.gz
            key: app1-node-modules-\${{ github.run_id }}
            restore-keys: app1-node-modules-
        - name: 🧪 test
          id: main
          run: bash .catladder-generated/github/scripts/app1-test-dev.sh
          shell: bash
    app1-app-dev:
      name: app1 🔨 app | dev
      runs-on: ubuntu-latest
      needs:
        - job-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      env:
        CL_dev_app1_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_dev_app1_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app1-yarn
          uses: actions/cache@v4
          with:
            path: app1/.yarn
            key: app1-yarn-\${{ github.run_id }}
            restore-keys: app1-yarn-
        - name: Cache app1-node-modules
          uses: actions/cache@v4
          with:
            path: |-
              app1/node_modules
              app1/.yarn/install-state.gz
            key: app1-node-modules-\${{ github.run_id }}
            restore-keys: app1-node-modules-
        - name: 🔨 app
          id: main
          run: bash .catladder-generated/github/scripts/app1-app-dev.sh
          shell: bash
        - name: Upload artifacts
          uses: actions/upload-artifact@v4
          with:
            name: app1-app-dev
            path: |-
              app1/__build_info.json
              app1/.next
              app1/dist
            if-no-files-found: warn
            include-hidden-files: true
    app1-docker-dev:
      name: app1 🔨 docker | dev
      runs-on: ubuntu-latest
      needs:
        - app1-app-dev
        - job-image-docker-build
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/docker-build:d97f1ac6c3c5
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      env:
        DOCKER_BUILDKIT: '1'
        CL_dev_app1_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_dev_app1_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/docker-build:d97f1ac6c3c5
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app1-yarn
          uses: actions/cache/restore@v4
          with:
            path: app1/.yarn
            key: app1-yarn-\${{ github.run_id }}
            restore-keys: app1-yarn-
        - name: Download artifacts from app1-app-dev
          uses: actions/download-artifact@v4
          with:
            name: app1-app-dev
        - name: 🔨 docker
          id: main
          run: bash .catladder-generated/github/scripts/app1-docker-dev.sh
          shell: bash
    app1-deploy-dev:
      name: app1 🚀 Deploy | dev
      runs-on: ubuntu-latest
      needs:
        - app1-app-dev
        - app1-audit-dev
        - app1-docker-dev
        - app1-lint-dev
        - app1-test-dev
        - job-image-gcloud
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev-app1
        url: \${{ steps.main.outputs.url }}
      env:
        CL_dev_app1_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_dev_app1_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🚀 Deploy
          id: main
          run: bash .catladder-generated/github/scripts/app1-deploy-dev.sh
          shell: bash
    app2-audit-dev:
