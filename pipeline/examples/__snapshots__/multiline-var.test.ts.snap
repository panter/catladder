        $(printf %s "$(tag=$(git ls-remote origin "refs/tags/v*[0-9]" 2>/dev/null | cut -f 2- | sort -V | tail -1 | sed 's/refs\\/tags\\/v//'); [ -z "$tag" ] && echo "0.0.0" || echo "$tag")" | sed '1!s/^/  /')
      HOSTNAME: |-
        pan-test-app-dev-app2-123456789012.asia-east1.run.app
      ROOT_URL: |-
        https://pan-test-app-dev-app2-123456789012.asia-east1.run.app
      HOSTNAME_INTERNAL: |-
        pan-test-app-dev-app2-123456789012.asia-east1.run.app
      ROOT_URL_INTERNAL: |-
        https://pan-test-app-dev-app2-123456789012.asia-east1.run.app
      DEPLOY_CLOUD_RUN_SERVICE_NAME: |-
        pan-test-app-dev-app2
      DEPLOY_CLOUD_RUN_PROJECT_ID: |-
        asdf
      DEPLOY_CLOUD_RUN_REGION: |-
        asia-east1
      foo: |-
        foo-value
      multiline: |-
        app2 yeah
        app2 yeah2
        app2 yeah3  
        
        app2 single quote: '
        app2 doouble quote: "
        
        the url of self: "https://pan-test-app-dev-app2-123456789012.asia-east1.run.app"
        the url of app1: "https://pan-test-app-dev-app1-123456789012.asia-east1.run.app"
        
        value from app1:
