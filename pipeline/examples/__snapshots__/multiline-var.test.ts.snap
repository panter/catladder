    kube-stop-review:
      name: kube 🛑 Stop ⚠️ | review
      runs-on: ubuntu-latest
      needs:
        - job-image-kubernetes
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/kubernetes:a442f2fe0109
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review-pr\${{ github.event.number }}-kube
      env:
        CL_review_kube_KUBE_URL: \${{ secrets.CL_review_kube_KUBE_URL }}
        CL_review_kube_KUBE_CA_PEM: \${{ secrets.CL_review_kube_KUBE_CA_PEM }}
        CL_review_kube_KUBE_TOKEN: \${{ secrets.CL_review_kube_KUBE_TOKEN }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/kubernetes:a442f2fe0109
      steps:
        - name: 🛑 Stop ⚠️
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "injectvars" "Injecting variables"
            export ENV_SHORT="review"
            export APP_DIR="kube"
            export ENV_TYPE="review"
            export BUILD_INFO_BUILD_ID="$(git describe --tags 2>/dev/null || git rev-parse HEAD)"
            export BUILD_INFO_BUILD_TIME="unknown-build-time"
            export BUILD_INFO_CURRENT_VERSION="$(tag=$(git ls-remote origin "refs/tags/v*[0-9]" 2>/dev/null | cut -f 2- | sort -V | tail -1 | sed 's/refs\\/tags\\/v//'); [ -z "$tag" ] && echo "0.0.0" || echo "$tag")"
            export HOSTNAME="kube.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud"
            export ROOT_URL="https://kube.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud"
            export HOSTNAME_INTERNAL="kube.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud"
            export ROOT_URL_INTERNAL="https://kube.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud"
            export KUBE_NAMESPACE="pan-test-app-review"
            export KUBE_APP_NAME="$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-kube"
            export KUBE_APP_NAME_PREFIX="$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-"
            export multiline_from_app1="app1 line1
            app1 line2
            app1 line3  

            the url of self: \\"https://$(printf %s "pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-app1-123456789012.asia-east1.run.app" | awk '{print tolower($0)}')\\"


            app1 single quote: '
            app1 doouble quote: \\"
            "
            export multiline="kube yeah
            kube yeah2
            kube yeah3  

            kube single quote: '
            kube doouble quote: \\"

            the url of self: \\"https://kube.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud\\"
            the url of app1: \\"https://$(printf %s "pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-app1-123456789012.asia-east1.run.app" | awk '{print tolower($0)}')\\"

            value from app1:
            -------
            app1 line1
            app1 line2
            app1 line3  

            the url of self: \\"https://$(printf %s "pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-app1-123456789012.asia-east1.run.app" | awk '{print tolower($0)}')\\"


            app1 single quote: '
            app1 doouble quote: \\"

            --------
            "
            export _ALL_ENV_VAR_KEYS="[\\"ENV_SHORT\\",\\"APP_DIR\\",\\"ENV_TYPE\\",\\"BUILD_INFO_BUILD_ID\\",\\"BUILD_INFO_BUILD_TIME\\",\\"BUILD_INFO_CURRENT_VERSION\\",\\"HOSTNAME\\",\\"ROOT_URL\\",\\"HOSTNAME_INTERNAL\\",\\"ROOT_URL_INTERNAL\\",\\"KUBE_NAMESPACE\\",\\"KUBE_APP_NAME\\",\\"KUBE_APP_NAME_PREFIX\\",\\"multiline_from_app1\\",\\"multiline\\"]"
            export RELEASE_NAME="pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-kube"
            export HELM_EXPERIMENTAL_OCI="1"
            export KUBE_DOCKER_IMAGE_PULL_SECRET="gitlab-registry-kube"
            export HELM_GITLAB_CHART_NAME="/helm-charts/the-panter-chart"
            export HELM_ARGS=""
            export COMPONENT_NAME="kube"
            collapseable_section_end "injectvars"
            kubectl config set-cluster "kube-pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-kube" --server="$CL_review_kube_KUBE_URL" --certificate-authority <(echo $CL_review_kube_KUBE_CA_PEM | base64 -d) --embed-certs=true
            kubectl config set-credentials "kube-pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-kube" --token="$CL_review_kube_KUBE_TOKEN"
            kubectl config set-context "kube-pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-kube" --cluster="kube-pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-kube" --user="kube-pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-kube" --namespace="pan-test-app-review"
            kubectl config use-context "kube-pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-kube"
            kubernetesDelete
          shell: bash
catladder-manual.yml:
  name: catladder manual tasks
  on:
    workflow_dispatch:
      inputs:
        job:
          description: the task to run
          required: true
          type: choice
          options:
            - app1-stop-dev
            - app2-stop-dev
            - kube-stop-dev
            - kube-rollback-dev
            - create-release
            - kube-rollback-review
            - app1-stop-stage
            - app1-stop-prod
            - app2-stop-stage
            - app2-stop-prod
            - kube-stop-stage
            - kube-rollback-stage
            - kube-stop-prod
            - kube-rollback-prod
  permissions:
    contents: read
    packages: write
  env: *a1
  jobs:
    job-image-jobs-default:
      name: 🐳 job image jobs-default
      runs-on: ubuntu-latest
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🐳 job image jobs-default
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "docker-login" "Docker Login"
            docker login --username $CL_REGISTRY_USER --password $CL_JOB_TOKEN $CL_REGISTRY
            collapseable_section_end "docker-login"
            collapseable_section_start "check-image" "Checking if image exists"
            if docker manifest inspect ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b > /dev/null 2>&1; then
              echo "Image ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b already exists, skipping build"
              exit 0
            fi
            collapseable_section_end "check-image"
            collapseable_section_start "docker-build" "Building image"
            DOCKER_BUILDKIT=1 docker build -t ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b -f .catladder-generated/images/jobs-default/Dockerfile .catladder-generated/images
            collapseable_section_end "docker-build"
            collapseable_section_start "docker-push" "Pushing image"
            docker push ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
            collapseable_section_end "docker-push"
          shell: bash
