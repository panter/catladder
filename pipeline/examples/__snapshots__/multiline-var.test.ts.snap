        CL_prod_app2_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_prod_app2_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app2-yarn
          uses: actions/cache@v4
          with:
            path: app2/.yarn
            key: app2-yarn-\${{ github.run_id }}
            restore-keys: app2-yarn-
        - name: Cache app2-node-modules
          uses: actions/cache@v4
          with:
            path: |-
              app2/node_modules
              app2/.yarn/install-state.gz
            key: app2-node-modules-\${{ github.run_id }}
            restore-keys: app2-node-modules-
        - name: 🔨 app
          id: main
          run: bash .catladder-generated/github/scripts/app2-app-prod.sh
          shell: bash
        - name: Upload artifacts
          uses: actions/upload-artifact@v4
          with:
            name: app2-app-prod
            path: |-
              app2/__build_info.json
              app2/.next
              app2/dist
            if-no-files-found: warn
            include-hidden-files: true
    app2-docker-prod:
      name: app2 🔨 docker | prod
      runs-on: ubuntu-latest
      needs:
        - app2-app-prod
        - job-image-docker-build
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/docker-build:d97f1ac6c3c5
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      env:
        DOCKER_BUILDKIT: '1'
        CL_prod_app2_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_prod_app2_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/docker-build:d97f1ac6c3c5
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app2-yarn
          uses: actions/cache/restore@v4
          with:
            path: app2/.yarn
            key: app2-yarn-\${{ github.run_id }}
            restore-keys: app2-yarn-
        - name: Download artifacts from app2-app-prod
          uses: actions/download-artifact@v4
          with:
            name: app2-app-prod
        - name: 🔨 docker
          id: main
          run: bash .catladder-generated/github/scripts/app2-docker-prod.sh
          shell: bash
    app2-deploy-prod:
      name: app2 🚀 Deploy | prod
      runs-on: ubuntu-latest
      needs:
        - app2-app-prod
        - app2-docker-prod
        - job-image-gcloud
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: prod-app2
        url: \${{ steps.main.outputs.url }}
      env:
        CL_prod_app2_GCLOUD_DEPLOY_credentialsKey: \${{ secrets.CL_prod_app2_GCLOUD_DEPLOY_credentialsKey }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/gcloud:425075338115
      steps:
        - name: Checkout
