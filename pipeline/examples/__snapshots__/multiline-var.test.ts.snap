          KUBE_NAMESPACE: |-
            pan-test-app-prod
          KUBE_APP_NAME: |-
            kube
          KUBE_APP_NAME_PREFIX: ""
          multiline_from_app1: |-
            app1 line1
            app1 line2
            app1 line3  
            
