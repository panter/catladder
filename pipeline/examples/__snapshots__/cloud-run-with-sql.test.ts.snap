          {
            "artifacts": false,
            "job": "🔸 myWorkspace 🧪 test",
          },
          {
            "artifacts": false,
            "job": "🔸 myWorkspace 🛡 audit",
          },
          {
            "artifacts": false,
            "job": "🔹 www 🔨 docker | dev ",
