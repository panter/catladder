      artifacts: false
    - job: 🔸 myWorkspace 🛡 audit
      artifacts: false
    - job: '🔹 www 🔨 docker | dev '
      artifacts: false
    - job: '🔹 www 🧾 sbom | dev '
      artifacts: true
  retry: *a1
  interruptible: true
  allow_failure: false
