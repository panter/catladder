      DEPLOY_CLOUD_RUN_PROJECT_ID: |-
        google-project-id
      DEPLOY_CLOUD_RUN_REGION: |-
        europe-west6
      GCLOUD_RUN_canonicalHostSuffix: |-
      $(printf %s "$CL_review_api_GCLOUD_RUN_canonicalHostSuffix" | sed 's/^/  /')
