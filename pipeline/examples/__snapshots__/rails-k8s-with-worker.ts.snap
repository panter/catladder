// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`matches snapshot 1`] = `
{
  "mainBranch": {
    "image": "path/to/docker/jobs-default:the-version",
    "jobs": {
      "app ↩️ Rollback ⚠️ | dev ": {
        "environment": {
          "action": "access",
          "kubernetes": {
            "namespace": "pan-test-app-dev",
          },
          "name": "dev/app",
          "url": "https://app.dev.test-app.pan.panter.cloud",
        },
        "image": "path/to/docker/kubernetes:the-version",
        "interruptible": true,
        "needs": [],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "rules": [
          {
            "allow_failure": true,
            "when": "manual",
          },
        ],
        "script": [
          "kubectl config set-cluster "kube-pan-test-app-dev-app" --server="$CL_dev_app_KUBE_URL" --certificate-authority <(echo $CL_dev_app_KUBE_CA_PEM | base64 -d) --embed-certs=true",
          "kubectl config set-credentials "kube-pan-test-app-dev-app" --token="$CL_dev_app_KUBE_TOKEN"",
          "kubectl config set-context "kube-pan-test-app-dev-app" --cluster="kube-pan-test-app-dev-app" --user="kube-pan-test-app-dev-app" --namespace="pan-test-app-dev"",
          "kubectl config use-context "kube-pan-test-app-dev-app"",
          "kubernetesRollback",
        ],
        "stage": "rollback dev",
        "variables": {
          "APP_DIR": ".",
          "BUILD_ID": "some-id",
          "COMPONENT_NAME": "app",
          "ENV_SHORT": "dev",
          "ENV_TYPE": "dev",
          "GIT_STRATEGY": "none",
          "HELM_ARGS": "",
          "HELM_EXPERIMENTAL_OCI": "1",
          "HELM_GITLAB_CHART_NAME": "the-panter-chart",
          "HOST_CANONICAL": "app.dev.test-app.pan.panter.cloud",
          "KUBERNETES_CPU_LIMIT": "1",
          "KUBERNETES_CPU_REQUEST": "0.5",
          "KUBERNETES_MEMORY_LIMIT": "500Mi",
          "KUBERNETES_MEMORY_REQUEST": "200Mi",
          "KUBE_APP_NAME": "app",
          "KUBE_APP_NAME_PREFIX": "",
          "KUBE_DOCKER_IMAGE_PULL_SECRET": "gitlab-registry-app",
          "KUBE_NAMESPACE": "pan-test-app-dev",
          "KUBE_VALUES": "env:
  secret:
    SECRET_KEY_BASE: '$CL_dev_app_SECRET_KEY_BASE'
    POSTGRESQL_PASSWORD: '$CL_dev_app_POSTGRESQL_PASSWORD'
    cloudsqlProxyCredentials: '$CL_dev_app_cloudsqlProxyCredentials'
  public:
    ENV_SHORT: 'dev'
    APP_DIR: '.'
    ENV_TYPE: 'dev'
    ROOT_URL: 'https://app.dev.test-app.pan.panter.cloud'
    KUBE_NAMESPACE: 'pan-test-app-dev'
    KUBE_APP_NAME: 'app'
    KUBE_APP_NAME_PREFIX: ''
    HOST_CANONICAL: 'app.dev.test-app.pan.panter.cloud'
    RAILS_ENV: 'production'
    _ALL_ENV_VAR_KEYS: '["ENV_SHORT","APP_DIR","ENV_TYPE","ROOT_URL","KUBE_NAMESPACE","KUBE_APP_NAME","KUBE_APP_NAME_PREFIX","HOST_CANONICAL","SECRET_KEY_BASE","POSTGRESQL_PASSWORD","cloudsqlProxyCredentials","RAILS_ENV"]'
application:
  host: 'app.dev.test-app.pan.panter.cloud'
  command: '/cnb/process/web'
  livenessProbe:
    httpGet:
      path: '__health'
  readinessProbe:
    httpGet:
      path: '__health'
  startupProbe:
    httpGet:
      path: '__health'
  worker:
    enabled: true
    command: 'launcher bundle exec rake jobs:work'
cloudsql:
  proxyCredentials: '$CL_dev_app_cloudsqlProxyCredentials'
  enabled: true
  projectId: 'some-project-id'
jobs:
  db-migrate:
    hook: 'post-install,post-upgrade'
    command: 'launcher bundle exec rake db:migrate'
",
          "POSTGRESQL_PASSWORD": "$CL_dev_app_POSTGRESQL_PASSWORD",
          "RAILS_ENV": "production",
          "RELEASE_NAME": "pan-test-app-dev-app",
          "ROOT_URL": "https://app.dev.test-app.pan.panter.cloud",
          "SECRET_KEY_BASE": "$CL_dev_app_SECRET_KEY_BASE",
          "_ALL_ENV_VAR_KEYS": "["ENV_SHORT","APP_DIR","ENV_TYPE","ROOT_URL","KUBE_NAMESPACE","KUBE_APP_NAME","KUBE_APP_NAME_PREFIX","HOST_CANONICAL","SECRET_KEY_BASE","POSTGRESQL_PASSWORD","cloudsqlProxyCredentials","RAILS_ENV"]",
          "cloudsqlProxyCredentials": "$CL_dev_app_cloudsqlProxyCredentials",
        },
      },
      "app 👮 lint": {
        "cache": {
          "key": {
            "files": [
              "Gemfile.lock",
            ],
            "prefix": "$CI_JOB_IMAGE",
          },
          "paths": [
            "tmp/cache",
          ],
        },
        "environment": undefined,
        "image": "ruby:3.2.1",
        "interruptible": true,
        "needs": [],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "script": [
          "cd .",
          "bundle config set path 'tmp/cache'",
          "bundle install -j $(nproc)",
          "bundle exec rubocop",
        ],
        "stage": "test",
        "variables": {},
      },
      "app 🔨 docker | dev ": {
        "environment": undefined,
        "image": "path/to/docker/docker-build:the-version",
        "interruptible": true,
        "needs": [],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "script": [
          "docker login --username gitlab-ci-token --password $CI_JOB_TOKEN $CI_REGISTRY",
          "docker pull $DOCKER_CACHE_IMAGE || true",
          "wget --output-document=- https://github.com/buildpacks/pack/releases/download/v0.28.0/pack-v0.28.0-linux.tgz | tar -zx --directory /usr/local/bin pack",
          "chmod +x /usr/local/bin/pack",
          "sed --in-place 's|git@\\([^:]*\\):|https://\\1/|g' Gemfile Gemfile.lock",
          "pack build "$DOCKER_IMAGE:$DOCKER_IMAGE_TAG" --builder 'heroku/buildpacks:20' --publish --cache-image "$DOCKER_CACHE_IMAGE" --env 'SECRET_KEY_BASE=dummy-value' ",
        ],
        "services": [
          {
            "command": [
              "--tls=false",
            ],
            "name": "docker:20-dind",
          },
        ],
        "stage": "build",
        "variables": {
          "APP_DIR": ".",
          "DOCKERFILE_ADDITIONS": undefined,
          "DOCKERFILE_ADDITIONS_END": undefined,
          "DOCKER_BUILDKIT": "1",
          "DOCKER_CACHE_IMAGE": "$DOCKER_REGISTRY_IMAGE_PATH/caches/app",
          "DOCKER_DIR": ".",
          "DOCKER_DRIVER": "overlay2",
          "DOCKER_HOST": "tcp://0.0.0.0:2375",
          "DOCKER_IMAGE": "$DOCKER_REGISTRY_IMAGE_PATH/$DOCKER_IMAGE_NAME",
          "DOCKER_IMAGE_NAME": "dev/app",
          "DOCKER_IMAGE_TAG": "$CI_COMMIT_SHA",
          "DOCKER_REGISTRY": "$CI_REGISTRY",
          "DOCKER_REGISTRY_IMAGE_PATH": "$CI_REGISTRY_IMAGE",
          "DOCKER_TLS_CERTDIR": "",
          "KUBERNETES_CPU_LIMIT": "1",
          "KUBERNETES_CPU_REQUEST": "0.5",
          "KUBERNETES_MEMORY_LIMIT": "2Gi",
          "KUBERNETES_MEMORY_REQUEST": "1Gi",
        },
      },
      "app 🚀 Deploy | dev ": {
        "allow_failure": false,
        "environment": {
          "auto_stop_in": "4 weeks",
          "kubernetes": {
            "namespace": "pan-test-app-dev",
          },
          "name": "dev/app",
          "on_stop": "app 🛑 Stop ⚠️ | dev ",
          "url": "https://app.dev.test-app.pan.panter.cloud",
        },
        "image": "path/to/docker/kubernetes:the-version",
        "interruptible": true,
        "needs": [
          {
            "artifacts": false,
            "job": "app 👮 lint",
          },
          {
            "artifacts": false,
            "job": "app 🔨 docker | dev ",
          },
          {
            "artifacts": false,
            "job": "app 🧪 test",
          },
          {
            "artifacts": false,
            "job": "app 🛡 audit",
          },
        ],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "rules": [
          {
            "when": "on_success",
          },
        ],
        "script": [
          "kubectl config set-cluster "kube-pan-test-app-dev-app" --server="$CL_dev_app_KUBE_URL" --certificate-authority <(echo $CL_dev_app_KUBE_CA_PEM | base64 -d) --embed-certs=true",
          "kubectl config set-credentials "kube-pan-test-app-dev-app" --token="$CL_dev_app_KUBE_TOKEN"",
          "kubectl config set-context "kube-pan-test-app-dev-app" --cluster="kube-pan-test-app-dev-app" --user="kube-pan-test-app-dev-app" --namespace="pan-test-app-dev"",
          "kubectl config use-context "kube-pan-test-app-dev-app"",
          "kubernetesCreateSecret",
          "kubernetesDeploy",
          "echo deployment successful 😻",
        ],
        "stage": "deploy dev",
        "variables": {
          "APP_DIR": ".",
          "BUILD_ID": "some-id",
          "COMPONENT_NAME": "app",
          "DOCKER_CACHE_IMAGE": "$DOCKER_REGISTRY_IMAGE_PATH/caches/app",
          "DOCKER_IMAGE": "$DOCKER_REGISTRY_IMAGE_PATH/$DOCKER_IMAGE_NAME",
          "DOCKER_IMAGE_NAME": "dev/app",
          "DOCKER_IMAGE_TAG": "$CI_COMMIT_SHA",
          "DOCKER_REGISTRY": "$CI_REGISTRY",
          "DOCKER_REGISTRY_IMAGE_PATH": "$CI_REGISTRY_IMAGE",
          "ENV_SHORT": "dev",
          "ENV_TYPE": "dev",
          "HELM_ARGS": "",
          "HELM_EXPERIMENTAL_OCI": "1",
          "HELM_GITLAB_CHART_NAME": "the-panter-chart",
          "HOST_CANONICAL": "app.dev.test-app.pan.panter.cloud",
          "KUBERNETES_CPU_LIMIT": "1",
          "KUBERNETES_CPU_REQUEST": "0.5",
          "KUBERNETES_MEMORY_LIMIT": "500Mi",
          "KUBERNETES_MEMORY_REQUEST": "200Mi",
          "KUBE_APP_NAME": "app",
          "KUBE_APP_NAME_PREFIX": "",
          "KUBE_DOCKER_IMAGE_PULL_SECRET": "gitlab-registry-app",
          "KUBE_NAMESPACE": "pan-test-app-dev",
          "KUBE_VALUES": "env:
  secret:
    SECRET_KEY_BASE: '$CL_dev_app_SECRET_KEY_BASE'
    POSTGRESQL_PASSWORD: '$CL_dev_app_POSTGRESQL_PASSWORD'
    cloudsqlProxyCredentials: '$CL_dev_app_cloudsqlProxyCredentials'
  public:
    ENV_SHORT: 'dev'
    APP_DIR: '.'
    ENV_TYPE: 'dev'
    ROOT_URL: 'https://app.dev.test-app.pan.panter.cloud'
    KUBE_NAMESPACE: 'pan-test-app-dev'
    KUBE_APP_NAME: 'app'
    KUBE_APP_NAME_PREFIX: ''
    HOST_CANONICAL: 'app.dev.test-app.pan.panter.cloud'
    RAILS_ENV: 'production'
    _ALL_ENV_VAR_KEYS: '["ENV_SHORT","APP_DIR","ENV_TYPE","ROOT_URL","KUBE_NAMESPACE","KUBE_APP_NAME","KUBE_APP_NAME_PREFIX","HOST_CANONICAL","SECRET_KEY_BASE","POSTGRESQL_PASSWORD","cloudsqlProxyCredentials","RAILS_ENV"]'
application:
  host: 'app.dev.test-app.pan.panter.cloud'
  command: '/cnb/process/web'
  livenessProbe:
    httpGet:
      path: '__health'
