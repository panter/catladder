          "kubectl config set-credentials "kube-pan-test-app-review-mr1234-app" --token="$CL_review_app_KUBE_TOKEN"",
          "kubectl config set-context "kube-pan-test-app-review-mr1234-app" --cluster="kube-pan-test-app-review-mr1234-app" --user="kube-pan-test-app-review-mr1234-app" --namespace="pan-test-app-review"",
          "kubectl config use-context "kube-pan-test-app-review-mr1234-app"",
          "kubernetesRollback",
        ],
        "stage": "rollback review",
        "variables": {
          "APP_DIR": ".",
          "BUILD_ID": "some-id",
          "COMPONENT_NAME": "app",
          "ENV_SHORT": "review",
          "ENV_TYPE": "review",
          "GIT_STRATEGY": "none",
          "HELM_ARGS": "",
          "HELM_EXPERIMENTAL_OCI": "1",
          "HELM_GITLAB_CHART_NAME": "the-panter-chart",
          "HOST_CANONICAL": "app.mr1234.review.test-app.pan.panter.cloud",
          "KUBERNETES_CPU_LIMIT": "1",
          "KUBERNETES_CPU_REQUEST": "0.5",
          "KUBERNETES_MEMORY_LIMIT": "500Mi",
          "KUBERNETES_MEMORY_REQUEST": "200Mi",
          "KUBE_APP_NAME": "mr1234-app",
          "KUBE_APP_NAME_PREFIX": "mr1234-",
          "KUBE_DOCKER_IMAGE_PULL_SECRET": "gitlab-registry-app",
          "KUBE_NAMESPACE": "pan-test-app-review",
          "KUBE_VALUES": "env:
  secret:
    SECRET_KEY_BASE: '$CL_review_app_SECRET_KEY_BASE'
    POSTGRESQL_PASSWORD: '$CL_review_app_POSTGRESQL_PASSWORD'
    cloudsqlProxyCredentials: '$CL_review_app_cloudsqlProxyCredentials'
  public:
    ENV_SHORT: 'review'
