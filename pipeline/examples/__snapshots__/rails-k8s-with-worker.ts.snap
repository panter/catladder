  readinessProbe:
    httpGet:
      path: |-
        __health
  startupProbe:
    httpGet:
      path: |-
        __health
  worker:
    enabled: true
    command: |-
      launcher bundle exec rake jobs:work
    livenessProbe: false
cloudsql:
  enabled: true
  dbUser: |-
    postgres
  instanceConnectionName: |-
    some-project-id:europe-west6:pan-test-app-stage
  proxyCredentials: |-
    $CL_stage_app_cloudsqlProxyCredentials
  fullDbName: |-
    app
  projectId: |-
    some-project-id
jobs:
