env:
  secret:
    SECRET_KEY_BASE: |-
$(printf %s "$CL_stage_app_SECRET_KEY_BASE" | sed 's/^/      /')
    POSTGRESQL_PASSWORD: |-
$(printf %s "$CL_stage_app_POSTGRESQL_PASSWORD" | sed 's/^/      /')
