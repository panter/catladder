          {
            "artifacts": false,
            "job": "app 🔨 docker | review ",
          },
          {
            "artifacts": false,
            "job": "app 🧪 test",
          },
          {
            "artifacts": true,
            "job": "app 🧾 sbom | review ",
          },
          {
            "artifacts": false,
            "job": "app 🛡 audit",
          },
        ],
        "retry": {
          "max": 2,
          "when": [
            "runner_system_failure",
            "stuck_or_timeout_failure",
          ],
        },
        "rules": [
          {
            "when": "on_success",
          },
        ],
        "script": [
          "echo -e "\\e[0Ksection_start:$(date +%s):injectvars[collapsed=true]\\r\\e[0KInjecting variables"",
