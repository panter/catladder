$(printf %s "$CL_stage_app_cloudsqlProxyCredentials" | sed 's/^/      /')
  public:
    ENV_SHORT: |-
      stage
    APP_DIR: |-
      .
    ENV_TYPE: |-
      stage
    BUILD_INFO_BUILD_ID: |-
$(printf %s "$(git describe --tags 2>/dev/null || git rev-parse HEAD)" | sed 's/^/      /')
    BUILD_INFO_BUILD_TIME: |-
$(printf %s "$CI_JOB_STARTED_AT" | sed 's/^/      /')
