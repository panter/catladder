  cache:
    - key: api-yarn-mr$CI_MERGE_REQUEST_IID
      policy: pull-push
      paths:
        - api/.yarn
      fallback_keys:
        - api-yarn
    - key: api-node-modules-mr$CI_MERGE_REQUEST_IID
      policy: pull-push
