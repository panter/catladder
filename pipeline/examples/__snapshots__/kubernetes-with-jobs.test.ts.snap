    www-app-review:
      name: www 🔨 app | review
      runs-on: ubuntu-latest
      needs:
        - job-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      env:
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache www-yarn
          uses: actions/cache@v4
          with:
            path: www/.yarn
            key: www-yarn-\${{ github.run_id }}
            restore-keys: www-yarn-
        - name: Cache www-node-modules
          uses: actions/cache@v4
          with:
            path: |-
              www/node_modules
              www/.yarn/install-state.gz
            key: www-node-modules-\${{ github.run_id }}
            restore-keys: www-node-modules-
        - name: 🔨 app
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "injectvars" "Injecting variables"
            export ENV_SHORT="review"
            export APP_DIR="www"
            export ENV_TYPE="review"
            export BUILD_INFO_BUILD_ID="$(git describe --tags 2>/dev/null || git rev-parse HEAD)"
            export BUILD_INFO_BUILD_TIME="unknown-build-time"
            export BUILD_INFO_CURRENT_VERSION="$(tag=$(git ls-remote origin "refs/tags/v*[0-9]" 2>/dev/null | cut -f 2- | sort -V | tail -1 | sed 's/refs\\/tags\\/v//'); [ -z "$tag" ] && echo "0.0.0" || echo "$tag")"
            export HOSTNAME="www.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud"
            export ROOT_URL="https://www.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud"
            export HOSTNAME_INTERNAL="www.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud"
            export ROOT_URL_INTERNAL="https://www.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud"
            export KUBE_NAMESPACE="pan-test-app-review"
            export KUBE_APP_NAME="$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-www"
            export KUBE_APP_NAME_PREFIX="$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-"
            export _ALL_ENV_VAR_KEYS="[\\"ENV_SHORT\\",\\"APP_DIR\\",\\"ENV_TYPE\\",\\"BUILD_INFO_BUILD_ID\\",\\"BUILD_INFO_BUILD_TIME\\",\\"BUILD_INFO_CURRENT_VERSION\\",\\"HOSTNAME\\",\\"ROOT_URL\\",\\"HOSTNAME_INTERNAL\\",\\"ROOT_URL_INTERNAL\\",\\"KUBE_NAMESPACE\\",\\"KUBE_APP_NAME\\",\\"KUBE_APP_NAME_PREFIX\\"]"
            collapseable_section_end "injectvars"
            collapseable_section_start "write-dotenv-www" "write dot env for www"
            cat <<EOF > www/.env
            ENV_SHORT=review
            APP_DIR=www
            ENV_TYPE=review
            HOSTNAME=$(printf %s "www.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud" | escapeForDotEnv)
            ROOT_URL=$(printf %s "https://www.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud" | escapeForDotEnv)
            HOSTNAME_INTERNAL=$(printf %s "www.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud" | escapeForDotEnv)
            ROOT_URL_INTERNAL=$(printf %s "https://www.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud" | escapeForDotEnv)
            KUBE_NAMESPACE=pan-test-app-review
            KUBE_APP_NAME=$(printf %s "$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-www" | escapeForDotEnv)
            KUBE_APP_NAME_PREFIX=$(printf %s "$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-" | escapeForDotEnv)
            _ALL_ENV_VAR_KEYS=["ENV_SHORT","APP_DIR","ENV_TYPE","BUILD_INFO_BUILD_ID","BUILD_INFO_BUILD_TIME","BUILD_INFO_CURRENT_VERSION","HOSTNAME","ROOT_URL","HOSTNAME_INTERNAL","ROOT_URL_INTERNAL","KUBE_NAMESPACE","KUBE_APP_NAME","KUBE_APP_NAME_PREFIX"]
            EOF
            collapseable_section_end "write-dotenv-www"
            echo '{"id":"$(git describe --tags 2>/dev/null || git rev-parse HEAD)","time":"unknown-build-time"}' > www/__build_info.json
            collapseable_section_start "nodeinstall" "Ensure node version"
            if [ -f ~/.nvm/nvm.sh ];  then source ~/.nvm/nvm.sh; fi
            if command -v nvm &> /dev/null && [ -f ./.nvmrc ]; then nvm install; fi
            collapseable_section_end "nodeinstall"
            cd www
            collapseable_section_start "nodeinstall" "Ensure node version"
            if [ -f ~/.nvm/nvm.sh ];  then source ~/.nvm/nvm.sh; fi
            if command -v nvm &> /dev/null && [ -f ./.nvmrc ]; then nvm install; fi
            collapseable_section_end "nodeinstall"
            collapseable_section_start "yarninstall" "Yarn install"
            yarn install --immutable --inline-builds
            collapseable_section_end "yarninstall"
            yarn build
          shell: bash
        - name: Upload artifacts
          uses: actions/upload-artifact@v4
          with:
            name: www-app-review
            path: |-
              www/__build_info.json
              www/.next
              www/dist
            if-no-files-found: warn
    www-docker-review:
      name: www 🔨 docker | review
      runs-on: ubuntu-latest
      needs:
        - job-image-docker-build
        - www-app-review
      env:
        DOCKER_BUILDKIT: '1'
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/docker-build:d97f1ac6c3c5
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache www-yarn
          uses: actions/cache/restore@v4
          with:
            path: www/.yarn
            key: www-yarn-\${{ github.run_id }}
            restore-keys: www-yarn-
        - name: Download artifacts from www-app-review
          uses: actions/download-artifact@v4
          with:
            name: www-app-review
        - name: 🔨 docker
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "injectvars" "Injecting variables"
            export APP_DIR="www"
            export DOCKER_BUILD_CONTEXT="."
            export DOCKER_REGISTRY="$CL_REGISTRY"
            export DOCKER_CACHE_IMAGE="$CL_REGISTRY_IMAGE/caches/www"
            export DOCKER_IMAGE_NAME="review/www"
            export DOCKER_IMAGE="$CL_REGISTRY_IMAGE/$DOCKER_IMAGE_NAME"
            export DOCKER_IMAGE_TAG="$GITHUB_SHA"
            export DOCKER_COPY_AND_INSTALL_APP="ENV YARN_ENABLE_INLINE_BUILDS=1
            COPY --chown=node:node $APP_DIR .
            RUN yarn plugin import workspace-tools
            RUN yarn workspaces focus --production
            RUN yarn rebuild"
            export DOCKER_COPY_WORKSPACE_FILES="COPY --chown=node:node www/package.json /app/www/package.json
            COPY --chown=node:node www/yarn.lock /app/www/yarn.lock
            COPY --chown=node:node .yarnrc.yml /app/.yarnrc.yml
            COPY --chown=node:node .yarn /app/.yarn"
            collapseable_section_end "injectvars"
            ensureNodeDockerfile
            collapseable_section_start "docker-login" "Docker Login"
            docker login --username gitlab-ci-token --password $CL_JOB_TOKEN $CL_REGISTRY
            collapseable_section_end "docker-login"
            collapseable_section_start "docker-build" "Docker build"
            docker build --network host --cache-from $DOCKER_CACHE_IMAGE --tag $DOCKER_IMAGE:$DOCKER_IMAGE_TAG -f $APP_DIR/Dockerfile $DOCKER_BUILD_CONTEXT --build-arg BUILDKIT_INLINE_CACHE=1
            collapseable_section_end "docker-build"
            collapseable_section_start "docker-push" "Docker push and tag"
            docker push $DOCKER_IMAGE:$DOCKER_IMAGE_TAG
            docker tag $DOCKER_IMAGE:$DOCKER_IMAGE_TAG $DOCKER_CACHE_IMAGE
            docker push $DOCKER_CACHE_IMAGE
            collapseable_section_end "docker-push"
          shell: bash
    www-deploy-review:
      name: www 🚀 Deploy | review
      runs-on: ubuntu-latest
      needs:
        - job-image-kubernetes
        - www-app-review
        - www-audit-review
        - www-docker-review
        - www-lint-review
        - www-test-review
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/kubernetes:a442f2fe0109
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review-pr\${{ github.event.number }}-www
        url: \${{ steps.main.outputs.url }}
      env:
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/kubernetes:a442f2fe0109
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🚀 Deploy
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "injectvars" "Injecting variables"
            export ENV_SHORT="review"
            export APP_DIR="www"
            export ENV_TYPE="review"
            export BUILD_INFO_BUILD_ID="$(git describe --tags 2>/dev/null || git rev-parse HEAD)"
            export BUILD_INFO_BUILD_TIME="unknown-build-time"
            export BUILD_INFO_CURRENT_VERSION="$(tag=$(git ls-remote origin "refs/tags/v*[0-9]" 2>/dev/null | cut -f 2- | sort -V | tail -1 | sed 's/refs\\/tags\\/v//'); [ -z "$tag" ] && echo "0.0.0" || echo "$tag")"
            export HOSTNAME="www.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud"
            export ROOT_URL="https://www.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud"
            export HOSTNAME_INTERNAL="www.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud"
            export ROOT_URL_INTERNAL="https://www.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud"
            export KUBE_NAMESPACE="pan-test-app-review"
            export KUBE_APP_NAME="$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-www"
            export KUBE_APP_NAME_PREFIX="$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-"
            export _ALL_ENV_VAR_KEYS="[\\"ENV_SHORT\\",\\"APP_DIR\\",\\"ENV_TYPE\\",\\"BUILD_INFO_BUILD_ID\\",\\"BUILD_INFO_BUILD_TIME\\",\\"BUILD_INFO_CURRENT_VERSION\\",\\"HOSTNAME\\",\\"ROOT_URL\\",\\"HOSTNAME_INTERNAL\\",\\"ROOT_URL_INTERNAL\\",\\"KUBE_NAMESPACE\\",\\"KUBE_APP_NAME\\",\\"KUBE_APP_NAME_PREFIX\\"]"
            export DOCKER_REGISTRY="$CL_REGISTRY"
            export DOCKER_CACHE_IMAGE="$CL_REGISTRY_IMAGE/caches/www"
            export DOCKER_IMAGE_NAME="review/www"
            export DOCKER_IMAGE="$CL_REGISTRY_IMAGE/$DOCKER_IMAGE_NAME"
            export DOCKER_IMAGE_TAG="$GITHUB_SHA"
            export RELEASE_NAME="pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-www"
            export HELM_EXPERIMENTAL_OCI="1"
            export KUBE_DOCKER_IMAGE_PULL_SECRET="gitlab-registry-www"
            export HELM_GITLAB_CHART_NAME="/helm-charts/the-panter-chart"
            export HELM_ARGS=""
            export COMPONENT_NAME="www"
            collapseable_section_end "injectvars"
            kubectl config set-cluster "kube-pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-www" --server="$CL_review_www_KUBE_URL" --certificate-authority <(echo $CL_review_www_KUBE_CA_PEM | base64 -d) --embed-certs=true
            kubectl config set-credentials "kube-pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-www" --token="$CL_review_www_KUBE_TOKEN"
            kubectl config set-context "kube-pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-www" --cluster="kube-pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-www" --user="kube-pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-www" --namespace="pan-test-app-review"
            kubectl config use-context "kube-pan-test-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-www"
            collapseable_section_start "writeallvalues" "Write __all_values.yml for helm deployment"
            cat > __all_values.yml <<EOF
            env:
              secret:
                HOSTNAME: |-
                  $(printf %s "www.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud" | sed '1!s/^/      /')
                ROOT_URL: |-
                  $(printf %s "https://www.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud" | sed '1!s/^/      /')
                HOSTNAME_INTERNAL: |-
                  $(printf %s "www.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud" | sed '1!s/^/      /')
                ROOT_URL_INTERNAL: |-
                  $(printf %s "https://www.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud" | sed '1!s/^/      /')
                KUBE_APP_NAME: |-
                  $(printf %s "$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-www" | sed '1!s/^/      /')
                KUBE_APP_NAME_PREFIX: |-
                  $(printf %s "$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-" | sed '1!s/^/      /')
              public:
                ENV_SHORT: |-
                  review
                APP_DIR: |-
                  www
                ENV_TYPE: |-
                  review
                BUILD_INFO_BUILD_ID: |-
                  $(printf %s "$(git describe --tags 2>/dev/null || git rev-parse HEAD)" | sed '1!s/^/      /')
                BUILD_INFO_BUILD_TIME: |-
                  unknown-build-time
                BUILD_INFO_CURRENT_VERSION: |-
                  $(printf %s "$(tag=$(git ls-remote origin "refs/tags/v*[0-9]" 2>/dev/null | cut -f 2- | sort -V | tail -1 | sed 's/refs\\/tags\\/v//'); [ -z "$tag" ] && echo "0.0.0" || echo "$tag")" | sed '1!s/^/      /')
                KUBE_NAMESPACE: |-
                  pan-test-app-review
                _ALL_ENV_VAR_KEYS: |-
                  ["ENV_SHORT","APP_DIR","ENV_TYPE","BUILD_INFO_BUILD_ID","BUILD_INFO_BUILD_TIME","BUILD_INFO_CURRENT_VERSION","HOSTNAME","ROOT_URL","HOSTNAME_INTERNAL","ROOT_URL_INTERNAL","KUBE_NAMESPACE","KUBE_APP_NAME","KUBE_APP_NAME_PREFIX"]
            application:
              host: |-
                $(printf %s "www.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud" | sed '1!s/^/    /')
              command: |-
                yarn start
              livenessProbe:
                httpGet:
                  path: |-
                    __health
              readinessProbe:
                httpGet:
                  path: |-
                    __health
              startupProbe:
                httpGet:
                  path: |-
                    __health

            EOF

            collapseable_section_end "writeallvalues"
            kubernetesCreateSecret
            kubernetesDeploy
            echo deployment successful 😻
            echo "url=$ROOT_URL" >> "$GITHUB_OUTPUT"
          shell: bash
catladder-release.yml:
  name: catladder release
  on:
    push:
      tags:
        - v*
  permissions:
    contents: read
    packages: write
  env: *a1
  jobs:
    job-image-jobs-default:
      name: 🐳 job image jobs-default
      runs-on: ubuntu-latest
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🐳 job image jobs-default
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
