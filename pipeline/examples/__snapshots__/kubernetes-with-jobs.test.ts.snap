            export ROOT_URL_INTERNAL="https://www.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.test-app.pan.panter.cloud"
            export KUBE_NAMESPACE="pan-test-app-review"
