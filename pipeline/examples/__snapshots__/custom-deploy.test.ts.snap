    - echo 'Uploading SBOM to Dependency Track'
    - /dtrackuploader https://dep.panter.swiss/ "$DT_KEY_PROD" upload "pan-test-app/www" "$ROOT_URL" "__sbom.json" vex.json || true
    - echo "CL_GITLAB_ENVIRONMENT_URL=$ROOT_URL" >> gitlab_environment.env
  environment:
    name: prod/www
    url: $CL_GITLAB_ENVIRONMENT_URL
  artifacts:
    reports:
      dotenv: gitlab_environment.env
  rules:
    - when: never
      if: $CI_PIPELINE_SOURCE  == "trigger"
    - when: manual
      if: $CI_COMMIT_TAG
  needs:
    - job: 'www 🔨 app | prod '
      artifacts: false
    - job: 'www 🔨 docker | prod '
      artifacts: false
    - job: 'www 🧾 sbom | prod '
      artifacts: true
  retry: *a1
  interruptible: true
  allow_failure: true
create release:
  stage: release
  image: path/to/docker/semantic-release:the-version
  script:
    - semanticRelease
    - echo '👉 The project access token might be invald - run \`project-renew-token\` in catladder CLI to fix.'
  rules:
    - &a2
      if: $CI_COMMIT_MESSAGE =~ /^chore\\(release\\).*/
      when: never
    - &a3
      if: $CI_PIPELINE_SOURCE  == "trigger"
      when: never
    - &a4
      if: $CI_PIPELINE_SOURCE  == "schedule"
      when: never
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
      when: manual
    - if: $CI_COMMIT_BRANCH =~ /^[0-9]+.([0-9]+|x).x$/
      when: manual
⚠️ force create release:
  stage: release
  image: path/to/docker/semantic-release:the-version
  script:
    - semanticRelease
    - echo '👉 The project access token might be invald - run \`project-renew-token\` in catladder CLI to fix.'
  rules:
    - *a2
    - *a3
    - *a4
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
      when: manual
    - if: $CI_COMMIT_BRANCH =~ /^[0-9]+.([0-9]+|x).x$/
      when: manual
  needs: []
"
`;
