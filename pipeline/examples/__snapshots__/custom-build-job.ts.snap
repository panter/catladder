$(printf %s "$CI_JOB_STARTED_AT" | sed 's/^/  /')
BUILD_INFO_CURRENT_VERSION: |-
$(printf %s "$(tag=$(git ls-remote origin "refs/tags/v*[0-9]" 2>/dev/null | cut -f 2- | sort -V | tail -1 | sed 's/refs\\/tags\\///'); [ -z "$tag" ] && echo "v0.0.0" || echo "$tag")" | sed 's/^/  /')
