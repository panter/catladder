    web-stop-review:
      name: web 🛑 Stop ⚠️ | review
      runs-on: ubuntu-latest
      needs:
        - job-image-kubernetes
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/kubernetes:a442f2fe0109
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review-web
      env:
        CL_review_web_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_review_web_MONGODB_ROOT_PASSWORD }}
        CL_review_web_KUBE_URL: \${{ secrets.CL_review_web_KUBE_URL }}
        CL_review_web_KUBE_CA_PEM: \${{ secrets.CL_review_web_KUBE_CA_PEM }}
        CL_review_web_KUBE_TOKEN: \${{ secrets.CL_review_web_KUBE_TOKEN }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/kubernetes:a442f2fe0109
      steps:
        - name: 🛑 Stop ⚠️
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "injectvars" "Injecting variables"
            export ENV_SHORT="review"
            export APP_DIR="app"
            export ENV_TYPE="review"
            export BUILD_INFO_BUILD_ID="$(git describe --tags 2>/dev/null || git rev-parse HEAD)"
            export BUILD_INFO_BUILD_TIME="unknown-build-time"
            export BUILD_INFO_CURRENT_VERSION="$(tag=$(git ls-remote origin "refs/tags/v*[0-9]" 2>/dev/null | cut -f 2- | sort -V | tail -1 | sed 's/refs\\/tags\\/v//'); [ -z "$tag" ] && echo "0.0.0" || echo "$tag")"
            export HOSTNAME="web.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.my-app.pan.panter.cloud"
            export ROOT_URL="https://web.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.my-app.pan.panter.cloud"
            export HOSTNAME_INTERNAL="web.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.my-app.pan.panter.cloud"
            export ROOT_URL_INTERNAL="https://web.$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown").review.my-app.pan.panter.cloud"
            export KUBE_NAMESPACE="pan-my-app-review"
            export KUBE_APP_NAME="$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-web"
            export KUBE_APP_NAME_PREFIX="$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-"
            export MONGODB_ROOT_PASSWORD="$CL_review_web_MONGODB_ROOT_PASSWORD"
            export _ALL_ENV_VAR_KEYS="[\\"ENV_SHORT\\",\\"APP_DIR\\",\\"ENV_TYPE\\",\\"BUILD_INFO_BUILD_ID\\",\\"BUILD_INFO_BUILD_TIME\\",\\"BUILD_INFO_CURRENT_VERSION\\",\\"HOSTNAME\\",\\"ROOT_URL\\",\\"HOSTNAME_INTERNAL\\",\\"ROOT_URL_INTERNAL\\",\\"KUBE_NAMESPACE\\",\\"KUBE_APP_NAME\\",\\"KUBE_APP_NAME_PREFIX\\",\\"MONGODB_ROOT_PASSWORD\\"]"
            export RELEASE_NAME="pan-my-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-web"
            export HELM_EXPERIMENTAL_OCI="1"
            export KUBE_DOCKER_IMAGE_PULL_SECRET="gitlab-registry-web"
            export HELM_GITLAB_CHART_NAME="/helm-charts/the-panter-chart"
            export HELM_ARGS=""
            export COMPONENT_NAME="web"
            collapseable_section_end "injectvars"
            kubectl config set-cluster "kube-pan-my-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-web" --server="$CL_review_web_KUBE_URL" --certificate-authority <(echo $CL_review_web_KUBE_CA_PEM | base64 -d) --embed-certs=true
            kubectl config set-credentials "kube-pan-my-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-web" --token="$CL_review_web_KUBE_TOKEN"
            kubectl config set-context "kube-pan-my-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-web" --cluster="kube-pan-my-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-web" --user="kube-pan-my-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-web" --namespace="pan-my-app-review"
            kubectl config use-context "kube-pan-my-app-review-$([ -n "$CL_PR_NUMBER" ] && echo "pr$CL_PR_NUMBER" || echo "unknown")-web"
            kubernetesDelete
          shell: bash
catladder-manual.yml:
  name: catladder manual tasks
  on:
    workflow_dispatch:
      inputs:
        job:
          description: the task to run
          required: true
          type: choice
          options:
            - web-stop-dev
            - web-rollback-dev
            - create-release
            - web-rollback-review
            - web-stop-stage
            - web-rollback-stage
            - web-stop-prod
            - web-rollback-prod
  permissions:
    contents: read
    packages: write
  env: *a1
  jobs:
    job-image-jobs-default:
      name: 🐳 job image jobs-default
      runs-on: ubuntu-latest
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🐳 job image jobs-default
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "docker-login" "Docker Login"
            docker login --username $CL_REGISTRY_USER --password $CL_JOB_TOKEN $CL_REGISTRY
            collapseable_section_end "docker-login"
            collapseable_section_start "check-image" "Checking if image exists"
            if docker manifest inspect ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b > /dev/null 2>&1; then
              echo "Image ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b already exists, skipping build"
              exit 0
            fi
            collapseable_section_end "check-image"
            collapseable_section_start "docker-build" "Building image"
            DOCKER_BUILDKIT=1 docker build -t ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b -f .catladder-generated/images/jobs-default/Dockerfile .catladder-generated/images
            collapseable_section_end "docker-build"
            collapseable_section_start "docker-push" "Pushing image"
            docker push ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
            collapseable_section_end "docker-push"
          shell: bash
