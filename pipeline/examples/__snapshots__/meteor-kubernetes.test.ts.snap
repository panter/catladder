    web-audit-review:
      name: web 🛡 audit | review
      runs-on: ubuntu-latest
      needs:
        - job-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review
      env:
        CL_review_web_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_review_web_MONGODB_ROOT_PASSWORD }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🛡 audit
          id: main
          run: bash .catladder-generated/github/scripts/web-audit-review.sh
          shell: bash
    web-lint-review:
      name: web 👮 lint | review
      runs-on: ubuntu-latest
      needs:
        - job-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review
      env:
        CL_review_web_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_review_web_MONGODB_ROOT_PASSWORD }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app-node-modules
          id: cache-node-modules
          uses: actions/cache/restore@v4
          with:
            path: |-
              app/node_modules
              app/.yarn/install-state.gz
            key: app-node-modules-\${{ hashFiles('app/yarn.lock') }}
            restore-keys: app-node-modules-
        - name: Cache app-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache/restore@v4
          with:
            path: app/.yarn
            key: app-yarn-\${{ hashFiles('app/yarn.lock') }}
            restore-keys: app-yarn-
        - name: 👮 lint
          id: main
          run: bash .catladder-generated/github/scripts/web-lint-review.sh
          shell: bash
    web-test-review:
      name: web 🧪 test | review
      runs-on: ubuntu-latest
      needs:
        - job-image-jobs-testing-chrome
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-testing-chrome:c9799d0c3dc3
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review
      env:
        CL_review_web_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_review_web_MONGODB_ROOT_PASSWORD }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-testing-chrome:c9799d0c3dc3
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app-node-modules
          id: cache-node-modules
          uses: actions/cache/restore@v4
          with:
            path: |-
              app/node_modules
              app/.yarn/install-state.gz
            key: app-node-modules-\${{ hashFiles('app/yarn.lock') }}
            restore-keys: app-node-modules-
        - name: Cache app-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache/restore@v4
          with:
            path: app/.yarn
            key: app-yarn-\${{ hashFiles('app/yarn.lock') }}
            restore-keys: app-yarn-
        - name: 🧪 test
          id: main
          run: bash .catladder-generated/github/scripts/web-test-review.sh
          shell: bash
    web-app-review:
      name: web 🔨 app | review
      runs-on: ubuntu-latest
      needs:
        - job-image-jobs-meteor
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-meteor:66ec3fa9846d
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review
      env:
        CL_review_web_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_review_web_MONGODB_ROOT_PASSWORD }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-meteor:66ec3fa9846d
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app-node-modules
          id: cache-node-modules
          uses: actions/cache@v4
          with:
            path: |-
              app/node_modules
              app/.yarn/install-state.gz
            key: app-node-modules-\${{ hashFiles('app/yarn.lock') }}
            restore-keys: app-node-modules-
        - name: Cache web-meteor-build-cache
          uses: actions/cache@v4
          with:
            path: |-
              app/.meteor/local/resolver-result-cache.json
              app/.meteor/local/plugin-cache
              app/.meteor/local/isopacks
              app/.meteor/local/bundler-cache/scanner
            key: web-meteor-build-cache-\${{ github.run_id }}
            restore-keys: web-meteor-build-cache-
        - name: Cache app-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache@v4
          with:
            path: app/.yarn
            key: app-yarn-\${{ hashFiles('app/yarn.lock') }}
            restore-keys: app-yarn-
        - name: 🔨 app
          id: main
          run: bash .catladder-generated/github/scripts/web-app-review.sh
          shell: bash
        - name: Upload artifacts
          uses: actions/upload-artifact@v4
          with:
            name: web-app-review
            path: |-
              app/__build_info.json
              app/dist
            if-no-files-found: warn
            include-hidden-files: true
    web-docker-review:
      name: web 🔨 docker | review
      runs-on: ubuntu-latest
      needs:
        - job-image-docker-build
        - web-app-review
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/docker-build:d97f1ac6c3c5
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review
      env:
        DOCKER_BUILDKIT: '1'
        CL_review_web_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_review_web_MONGODB_ROOT_PASSWORD }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/docker-build:d97f1ac6c3c5
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Download artifacts from web-app-review
          uses: actions/download-artifact@v4
          with:
            name: web-app-review
        - name: 🔨 docker
          id: main
          run: bash .catladder-generated/github/scripts/web-docker-review.sh
          shell: bash
    web-deploy-review:
      name: web 🚀 Deploy | review
      runs-on: ubuntu-latest
      needs:
        - job-image-kubernetes
        - web-app-review
        - web-audit-review
        - web-docker-review
        - web-lint-review
        - web-test-review
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/kubernetes:a442f2fe0109
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: review-web
        url: \${{ steps.main.outputs.url }}
      env:
        CL_review_web_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_review_web_MONGODB_ROOT_PASSWORD }}
        CL_review_web_KUBE_URL: \${{ secrets.CL_review_web_KUBE_URL }}
        CL_review_web_KUBE_CA_PEM: \${{ secrets.CL_review_web_KUBE_CA_PEM }}
        CL_review_web_KUBE_TOKEN: \${{ secrets.CL_review_web_KUBE_TOKEN }}
        CL_review_web_MONGODB_REPLICASET_KEY: \${{ secrets.CL_review_web_MONGODB_REPLICASET_KEY }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/kubernetes:a442f2fe0109
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🚀 Deploy
          id: main
          run: bash .catladder-generated/github/scripts/web-deploy-review.sh
          shell: bash
