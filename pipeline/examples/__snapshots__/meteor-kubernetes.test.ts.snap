application:
  host: |-
    web.dev.my-app.pan.panter.cloud
  command: |-
    node main.js
  livenessProbe:
    httpGet:
      path: |-
        __health
  readinessProbe:
    httpGet:
      path: |-
        __health
  startupProbe:
    httpGet:
      path: |-
        __health
  worker:
    enabled: true
mongodb:
  enabled: true
  auth:
    enabled: true
    rootPassword: |-
      $CL_dev_web_MONGODB_ROOT_PASSWORD
    replicaSetKey: |-
      $CL_dev_web_MONGODB_REPLICASET_KEY
  persistence:
    storageClass: |-
      standard-rwo
  backup:
    enabled: false
    hostToBackup: |-
      web-mongodb.pan-my-app-dev.svc.cluster.local:27017
    pvcToBackup: |-
      web-mongodb
    image: |-
      mrelite/kubectlmongoshell:v1.0
    schedule: |-
      0 4 * * *
    volumeSnapshotClass: |-
      snapshotclass
  architecture: |-
    standalone

EOF
",
