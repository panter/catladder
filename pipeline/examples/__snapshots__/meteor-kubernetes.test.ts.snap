    - export APP_PATH="app"
    - collapseable_section_end "injectvars"
    - collapseable_section_start "nodeinstall" "Ensure node version"
    - if [ -f "$HOME/.nvm/nvm.sh" ]; then source "$HOME/.nvm/nvm.sh"; elif [ -f /root/.nvm/nvm.sh ]; then export NVM_DIR=/root/.nvm; source /root/.nvm/nvm.sh; fi
    - if command -v nvm &> /dev/null && [ -f ./.nvmrc ]; then nvm install; fi
    - collapseable_section_end "nodeinstall"
    - cd app
    - collapseable_section_start "nodeinstall" "Ensure node version"
    - if [ -f "$HOME/.nvm/nvm.sh" ]; then source "$HOME/.nvm/nvm.sh"; elif [ -f /root/.nvm/nvm.sh ]; then export NVM_DIR=/root/.nvm; source /root/.nvm/nvm.sh; fi
    - if command -v nvm &> /dev/null && [ -f ./.nvmrc ]; then nvm install; fi
    - collapseable_section_end "nodeinstall"
    - collapseable_section_start "yarninstall" "Yarn install"
    - yarn install --immutable --inline-builds
    - collapseable_section_end "yarninstall"
    - yarn test
  cache:
    - key: app-yarn-mr$CI_MERGE_REQUEST_IID
      policy: pull
      paths:
        - app/.yarn
      fallback_keys:
        - app-yarn
    - key: app-node-modules-mr$CI_MERGE_REQUEST_IID
      policy: pull
      paths: *a3
      fallback_keys:
        - app-node-modules
