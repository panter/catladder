            fi
            collapseable_section_end "check-image"
            collapseable_section_start "docker-build" "Building image"
            DOCKER_BUILDKIT=1 docker build -t ghcr.io/\${{ github.repository }}/catladder/jobs-meteor:66ec3fa9846d -f .catladder-generated/images/jobs-meteor/Dockerfile .catladder-generated/images
            collapseable_section_end "docker-build"
