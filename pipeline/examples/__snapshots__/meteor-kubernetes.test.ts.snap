        "variables": {
          "DOCKER_BUILDKIT": "1",
          "DOCKER_DRIVER": "overlay2",
          "DOCKER_HOST": "tcp://0.0.0.0:2375",
          "DOCKER_TLS_CERTDIR": "",
          "KUBERNETES_CPU_REQUEST": "0.45",
          "KUBERNETES_MEMORY_LIMIT": "2Gi",
          "KUBERNETES_MEMORY_REQUEST": "1Gi",
