    web-audit-dev:
      name: web 🛡 audit | dev
      runs-on: ubuntu-latest
      needs:
        - job-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev
      env:
        CL_dev_web_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_dev_web_MONGODB_ROOT_PASSWORD }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🛡 audit
          id: main
          run: bash .catladder-generated/github/scripts/web-audit-dev.sh
          shell: bash
    web-lint-dev:
      name: web 👮 lint | dev
      runs-on: ubuntu-latest
      needs:
        - job-image-jobs-default
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev
      env:
        CL_dev_web_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_dev_web_MONGODB_ROOT_PASSWORD }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-default:a3d5deca022b
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app-node-modules
          id: cache-node-modules
          uses: actions/cache/restore@v4
          with:
            path: |-
              app/node_modules
              app/.yarn/install-state.gz
            key: app-node-modules-\${{ hashFiles('app/yarn.lock') }}
            restore-keys: app-node-modules-
        - name: Cache app-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache/restore@v4
          with:
            path: app/.yarn
            key: app-yarn-\${{ hashFiles('app/yarn.lock') }}
            restore-keys: app-yarn-
        - name: 👮 lint
          id: main
          run: bash .catladder-generated/github/scripts/web-lint-dev.sh
          shell: bash
    web-test-dev:
      name: web 🧪 test | dev
      runs-on: ubuntu-latest
      needs:
        - job-image-jobs-testing-chrome
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-testing-chrome:c9799d0c3dc3
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev
      env:
        CL_dev_web_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_dev_web_MONGODB_ROOT_PASSWORD }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-testing-chrome:c9799d0c3dc3
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app-node-modules
          id: cache-node-modules
          uses: actions/cache/restore@v4
          with:
            path: |-
              app/node_modules
              app/.yarn/install-state.gz
            key: app-node-modules-\${{ hashFiles('app/yarn.lock') }}
            restore-keys: app-node-modules-
        - name: Cache app-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache/restore@v4
          with:
            path: app/.yarn
            key: app-yarn-\${{ hashFiles('app/yarn.lock') }}
            restore-keys: app-yarn-
        - name: 🧪 test
          id: main
          run: bash .catladder-generated/github/scripts/web-test-dev.sh
          shell: bash
    web-app-dev:
      name: web 🔨 app | dev
      runs-on: ubuntu-latest
      needs:
        - job-image-jobs-meteor
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/jobs-meteor:66ec3fa9846d
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev
      env:
        CL_dev_web_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_dev_web_MONGODB_ROOT_PASSWORD }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/jobs-meteor:66ec3fa9846d
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Cache app-node-modules
          id: cache-node-modules
          uses: actions/cache@v4
          with:
            path: |-
              app/node_modules
              app/.yarn/install-state.gz
            key: app-node-modules-\${{ hashFiles('app/yarn.lock') }}
            restore-keys: app-node-modules-
        - name: Cache web-meteor-build-cache
          uses: actions/cache@v4
          with:
            path: |-
              app/.meteor/local/resolver-result-cache.json
              app/.meteor/local/plugin-cache
              app/.meteor/local/isopacks
              app/.meteor/local/bundler-cache/scanner
            key: web-meteor-build-cache-\${{ github.run_id }}
            restore-keys: web-meteor-build-cache-
        - name: Cache app-yarn
          if: \${{ steps.cache-node-modules.outputs.cache-hit != 'true' }}
          uses: actions/cache@v4
          with:
            path: app/.yarn
            key: app-yarn-\${{ hashFiles('app/yarn.lock') }}
            restore-keys: app-yarn-
        - name: 🔨 app
          id: main
          run: bash .catladder-generated/github/scripts/web-app-dev.sh
          shell: bash
        - name: Upload artifacts
          uses: actions/upload-artifact@v4
          with:
            name: web-app-dev
            path: |-
              app/__build_info.json
              app/dist
            if-no-files-found: warn
            include-hidden-files: true
    web-docker-dev:
      name: web 🔨 docker | dev
      runs-on: ubuntu-latest
      needs:
        - job-image-docker-build
        - web-app-dev
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/docker-build:d97f1ac6c3c5
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev
      env:
        DOCKER_BUILDKIT: '1'
        CL_dev_web_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_dev_web_MONGODB_ROOT_PASSWORD }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/docker-build:d97f1ac6c3c5
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: Download artifacts from web-app-dev
          uses: actions/download-artifact@v4
          with:
            name: web-app-dev
        - name: 🔨 docker
          id: main
          run: bash .catladder-generated/github/scripts/web-docker-dev.sh
          shell: bash
    web-deploy-dev:
      name: web 🚀 Deploy | dev
      runs-on: ubuntu-latest
      needs:
        - job-image-kubernetes
        - web-app-dev
        - web-audit-dev
        - web-docker-dev
        - web-lint-dev
        - web-test-dev
      container:
        image: ghcr.io/\${{ github.repository }}/catladder/kubernetes:a442f2fe0109
        credentials:
          username: \${{ github.actor }}
          password: \${{ github.token }}
      environment:
        name: dev-web
        url: \${{ steps.main.outputs.url }}
      env:
        CL_dev_web_MONGODB_ROOT_PASSWORD: \${{ secrets.CL_dev_web_MONGODB_ROOT_PASSWORD }}
        CL_dev_web_KUBE_URL: \${{ secrets.CL_dev_web_KUBE_URL }}
        CL_dev_web_KUBE_CA_PEM: \${{ secrets.CL_dev_web_KUBE_CA_PEM }}
        CL_dev_web_KUBE_TOKEN: \${{ secrets.CL_dev_web_KUBE_TOKEN }}
        CL_dev_web_MONGODB_REPLICASET_KEY: \${{ secrets.CL_dev_web_MONGODB_REPLICASET_KEY }}
        CL_JOB_IMAGE: ghcr.io/\${{ github.repository }}/catladder/kubernetes:a442f2fe0109
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🚀 Deploy
          id: main
          run: bash .catladder-generated/github/scripts/web-deploy-dev.sh
          shell: bash
catladder-review.yml:
  name: catladder review
  on:
    pull_request:
      types:
        - opened
        - synchronize
        - reopened
  concurrency:
    group: catladder-review-\${{ github.event.number }}
    cancel-in-progress: true
  permissions:
    contents: read
    packages: write
  env: *a1
  jobs:
    job-image-jobs-default:
      name: 🐳 job image jobs-default
      runs-on: ubuntu-latest
      steps:
        - name: Checkout
          uses: actions/checkout@v4
        - name: 🐳 job image jobs-default
          id: main
          run: |-
            function escapeForDotEnv () {
            input="\${1:-$(cat)}"
             input="\${input//$'\\n'/\\\\n}"
              if [[ "$input" == *\\\\n* ]]; then
                if [[ "$input" == *\\"* && "$input" == *\\'* && "$input" == *\\\`* ]]; then
                  printf "\\"%s\\"\\n" "$input" 
                elif [[ "$input" == *\\"* && "$input" == *\\'* ]]; then
                  printf "\`%s\`\\n" "$input"
                elif [[ "$input" == *\\"* ]]; then
                  printf "'%s'\\n" "$input"
                else
                  printf "\\"%s\\"\\n" "$input"
                fi
              else
                printf "%s\\n" "$input"
              fi
            }
            function collapseable_section_start () {
            local section_title="\${1}"
              local section_description="\${2:-$section_title}"
              echo "::group::\${section_description}"
            }
            function collapseable_section_end () {
            echo "::endgroup::"
            }
            collapseable_section_start "docker-login" "Docker Login"
            docker login --username $CL_REGISTRY_USER --password $CL_JOB_TOKEN $CL_REGISTRY
            collapseable_section_end "docker-login"
            collapseable_section_start "check-image" "Checking if image exists"
