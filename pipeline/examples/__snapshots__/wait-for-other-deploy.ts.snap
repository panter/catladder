          "echo -e "\\e[0Ksection_end:$(date +%s):injectvars\\r\\e[0K"",
          "echo -e "\\e[0Ksection_start:$(date +%s):nodeinstall[collapsed=true]\\r\\e[0KEnsure node version"",
