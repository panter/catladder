{
  "name": "@catladder/pipeline",
  "version": "0.0.10",
  "scripts": {
    "build": "yarn build:inline-variables",
    "build:inline-variables": "yarn babel --keep-file-extension --extensions \".ts,.js\" --config-file ./babel-inline.json src --out-dir dist",
    "prepack": "yarn build",
    "test": "jest",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix"
  },
  "main": "dist/index.ts",
  "types": "dist/index.ts",
  "bin": {
    "catladder-gitlab": "./bin/catladder-gitlab.ts"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.16.5",
    "babel-plugin-transform-inline-environment-variables": "^0.4.3",
    "jest": "^27.4.5"
  },
  "dependencies": {
    "@types/lodash": "^4.14.172",
    "@types/node": "^16.6.1",
    "@types/yargs": "^17.0.5",
    "@babel/cli": "^7.16.0",
    "@gitbeaker/node": "^32.1.2",
    "@types/jest": "^27.0.3",
    "lodash": "^4.17.21",
    "slugify": "^1.6.3",
    "ts-jest": "^27.1.2",
    "ts-node": "^10.4.0",
    "yaml": "^1.10.2",
    "yargs": "^17.2.1",
    "typescript": "^4.5.4"
  }
}
