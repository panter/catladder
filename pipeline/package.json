{
  "name": "@catladder/pipeline",
  "version": "0.0.0",
  "scripts": {
    "build:tsc": "yarn tsc",
    "build": "yarn tsc && yarn build:inline-variables",
    "build:watch": "yarn tsc -w",
    "build:inline-variables": "yarn babel --keep-file-extension --extensions \".ts,.js\" --config-file ./babel-inline.json dist --out-dir dist",
    "test": "jest",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "catladder-gitlab": "./bin/catladder-gitlab.js"
  },
  "devDependencies": {
    "@babel/cli": "^7.16.0",
    "@babel/core": "^7.0.0-0",
    "@babel/plugin-syntax-typescript": "^7.16.7",
    "@babel/preset-typescript": "^7.16.5",
    "@types/child-process-promise": "^2.2.2",
    "@types/jest": "^27.4.0",
    "@types/lodash": "^4.14.172",
    "babel-plugin-transform-inline-environment-variables": "^0.4.3",
    "eslint": "^8.7.0"
  },
  "dependencies": {
    "@types/node": "^17.0.10",
    "child-process-promise": "^2.2.1",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.21",
    "memoizee": "^0.4.15",
    "path-equal": "^1.1.3",
    "slugify": "^1.6.3",
    "ts-node": "^10.4.0",
    "type-fest": "^2.10.0",
    "typescript": "^4.5.4"
  },
  "stableVersion": "0.1.0"
}
