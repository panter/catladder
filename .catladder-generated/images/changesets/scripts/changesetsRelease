#!/bin/bash
set -e

# 0. check and evaluate security audit or create MR with security audit template (and exit 1)
# 1. compute the next version from the last v* tag + pending .changeset/*.md files
# 2. write the changelog, commit, tag and push (all done by catci)

# NOTE: keep the security-audit gate below in sync with
# runner-images/semantic-release/scripts/semanticRelease

if [ "$GITHUB_ACTIONS" = "true" ]; then
  # github container jobs: the workspace volume is owned by the host
  # runner user while this step runs as the container user, and the
  # safe.directory entry actions/checkout writes goes to a temporary
  # HOME that is gone by now — git would refuse the repo ("dubious
  # ownership")
  git config --global --add safe.directory "$(pwd)"
fi

echo "doing security audit check"
CATCI=".catladder-generated/catci/index.js"
if [ -f "$CATCI" ]; then
  # catci is materialized by pipeline generation — always the exact
  # catladder version that generated this pipeline
  if [ "$GITHUB_ACTIONS" = "true" ]; then
    # github: gate only — the MR remediation is gitlab-specific
    node "$CATCI" security-audit check ./
  else
    node "$CATCI" security-audit ci-job ./ "$GL_TOKEN" "$CI_DEFAULT_BRANCH" "$CI_PROJECT_ID" "$GITLAB_USER_ID"
  fi
else
  echo "$CATCI not found — regenerate the pipeline with a current catladder version (catenv)"
  exit 1
fi

echo "doing changesets release"
node "$CATCI" release changesets
